{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P4G structured page",
  "type": "object",
  "required": ["guide"],
  "additionalProperties": false,
  "properties": {
    "guide": {
      "type": "object",
      "required": ["id", "title", "type", "category", "sections"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "type": { "enum": ["article", "calendar", "dungeon", "social-link", "arcana", "catalog", "reference"] },
        "category": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "game": { "type": "string" },
            "author": { "type": "string" },
            "version": { "type": "string" },
            "url": { "type": "string" },
            "source_file": { "type": "string" }
          }
        },
        "navigation": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "prev": { "$ref": "#/$defs/navRef" }, "next": { "$ref": "#/$defs/navRef" } }
        },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } }
      }
    }
  },
  "$defs": {
    "navRef": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": { "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "title": { "type": "string" } }
    },
    "section": {
      "type": "object",
      "required": ["id", "heading", "blocks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "heading": { "type": ["string", "null"] },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/p" },
        { "$ref": "#/$defs/list" },
        { "$ref": "#/$defs/callout" },
        { "$ref": "#/$defs/table" },
        { "$ref": "#/$defs/info" },
        { "$ref": "#/$defs/ranks" },
        { "$ref": "#/$defs/slots" }
      ]
    },
    "slots": {
      "type": "object",
      "required": ["type", "slots"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "slots" },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "steps"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": ["string", "null"] },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["title", "blocks"],
                  "additionalProperties": false,
                  "properties": {
                    "title": { "type": ["string", "null"] },
                    "blocks": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          { "$ref": "#/$defs/p" },
                          { "$ref": "#/$defs/list" },
                          { "$ref": "#/$defs/callout" },
                          { "$ref": "#/$defs/table" }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "p": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": { "type": { "const": "p" }, "text": { "type": "string" } }
    },
    "list": {
      "type": "object",
      "required": ["type", "ordered", "items"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "list" },
        "ordered": { "type": "boolean" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/listItem" } }
      }
    },
    "listItem": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["text", "children"],
          "additionalProperties": false,
          "properties": {
            "text": { "type": "string" },
            "children": { "$ref": "#/$defs/subList" }
          }
        }
      ]
    },
    "subList": {
      "type": "object",
      "required": ["ordered", "items"],
      "additionalProperties": false,
      "properties": {
        "ordered": { "type": "boolean" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/listItem" } }
      }
    },
    "callout": {
      "type": "object",
      "required": ["type", "kind", "blocks"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "callout" },
        "kind": { "enum": ["note", "warning", "discrepancy"] },
        "blocks": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/p" }, { "$ref": "#/$defs/list" }] } }
      }
    },
    "table": {
      "type": "object",
      "required": ["type", "headers", "rows"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "table" },
        "headers": { "type": ["array", "null"], "items": { "type": "string" } },
        "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "info": {
      "type": "object",
      "required": ["type", "items"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "info" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": { "label": { "type": "string" }, "value": { "type": "string" } }
          }
        }
      }
    },
    "ranks": {
      "type": "object",
      "required": ["type", "ranks"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "ranks" },
        "ranks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["title", "scenes"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string" },
              "scenes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["options"],
                  "additionalProperties": false,
                  "properties": {
                    "prompt": { "type": "string" },
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["label", "text"],
                        "additionalProperties": false,
                        "properties": { "label": { "type": "string" }, "text": { "type": "string" } }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
