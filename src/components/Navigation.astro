---
// src/components/Navigation.astro
import { Image } from "astro:assets";
import p4gLogo from "../assets/Persona_4_Golden_logo.webp";
import { Icon } from "astro-icon/components";

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

interface NavItem {
  title: string;
  href?: string;
  isAvailable?: boolean;
  icon?: string;
}

interface NavSection {
  title: string;
  icon: string;
  items: NavItem[];
}

const navSections: NavSection[] = [
  {
    title: "Introduction",
    icon: "lucide:compass",
    items: [
      {
        title: "Game Information",
        href: `${baseUrl}/`,
        isAvailable: true,
        icon: "lucide:book-open",
      },
      {
        title: "Frequently Asked Questions",
        isAvailable: false,
        icon: "lucide:help-circle",
      },
      {
        title: "What Is Persona?",
        isAvailable: false,
        icon: "lucide:info",
      },
      {
        title: "Persona 3 vs. Persona 4",
        isAvailable: false,
        icon: "lucide:scale",
      },
      {
        title: "Persona 4 vs. Persona 4 Golden",
        isAvailable: false,
        icon: "lucide:trophy",
      },
    ],
  },
  {
    title: "Gameplay Mechanics",
    icon: "lucide:gamepad-2",
    items: [
      { title: "Controls", isAvailable: false, icon: "lucide:gamepad" },
      {
        title: "Field Mechanics",
        isAvailable: false,
        icon: "lucide:footprints",
      },
      {
        title: "Calendar System",
        isAvailable: false,
        icon: "lucide:calendar-clock",
      },
      {
        title: "Social Link",
        isAvailable: false,
        icon: "lucide:heart-handshake",
      },
      {
        title: "Status Parameters",
        isAvailable: false,
        icon: "lucide:activity",
      },
      { title: "Velvet Room", isAvailable: false, icon: "lucide:door-closed" },
      { title: "Battle Mechanics", isAvailable: false, icon: "lucide:swords" },
      { title: "Shuffle Time", isAvailable: false, icon: "lucide:layers-2" },
      {
        title: "Status Ailments",
        isAvailable: false,
        icon: "lucide:biohazard",
      },
      { title: "New Game Plus", isAvailable: false, icon: "lucide:refresh-cw" },
      { title: "TV Channels", isAvailable: false, icon: "lucide:tv" },
    ],
  },
  {
    title: "Walkthrough",
    icon: "lucide:map",
    items: [
      {
        title: "Walkthrough Objectives",
        isAvailable: false,
        icon: "lucide:target",
      },
      {
        title: "Walkthrough FAQ",
        isAvailable: false,
        icon: "lucide:help-circle",
      },
      {
        title: "Important Notes",
        isAvailable: false,
        icon: "lucide:alert-circle",
      },
      {
        title: "Current Problems",
        isAvailable: false,
        icon: "lucide:file-question",
      },
      { title: "April", isAvailable: false, icon: "lucide:calendar" },
      { title: "May", isAvailable: false, icon: "lucide:calendar" },
      { title: "June", isAvailable: false, icon: "lucide:calendar" },
      { title: "July", isAvailable: false, icon: "lucide:calendar" },
      { title: "August", isAvailable: false, icon: "lucide:calendar" },
      { title: "September", isAvailable: false, icon: "lucide:calendar" },
      { title: "October", isAvailable: false, icon: "lucide:calendar" },
      { title: "November", isAvailable: false, icon: "lucide:calendar" },
      { title: "December", isAvailable: false, icon: "lucide:calendar" },
      { title: "January", isAvailable: false, icon: "lucide:calendar" },
      { title: "February", isAvailable: false, icon: "lucide:calendar" },
      { title: "March", isAvailable: false, icon: "lucide:calendar" },
      {
        title: "New Game Plus Walkthrough",
        isAvailable: false,
        icon: "lucide:sparkles",
      },
    ],
  },
  {
    title: "Dungeons",
    icon: "lucide:tv",
    items: [
      {
        title: "Twisted Shopping District",
        isAvailable: false,
        icon: "lucide:shopping-bag",
      },
      { title: "Yukiko's Castle", isAvailable: false, icon: "lucide:castle" },
      { title: "Steamy Bathhouse", isAvailable: false, icon: "lucide:bath" },
      {
        title: "Marukyu Striptease",
        isAvailable: false,
        icon: "lucide:sparkles",
      },
      { title: "Void Quest", isAvailable: false, icon: "lucide:joystick" },
      {
        title: "Secret Laboratory",
        isAvailable: false,
        icon: "lucide:flask-conical",
      },
      { title: "Heaven", isAvailable: false, icon: "lucide:cloud-sun" },
      { title: "Magatsu Inaba", isAvailable: false, icon: "lucide:eye" },
      { title: "Hollow Forest", isAvailable: false, icon: "lucide:trees" },
      { title: "Yomotsu Hirasaka", isAvailable: false, icon: "lucide:skull" },
      { title: "Extra Bosses", isAvailable: false, icon: "lucide:flame" },
    ],
  },
  {
    title: "Persona Compendium",
    icon: "lucide:book-marked",
    items: [
      {
        title: "Persona Compendium",
        isAvailable: false,
        icon: "lucide:layers",
      },
    ],
  },
  {
    title: "Skill List",
    icon: "lucide:zap",
    items: [
      { title: "All Skills", isAvailable: false, icon: "lucide:sparkles" },
      { title: "Skill Cards", isAvailable: false, icon: "lucide:credit-card" },
      { title: "Party Members", isAvailable: false, icon: "lucide:users" },
    ],
  },
  {
    title: "Item List",
    icon: "lucide:package",
    items: [
      { title: "Weapons", isAvailable: false, icon: "lucide:sword" },
      { title: "Armor", isAvailable: false, icon: "lucide:shield" },
      { title: "Accessories", isAvailable: false, icon: "lucide:gem" },
      { title: "Costume List", isAvailable: false, icon: "lucide:shirt" },
      {
        title: "Consumable/Quest Items",
        isAvailable: false,
        icon: "lucide:pill",
      },
      { title: "Materials", isAvailable: false, icon: "lucide:hammer" },
      { title: "Book List", isAvailable: false, icon: "lucide:book-open" },
      { title: "Fish List", isAvailable: false, icon: "lucide:fish" },
      { title: "Gardening Items", isAvailable: false, icon: "lucide:sprout" },
      { title: "Bug List", isAvailable: false, icon: "lucide:bug" },
      { title: "Gem List", isAvailable: false, icon: "lucide:gem" },
      { title: "Key Items", isAvailable: false, icon: "lucide:key" },
    ],
  },
  {
    title: "Tips And Tricks",
    icon: "lucide:lightbulb",
    items: [
      {
        title: "Golden Shadow Grinding",
        isAvailable: false,
        icon: "lucide:coins",
      },
      { title: "Best Personas", isAvailable: false, icon: "lucide:crown" },
      { title: "Hardcore Risette Fan", isAvailable: false, icon: "lucide:mic" },
      { title: "Victory Cry Cheat", isAvailable: false, icon: "lucide:wand-2" },
      { title: "Resources", isAvailable: false, icon: "lucide:external-link" },
    ],
  },
];

// Helper to determine if a link is active
const isItemActive = (href?: string) => {
  if (!href) return false;
  const cleanCurrent = currentPath.replace(/\/$/, "");
  const cleanHref = href.replace(/\/$/, "");
  return (
    cleanCurrent === cleanHref ||
    (cleanHref === baseUrl && (cleanCurrent === "" || cleanCurrent === baseUrl))
  );
};
---

<!-- Mobile Header Bar -->
<div class="mobile-header">
  <div class="mobile-header-start">
    <button
      id="nav-toggle-btn"
      class="menu-toggle-btn"
      aria-label="Open Navigation Menu"
      aria-expanded="false"
      aria-controls="global-sidebar"
    >
      <Icon name="lucide:menu" size={20} class="icon-menu" />
      <span>Menu</span>
    </button>
  </div>

  <div class="mobile-header-center">
    <a
      href={`${baseUrl}/`}
      class="mobile-brand-link"
      aria-label="Persona 4 Golden Guide Home"
    >
      <Image src={p4gLogo} alt="Persona 4 Golden" class="mobile-brand-logo" />
    </a>
  </div>

  <div class="mobile-header-end" id="mobile-progress-slot">
    <!-- Reserved space for progress report component -->
  </div>
</div>

<!-- Backdrop Overlay for Mobile -->
<div id="nav-backdrop" class="nav-backdrop" aria-hidden="true"></div>

<!-- Global Navigation Sidebar -->
<aside id="global-sidebar" class="global-sidebar" aria-label="Main Navigation">
  <div class="sidebar-header">
    <a
      href={`${baseUrl}/`}
      class="sidebar-brand"
      aria-label="Persona 4 Golden Guide Home"
    >
      <Image src={p4gLogo} alt="Persona 4 Golden" class="brand-logo" />
    </a>
  </div>

  <nav class="sidebar-nav">
    {
      navSections.map((section, index) => {
        const hasActive = section.items.some((item) => isItemActive(item.href));
        const isOpenByDefault = hasActive || index === 0;

        return (
          <details
            class:list={["nav-group", { "has-active": hasActive }]}
            open={isOpenByDefault}
            data-section-title={section.title}
          >
            <summary class="nav-group-header">
              <div class="nav-header-left">
                <span class="group-icon-wrapper">
                  <Icon name={section.icon} size={15} class="section-icon" />
                </span>
                <span class="nav-group-title">{section.title}</span>
              </div>
              <span class="chevron-pill">
                <Icon
                  name="lucide:chevron-down"
                  size={14}
                  class="nav-group-chevron"
                />
              </span>
            </summary>

            <div class="nav-list-wrapper">
              <ul class="nav-list">
                {section.items.map((item) => {
                  const active = isItemActive(item.href);
                  const iconName = item.icon || "lucide:circle-dot";
                  return (
                    <li class="nav-item">
                      {item.isAvailable ? (
                        <a
                          href={item.href}
                          class:list={["nav-link", { active }]}
                          aria-current={active ? "page" : undefined}
                        >
                          <span class="item-icon-box" aria-hidden="true">
                            <Icon
                              name={iconName}
                              size={14}
                              class="entry-icon"
                            />
                          </span>
                          <span class="link-label">{item.title}</span>
                          {active ? (
                            <span class="active-badge" aria-hidden="true">
                              <span class="active-pulse" />
                              <span class="active-notch">►</span>
                            </span>
                          ) : null}
                        </a>
                      ) : (
                        <span class="nav-link disabled" title="Coming soon">
                          <span
                            class="item-icon-box inactive-icon-box"
                            aria-hidden="true"
                          >
                            <Icon
                              name={iconName}
                              size={14}
                              class="entry-icon"
                            />
                          </span>
                          <span class="link-label">{item.title}</span>
                          <span class="upcoming-badge">SOON</span>
                        </span>
                      )}
                    </li>
                  );
                })}
              </ul>
            </div>
          </details>
        );
      })
    }
  </nav>

  <div class="sidebar-footer">
    <div class="footer-card">
      <span class="status-dot"></span>
      <span class="footer-note">Progress: 0/??</span>
    </div>
  </div>
</aside>

<style>
  /* Mobile Header Topbar (< 1024px) */
  .mobile-header {
    display: none;
    position: sticky;
    top: 0;
    z-index: 40;
    background-color: #1a1a1e;
    border-bottom: 2px solid var(--p4g-yellow);
    padding: 0.6rem 1rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
  }

  .mobile-header-start {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .menu-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #f7f5ef;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(242, 201, 78, 0.35);
    border-radius: 4px;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .menu-toggle-btn:hover {
    background-color: var(--p4g-yellow);
    color: #141416;
    border-color: var(--p4g-yellow);
  }

  .mobile-header-center {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-brand-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
    text-decoration: none;
  }

  .mobile-brand-logo {
    width: auto;
    height: 32px;
    max-height: 32px;
    max-width: 140px;
    object-fit: contain;
  }

  .mobile-header-end {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
  }

  /* Backdrop */
  .nav-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background-color: rgba(16, 16, 20, 0.65);
    backdrop-filter: blur(4px);
    z-index: 45;
  }

  /* Global Sidebar (Desktop) */
  .global-sidebar {
    width: var(--sidebar-width);
    flex-shrink: 0;
    background: linear-gradient(180deg, #1e1e24 0%, #151518 100%);
    border-right: 1px solid rgba(242, 201, 78, 0.18);
    border-top: 3px solid var(--p4g-yellow);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    z-index: 30;
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.35);
  }

  /* Subtle ambient golden glow */
  .global-sidebar::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 240px;
    background: radial-gradient(
      ellipse at 50% 0%,
      rgba(242, 201, 78, 0.08) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .global-sidebar::-webkit-scrollbar {
    width: 5px;
  }

  .global-sidebar::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.15);
  }

  .global-sidebar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
  }

  .global-sidebar::-webkit-scrollbar-thumb:hover {
    background: var(--p4g-yellow);
  }

  /* Sidebar Header (Pure CSS P4G Aesthetic - Midnight Pop Stage) */
  .sidebar-header {
    position: relative;
    z-index: 2;
    padding: 1.6rem 1rem 1.5rem;
    background-color: #17171c;
    background-image:
      radial-gradient(
        ellipse 85% 70% at 50% 50%,
        rgba(255, 226, 98, 0.36) 0%,
        rgba(242, 201, 78, 0.2) 42%,
        rgba(224, 130, 9, 0.08) 68%,
        transparent 85%
      ),
      radial-gradient(
        circle,
        rgba(242, 201, 78, 0.14) 1.2px,
        transparent 1.2px
      ),
      linear-gradient(180deg, #2a2a34 0%, #17171c 100%);
    background-size:
      auto,
      12px 12px,
      auto;
    background-position:
      center,
      0 0,
      center;
    border-bottom: 2px solid var(--p4g-yellow);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.15),
      inset 0 -1px 0 rgba(0, 0, 0, 0.5),
      0 4px 16px rgba(0, 0, 0, 0.35);
  }

  /* Retro CRT TV scanline texture & vignette (Pure CSS) */
  .sidebar-header::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.2) 0px,
        rgba(0, 0, 0, 0.2) 1px,
        transparent 1px,
        transparent 3px
      ),
      radial-gradient(
        ellipse at 50% 50%,
        transparent 65%,
        rgba(0, 0, 0, 0.35) 100%
      );
    pointer-events: none;
    opacity: 0.7;
    z-index: 1;
  }

  /* P4G signature tri-color slanted ribbon at bottom edge */
  .sidebar-header::after {
    content: "";
    position: absolute;
    bottom: -2px;
    right: 1.25rem;
    width: 58px;
    height: 4px;
    background: linear-gradient(
      90deg,
      #e74c3c 0%,
      #e74c3c 32%,
      #ff8b26 32%,
      #ff8b26 66%,
      var(--p4g-yellow) 66%,
      var(--p4g-yellow) 100%
    );
    transform: skewX(-25deg);
    box-shadow:
      0 0 10px rgba(242, 201, 78, 0.65),
      0 0 5px rgba(231, 76, 60, 0.4);
    z-index: 3;
  }

  .sidebar-brand {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    text-decoration: none;
  }

  /* Brand Logo */
  .brand-logo {
    width: 175px;
    height: auto;
    max-height: 76px;
    max-width: 82%;
    object-fit: contain;
    flex-shrink: 0;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.7))
      drop-shadow(0 0 20px rgba(242, 201, 78, 0.38))
      drop-shadow(0 0 6px rgba(255, 230, 110, 0.3));
  }

  /* Navigation Groups (P4G TV Guide Aesthetic) */
  .sidebar-nav {
    position: relative;
    z-index: 1;
    padding: 1.15rem 0.65rem 1.75rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* Nav Group (Accordion Section Container) */
  .nav-group {
    display: block;
    background: rgba(22, 22, 28, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    overflow: hidden;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .nav-group[open] {
    background: rgba(24, 24, 30, 0.72);
    border-color: rgba(255, 255, 255, 0.08);
  }

  .nav-group.has-active {
    border-color: rgba(242, 201, 78, 0.35);
    background: rgba(30, 27, 20, 0.55);
    box-shadow: inset 0 0 16px rgba(242, 201, 78, 0.04);
  }

  /* Group Header Summary */
  .nav-group-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.52rem 0.65rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    border-radius: 6px;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .nav-group-header::-webkit-details-marker {
    display: none;
  }

  .nav-group-header::marker {
    display: none;
  }

  .nav-group-header:hover {
    background-color: rgba(255, 255, 255, 0.06);
  }

  .nav-group-header:focus-visible {
    outline: 2px solid var(--p4g-yellow);
    outline-offset: 1px;
  }

  .nav-header-left {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
  }

  /* Section Icon */
  .group-icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.5);
    transition:
      transform var(--transition-fast),
      color var(--transition-fast);
  }

  .nav-group-header:hover .group-icon-wrapper {
    color: var(--p4g-yellow);
    transform: scale(1.1);
  }

  .nav-group.has-active .group-icon-wrapper {
    color: var(--p4g-yellow);
  }

  /* Header Title */
  .nav-group-title {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 300;
    letter-spacing: 0.06em;
    color: #cfcfd6;
    margin: 0;
    padding: 0;
    border: none;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color var(--transition-fast);
  }

  .nav-group-header:hover .nav-group-title {
    color: #ffffff;
  }

  .nav-group.has-active > .nav-group-header .nav-group-title {
    color: #fff9e6;
    text-shadow: 0 0 10px rgba(242, 201, 78, 0.3);
  }

  /* Chevron Pill Icon */
  .chevron-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .nav-group-chevron {
    color: rgba(255, 255, 255, 0.4);
    transform: rotate(-90deg);
    transition:
      transform var(--transition-fast),
      color var(--transition-fast);
  }

  .nav-group[open] .chevron-pill {
    background: rgba(242, 201, 78, 0.12);
    border-color: rgba(242, 201, 78, 0.3);
  }

  .nav-group[open] .nav-group-chevron {
    transform: rotate(0deg);
    color: var(--p4g-yellow);
  }

  /* Sub-Tree Vertical Track Guideline */
  .nav-list-wrapper {
    position: relative;
    padding: 0.25rem 0.5rem 0.55rem 0.85rem;
    margin: 0 0.35rem 0.35rem 0.65rem;
    border-left: 2px dashed rgba(242, 201, 78, 0.18);
    transition: border-color var(--transition-fast);
  }

  .nav-group[open]:hover .nav-list-wrapper {
    border-left-color: rgba(242, 201, 78, 0.35);
  }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .nav-item {
    margin: 0;
  }

  /* Navigation Link / Item */
  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.42rem 0.55rem;
    font-size: 0.7rem;
    font-weight: 500;
    font-family: var(--font-heading);
    color: #b7b7c2;
    border-radius: 5px;
    text-decoration: none;
    position: relative;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  /* Entry Icon Container */
  .item-icon-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.45);
    transition:
      transform var(--transition-fast),
      color var(--transition-fast);
  }

  /* Hover State for non-active available links */
  .nav-link:hover:not(.disabled):not(.active) {
    background: rgba(242, 201, 78, 0.12);
    color: #ffffff;
    transform: translateX(4px);
    box-shadow: inset 3px 0 0 var(--p4g-yellow);
  }

  .nav-link:hover:not(.disabled):not(.active) .link-label {
    color: #ffffff;
  }

  .nav-link:hover:not(.disabled):not(.active) .item-icon-box {
    color: var(--p4g-yellow);
    transform: scale(1.15);
  }

  /* Active Navigation State ("Tuned In" Golden Highlight) */
  .nav-link.active,
  .nav-link.active:hover {
    font-weight: 700;
    background: linear-gradient(90deg, #f2c94c 0%, #f6d672 100%);
    color: #121214;
    transform: translateX(4px);
    border-left: 3px solid #141416;
    box-shadow:
      0 4px 16px rgba(242, 201, 78, 0.38),
      inset 0 1px 0 rgba(255, 255, 255, 0.55);
  }

  .nav-link.active .item-icon-box,
  .nav-link.active:hover .item-icon-box {
    color: #121214;
  }

  .nav-link.active .link-label,
  .nav-link.active:hover .link-label {
    color: #121214;
  }

  /* Active Badge (Pulse Dot + P4G Notch) */
  .active-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: #121214;
    flex-shrink: 0;
  }

  .active-pulse {
    width: 5px;
    height: 5px;
    background-color: #121214;
    border-radius: 50%;
    animation: p4g-dot-pulse 1.4s ease-in-out infinite alternate;
  }

  .active-notch {
    font-size: 0.7rem;
    line-height: 1;
    font-weight: 900;
  }

  @keyframes p4g-dot-pulse {
    0% {
      opacity: 0.4;
      transform: scale(0.85);
    }
    100% {
      opacity: 1;
      transform: scale(1.25);
    }
  }

  /* Inactive / Coming Soon Items */
  .nav-link.disabled {
    color: rgba(255, 255, 255, 0.35);
    cursor: default;
  }

  .inactive-icon-box {
    opacity: 0.38;
  }

  .link-label {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .upcoming-badge {
    font-family: var(--font-display);
    font-size: 0.58rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.4);
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px dashed rgba(255, 255, 255, 0.14);
    padding: 0.1rem 0.32rem;
    border-radius: 3px;
    letter-spacing: 0.06em;
    transform: skewX(-6deg);
    flex-shrink: 0;
  }

  /* Sidebar Footer */
  .sidebar-footer {
    position: relative;
    z-index: 1;
    padding: 1rem 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-card {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.55);
    background-color: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background-color: #27ae60;
    border-radius: 50%;
    box-shadow: 0 0 6px #27ae60;
  }

  /* Responsive Rules (< 1024px) */
  @media (max-width: 1023px) {
    .mobile-header {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }

    .global-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 50;
      transform: translateX(-100%);
      transition: transform var(--transition-normal);
      box-shadow: 6px 0 28px rgba(0, 0, 0, 0.5);
    }

    .global-sidebar.open {
      transform: translateX(0);
    }

    .nav-backdrop.open {
      display: block;
    }
  }
</style>

<script>
  // Mobile drawer interaction script
  function setupNavDrawer() {
    const toggleBtn = document.getElementById("nav-toggle-btn");
    const sidebar = document.getElementById("global-sidebar");
    const backdrop = document.getElementById("nav-backdrop");

    if (!toggleBtn || !sidebar || !backdrop) return;

    const openNav = () => {
      sidebar.classList.add("open");
      backdrop.classList.add("open");
      toggleBtn.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    };

    const closeNav = () => {
      sidebar.classList.remove("open");
      backdrop.classList.remove("open");
      toggleBtn.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
    };

    toggleBtn.addEventListener("click", () => {
      const isOpen = sidebar.classList.contains("open");
      if (isOpen) closeNav();
      else openNav();
    });

    backdrop.addEventListener("click", closeNav);

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && sidebar.classList.contains("open")) {
        closeNav();
      }
    });
  }

  // Collapsible nav entries with localStorage state persistence
  function setupCollapsibleNav() {
    const STORAGE_KEY = "p4g_nav_sections_state";
    const groups = document.querySelectorAll<HTMLDetailsElement>(
      "#global-sidebar .nav-group",
    );
    if (!groups.length) return;

    // Restore saved state
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) {
        const state: Record<string, boolean> = JSON.parse(stored);
        groups.forEach((details) => {
          const title = details.getAttribute("data-section-title");
          const hasActive = details.classList.contains("has-active");
          if (hasActive) {
            details.open = true;
          } else if (title && typeof state[title] === "boolean") {
            details.open = state[title];
          }
        });
      }
    } catch {
      // Ignore storage read errors
    }

    // Save state on toggle
    groups.forEach((details) => {
      details.addEventListener("toggle", () => {
        try {
          const state: Record<string, boolean> = {};
          groups.forEach((g) => {
            const title = g.getAttribute("data-section-title");
            if (title) state[title] = g.open;
          });
          localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        } catch {
          // Ignore storage write errors
        }
      });
    });
  }

  function initNav() {
    setupNavDrawer();
    setupCollapsibleNav();
  }

  initNav();
  document.addEventListener("astro:page-load", initNav);
</script>
