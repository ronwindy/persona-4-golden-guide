---
// src/components/Navigation.astro
import { Image } from "astro:assets";
import p4gLogo from "../assets/Persona_4_Golden_logo.webp";
import { Icon } from "astro-icon/components";

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

interface NavItem {
  title: string;
  href?: string;
  isAvailable?: boolean;
}

interface NavSection {
  title: string;
  items: NavItem[];
}

const navSections: NavSection[] = [
  {
    title: "GUIDE",
    items: [
      { title: "Introduction", href: `${baseUrl}/`, isAvailable: true },
      { title: "Walkthrough", isAvailable: false },
      { title: "Calendar", isAvailable: false },
      { title: "Social Links", isAvailable: false },
      { title: "Endings", isAvailable: false },
    ],
  },
  {
    title: "DATABASE",
    items: [
      { title: "Personas", isAvailable: false },
      { title: "Skills", isAvailable: false },
      { title: "Items", isAvailable: false },
      { title: "Quests", isAvailable: false },
    ],
  },
  {
    title: "EXTRAS",
    items: [
      { title: "Achievements", isAvailable: false },
      { title: "Missables", isAvailable: false },
    ],
  },
];

// Helper to determine if a link is active
const isItemActive = (href?: string) => {
  if (!href) return false;
  const cleanCurrent = currentPath.replace(/\/$/, "");
  const cleanHref = href.replace(/\/$/, "");
  return (
    cleanCurrent === cleanHref ||
    (cleanHref === baseUrl && (cleanCurrent === "" || cleanCurrent === baseUrl))
  );
};
---

<!-- Mobile Header Bar -->
<div class="mobile-header">
  <div class="mobile-header-start">
    <button
      id="nav-toggle-btn"
      class="menu-toggle-btn"
      aria-label="Open Navigation Menu"
      aria-expanded="false"
      aria-controls="global-sidebar"
    >
      <Icon name="lucide:menu" size={20} class="icon-menu" />
      <span>Menu</span>
    </button>
  </div>

  <div class="mobile-header-center">
    <a
      href={`${baseUrl}/`}
      class="mobile-brand-link"
      aria-label="Persona 4 Golden Guide Home"
    >
      <Image src={p4gLogo} alt="Persona 4 Golden" class="mobile-brand-logo" />
    </a>
  </div>

  <div class="mobile-header-end" id="mobile-progress-slot">
    <!-- Reserved space for progress report component -->
  </div>
</div>

<!-- Backdrop Overlay for Mobile -->
<div id="nav-backdrop" class="nav-backdrop" aria-hidden="true"></div>

<!-- Global Navigation Sidebar -->
<aside id="global-sidebar" class="global-sidebar" aria-label="Main Navigation">
  <div class="sidebar-header">
    <a
      href={`${baseUrl}/`}
      class="sidebar-brand"
      aria-label="Persona 4 Golden Guide Home"
    >
      <Image src={p4gLogo} alt="Persona 4 Golden" class="brand-logo" />
    </a>
  </div>

  <nav class="sidebar-nav">
    {
      navSections.map((section) => (
        <div class="nav-group">
          <h2 class="nav-group-title">{section.title}</h2>
          <ul class="nav-list">
            {section.items.map((item) => {
              const active = isItemActive(item.href);
              return (
                <li class="nav-item">
                  {item.isAvailable ? (
                    <a
                      href={item.href}
                      class:list={["nav-link", { active }]}
                      aria-current={active ? "page" : undefined}
                    >
                      <span class="active-indicator" aria-hidden="true">
                        ▌
                      </span>
                      <span class="link-label">{item.title}</span>
                    </a>
                  ) : (
                    <span class="nav-link disabled" title="Coming soon">
                      <span class="inactive-bullet" aria-hidden="true">
                        ·
                      </span>
                      <span class="link-label">{item.title}</span>
                      <span class="upcoming-badge">SOON</span>
                    </span>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </nav>

  <div class="sidebar-footer">
    <div class="footer-card">
      <span class="status-dot"></span>
      <span class="footer-note">Progress: 0/??</span>
    </div>
  </div>
</aside>

<style>
  /* Mobile Header Topbar (< 1024px) */
  .mobile-header {
    display: none;
    position: sticky;
    top: 0;
    z-index: 40;
    background-color: #1a1a1e;
    border-bottom: 2px solid var(--p4g-yellow);
    padding: 0.6rem 1rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
  }

  .mobile-header-start {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .menu-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #f7f5ef;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(242, 201, 78, 0.35);
    border-radius: 4px;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .menu-toggle-btn:hover {
    background-color: var(--p4g-yellow);
    color: #141416;
    border-color: var(--p4g-yellow);
  }

  .mobile-header-center {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-brand-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
    text-decoration: none;
  }

  .mobile-brand-logo {
    width: auto;
    height: 32px;
    max-height: 32px;
    max-width: 140px;
    object-fit: contain;
  }

  .mobile-header-end {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
  }

  /* Backdrop */
  .nav-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background-color: rgba(16, 16, 20, 0.65);
    backdrop-filter: blur(4px);
    z-index: 45;
  }

  /* Global Sidebar (Desktop) */
  .global-sidebar {
    width: var(--sidebar-width);
    flex-shrink: 0;
    background: linear-gradient(180deg, #1e1e24 0%, #151518 100%);
    border-right: 1px solid rgba(242, 201, 78, 0.18);
    border-top: 3px solid var(--p4g-yellow);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    z-index: 30;
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.35);
  }

  /* Subtle ambient golden glow */
  .global-sidebar::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 240px;
    background: radial-gradient(ellipse at 50% 0%, rgba(242, 201, 78, 0.08) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .global-sidebar::-webkit-scrollbar {
    width: 5px;
  }

  .global-sidebar::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.15);
  }

  .global-sidebar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
  }

  .global-sidebar::-webkit-scrollbar-thumb:hover {
    background: var(--p4g-yellow);
  }

  /* Sidebar Header (Pure CSS P4G Aesthetic) */
  .sidebar-header {
    position: relative;
    z-index: 2;
    padding: 1.5rem 1rem 1.4rem;
    background:
      radial-gradient(ellipse at 50% 50%, rgba(242, 201, 78, 0.18) 0%, rgba(242, 201, 78, 0.04) 55%, transparent 75%),
      linear-gradient(180deg, #25252d 0%, #17171b 100%);
    border-bottom: 2px solid var(--p4g-yellow);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      inset 0 -1px 0 rgba(0, 0, 0, 0.4),
      0 4px 14px rgba(0, 0, 0, 0.25);
    overflow: hidden;
  }

  /* Retro CRT TV scanline texture (Pure CSS) */
  .sidebar-header::before {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.2) 0px,
      rgba(0, 0, 0, 0.2) 1px,
      transparent 1px,
      transparent 3px
    );
    pointer-events: none;
    opacity: 0.65;
    z-index: 1;
  }

  /* P4G signature slanted accent ribbon at bottom edge */
  .sidebar-header::after {
    content: "";
    position: absolute;
    bottom: -2px;
    right: 1.25rem;
    width: 44px;
    height: 4px;
    background: var(--p4g-yellow);
    transform: skewX(-25deg);
    box-shadow: 0 0 10px rgba(242, 201, 78, 0.6);
    z-index: 3;
  }

  .sidebar-brand {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    text-decoration: none;
  }

  /* Brand Logo */
  .brand-logo {
    width: 175px;
    height: auto;
    max-height: 76px;
    max-width: 82%;
    object-fit: contain;
    flex-shrink: 0;
    filter:
      drop-shadow(0 4px 10px rgba(0, 0, 0, 0.6))
      drop-shadow(0 0 16px rgba(242, 201, 78, 0.28));
  }

  /* Navigation Groups */
  .sidebar-nav {
    position: relative;
    z-index: 1;
    padding: 1.25rem 0.75rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .nav-group {
    display: flex;
    flex-direction: column;
  }

  .nav-group-title {
    font-family: var(--font-display);
    font-size: 0.825rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.45);
    margin: 0 0 0.5rem 0.65rem;
    padding: 0;
    border: none;
    text-transform: uppercase;
  }

  .nav-group-title::before {
    display: none; /* override global h2 marker */
  }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .nav-item {
    margin: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.885rem;
    font-weight: 500;
    color: #d1d1d8;
    border-radius: 6px;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .nav-link:hover:not(.disabled) {
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    transform: translateX(3px);
  }

  /* Active Navigation State (DESIGN.md Section 5) */
  .nav-link.active {
    font-weight: 700;
    background-color: var(--p4g-yellow);
    color: #121214;
    box-shadow: 0 2px 10px rgba(242, 201, 78, 0.28);
  }

  .active-indicator {
    color: #121214;
    font-size: 0.85rem;
    font-weight: 900;
    line-height: 1;
    display: none;
  }

  .nav-link.active .active-indicator {
    display: inline-block;
  }

  .nav-link:not(.active) .active-indicator {
    display: none;
  }

  /* Inactive / Upcoming Item */
  .nav-link.disabled {
    color: rgba(255, 255, 255, 0.35);
    cursor: default;
  }

  .inactive-bullet {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.2);
    margin-right: 0.1rem;
  }

  .link-label {
    flex: 1;
  }

  .upcoming-badge {
    font-size: 0.6rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.55);
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    letter-spacing: 0.06em;
  }

  /* Sidebar Footer */
  .sidebar-footer {
    position: relative;
    z-index: 1;
    padding: 1rem 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-card {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.55);
    background-color: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background-color: #27ae60;
    border-radius: 50%;
    box-shadow: 0 0 6px #27ae60;
  }

  /* Responsive Rules (< 1024px) */
  @media (max-width: 1023px) {
    .mobile-header {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }

    .global-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 50;
      transform: translateX(-100%);
      transition: transform var(--transition-normal);
      box-shadow: 6px 0 28px rgba(0, 0, 0, 0.5);
    }

    .global-sidebar.open {
      transform: translateX(0);
    }

    .nav-backdrop.open {
      display: block;
    }
  }
</style>

<script>
  // Mobile drawer interaction script
  function setupNavDrawer() {
    const toggleBtn = document.getElementById("nav-toggle-btn");
    const sidebar = document.getElementById("global-sidebar");
    const backdrop = document.getElementById("nav-backdrop");

    if (!toggleBtn || !sidebar || !backdrop) return;

    const openNav = () => {
      sidebar.classList.add("open");
      backdrop.classList.add("open");
      toggleBtn.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    };

    const closeNav = () => {
      sidebar.classList.remove("open");
      backdrop.classList.remove("open");
      toggleBtn.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
    };

    toggleBtn.addEventListener("click", () => {
      const isOpen = sidebar.classList.contains("open");
      if (isOpen) closeNav();
      else openNav();
    });

    backdrop.addEventListener("click", closeNav);

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && sidebar.classList.contains("open")) {
        closeNav();
      }
    });
  }

  setupNavDrawer();
  document.addEventListener("astro:page-load", setupNavDrawer);
</script>
