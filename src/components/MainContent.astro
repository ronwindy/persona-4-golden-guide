---
// src/components/MainContent.astro
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={["main-content-wrapper", className]}>
  <slot />
</div>

<style>
  .main-content-wrapper {
    width: 100%;
    position: relative;
    padding-bottom: 5rem;
    /* Prevent shadows and rotated elements from triggering horizontal scroll */
    overflow-x: hidden;
  }

  /* 
     Robust box-sizing reset for all children. 
     This ensures padding/borders don't push width beyond 100% 
  */
  .main-content-wrapper :global(*) {
    box-sizing: border-box;
  }

  /* 
     Standardized Layout Overrides 
     Centralizing the 2-column guide layout (Sidebar + Content)
  */
  :global(.main-layout) {
    display: grid !important;
    max-width: 100vw;
    overflow-x: hidden;
    gap: 1.5rem !important;
    width: 100%;
    margin: 0 auto;
    padding: 0 !important; /* Let MainContent handle internal padding */
  }

  @media (min-width: 1024px) {
    :global(.main-layout) {
      grid-template-columns: 360px 1fr !important;
      max-width: 1600px !important;
      gap: 2.5rem !important;
      /* Large screens get some breathing room */
      padding: 3rem 2rem !important; 
    }
  }

  /* 
     Mobile Safe Zones 
     Ensures content doesn't hit screen edges and accounts for box-shadows
  */
  @media (max-width: 768px) {
    .main-content-wrapper {
      padding: 0 1rem 3rem 1rem;
      width: 100%;
    }

    :global(.main-layout) {
      grid-template-columns: 1fr !important;
      gap: 1rem !important;
      padding: 0 !important;
    }
  }

  /* High-fidelity detail: Subtle CRT texture on main container */
  .main-content-wrapper::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      rgba(18, 16, 16, 0) 50%,
      rgba(0, 0, 0, 0.02) 50%
    );
    background-size: 100% 4px;
    pointer-events: none;
    z-index: 1;
    opacity: 0.3;
  }
</style>
