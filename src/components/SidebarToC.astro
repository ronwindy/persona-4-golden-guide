<!-- Mobile Sidebar Overlay -->
<div id="sidebar-overlay" class="sidebar-overlay"></div>

<aside id="sidebar-toc" class="left-sidebar p4g-shadow anim-slide-right">
  <div class="sidebar-header">
    <h3 class="widget-title font-pop">CONTENTS</h3>
    <button
      id="sidebar-close"
      class="sidebar-close-btn font-pop"
      aria-label="Close Menu">&times;</button
    >
  </div>

  <ul class="toc-list font-read">
    {
      tocItems.map((category) => (
        <li class="toc-item">
          <div class="toc-parent">
            <span class="font-pop">{category.title}</span>
            <svg
              class="toc-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            >
              <path
                d="m6 9 6 6 6-6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>
          <ul class="toc-child-list">
            {category.links.map((link) => (
              <li>
                <a href={link.url}>{link.title}</a>
              </li>
            ))}

            {category.hiddenLinks && category.hiddenLinks.length > 0 && (
              <>
                <li class="show-more-btn">
                  <a
                    href="#"
                    class="show-more-link"
                    data-target={category.showMoreClass}
                  >
                    <i>show more...</i>
                  </a>
                </li>
                {category.hiddenLinks.map((link) => (
                  <li
                    class={`hidden-toc-item ${category.showMoreClass}`}
                    style="display: none"
                  >
                    <a href={link.url}>{link.title}</a>
                  </li>
                ))}
              </>
            )}
          </ul>
        </li>
      ))
    }
  </ul>
</aside>

<style>
  .sidebar-overlay {
    position: fixed;
    inset: 0;
    background: rgba(12, 20, 49, 0.7); /* Velvet Blue with opacity */
    backdrop-filter: blur(4px);
    z-index: 950;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s;
  }

  .sidebar-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .left-sidebar {
    background: rgba(250, 250, 250, 0.95);
    backdrop-filter: blur(8px);
    border: 6px solid var(--secondary);
    padding: 0;
    align-self: start;
    position: sticky;
    top: 2rem;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    width: 100%; /* Default to full width for mobile */
    transition:
      transform 0.4s cubic-bezier(0.2, 1, 0.3, 1),
      opacity 0.3s;
    margin-bottom: 2rem;
    z-index: 1000;
  }

  @media (max-width: 1023px) {
    .left-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      height: 100vh;
      max-height: 100vh;
      width: 320px;
      max-width: 85vw;
      margin: 0;
      transform: translateX(-110%);
      opacity: 0;
      box-shadow: 10px 0 0 rgba(26, 26, 26, 0.5);
      border-top: none;
      border-bottom: none;
      border-radius: 0;
    }

    .left-sidebar.mobile-active {
      transform: translateX(0);
      opacity: 1;
    }

    .sidebar-close-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      right: 0;
      top: 0;
      transform: none;
      background: var(--primary);
      border: 3px solid var(--secondary);
      color: var(--secondary);
      font-size: 1.5rem;
      width: 36px;
      height: 36px;
      cursor: pointer;
      z-index: 10;
      box-shadow: 3px 3px 0 var(--secondary);
    }

    .sidebar-close-btn:hover {
      background: var(--accent-orange);
      transform: rotate(90deg);
    }
  }

  @media (min-width: 1024px) {
    .sidebar-close-btn {
      display: none;
    }
    .left-sidebar {
      width: 360px; /* Bigger sidebar for desktop */
      margin-bottom: 0;
    }
  }

  .sidebar-header {
    background: #2a2a2a; /* Dark charcoal instead of black */
    background-image: radial-gradient(rgba(0, 0, 0, 0.3) 1px, transparent 1px);
    background-size: 8px 8px; /* Halftone texture */
    padding: 1rem 1.25rem;
    border-bottom: 6px solid var(--primary);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Animated scrolling accent stripes */
  .sidebar-header::before {
