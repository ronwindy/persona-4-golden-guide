<style>
  .left-sidebar {
    background: rgba(250, 250, 250, 0.95);
    backdrop-filter: blur(8px);
    border: 6px solid var(--secondary);
    padding: 0;
    align-self: start;
    position: sticky;
    top: 2rem;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    width: 100%; /* Default to full width for mobile */
    transition: transform 0.4s cubic-bezier(0.2, 1, 0.3, 1), opacity 0.3s;
    margin-bottom: 2rem;
    z-index: 1000;
  }

  @media (max-width: 1023px) {
    .left-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      height: 100vh;
      max-height: 100vh;
      width: 320px;
      max-width: 85vw;
      margin: 0;
      transform: translateX(-110%);
      opacity: 0;
      box-shadow: 10px 0 0 rgba(26, 26, 26, 0.5);
      border-top: none;
      border-bottom: none;
      border-radius: 0;
    }

    .left-sidebar.mobile-active {
      transform: translateX(0);
      opacity: 1;
    }

    .sidebar-close-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      right: 0;
      top: 0;
      transform: none;
      background: var(--primary);
      border: 3px solid var(--secondary);
      color: var(--secondary);
      font-size: 1.5rem;
      width: 36px;
      height: 36px;
      cursor: pointer;
      z-index: 10;
      box-shadow: 3px 3px 0 var(--secondary);
    }
    
    .sidebar-close-btn:hover {
      background: var(--accent-orange);
      transform: rotate(90deg);
    }
  }

  @media (min-width: 1024px) {
    .sidebar-close-btn {
      display: none;
    }
    .left-sidebar {
      width: 360px; /* Bigger sidebar for desktop */
      margin-bottom: 0;
    }
  }

  .sidebar-header {
    background: #2a2a2a; /* Dark charcoal instead of black */
    background-image: radial-gradient(rgba(0,0,0,0.3) 1px, transparent 1px);
    background-size: 8px 8px; /* Halftone texture */
    padding: 1rem 1.25rem;
    border-bottom: 6px solid var(--primary);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Animated scrolling accent stripes */
  .sidebar-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 10px,
      rgba(252, 227, 0, 0.05) 10px,
      rgba(252, 227, 0, 0.05) 20px
    );
    background-size: 28px 28px;
    animation: scrollHeaderLoop 15s linear infinite;
    pointer-events: none;
  }

  @keyframes scrollHeaderLoop {
    from { background-position: 0 0; }
    to { background-position: 28px 0; }
  }

  .widget-title {
    font-size: 1.5rem !important; /* Scaled down from 2rem */
    color: var(--primary); /* Yellow on Black for better contrast */
    margin: 0;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-style: italic;
    position: relative;
    z-index: 2;
  }

  .toc-list {
    list-style: none;
    padding: 1rem 1.25rem 1.5rem 1.25rem;
  }

  .toc-item {
    margin-bottom: 0.75rem;
    opacity: 0;
    transform: translateX(-20px);
    animation: slideInSidebar 0.4s ease-out forwards;
  }

  @keyframes slideInSidebar {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Staggered animation for items */
  .toc-item:nth-child(1) { animation-delay: 0.1s; }
  .toc-item:nth-child(2) { animation-delay: 0.15s; }
  .toc-item:nth-child(3) { animation-delay: 0.2s; }
  .toc-item:nth-child(4) { animation-delay: 0.25s; }
  .toc-item:nth-child(5) { animation-delay: 0.3s; }
  .toc-item:nth-child(6) { animation-delay: 0.35s; }
  .toc-item:nth-child(7) { animation-delay: 0.4s; }
  .toc-item:nth-child(8) { animation-delay: 0.45s; }
  .toc-item:nth-child(9) { animation-delay: 0.5s; }
  .toc-item:nth-child(10) { animation-delay: 0.55s; }
  .toc-item:nth-child(11) { animation-delay: 0.6s; }
  .toc-item:nth-child(12) { animation-delay: 0.65s; }
  .toc-item:nth-child(13) { animation-delay: 0.7s; }

  .toc-parent {
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 3px solid var(--secondary);
    padding: 0.6rem 0.75rem;
    margin: 0 -0.75rem; /* Allow background to bleed slightly */
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
    z-index: 1;
  }

  /* Slide-in background highlight */
  .toc-parent::before {
    content: '';
    position: absolute;
    inset: 0;
