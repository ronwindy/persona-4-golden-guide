---
import { existsSync } from 'node:fs';
import { ImageOff } from '@lucide/astro';

interface Props {
  /** Path under public/, e.g. images/social-links/chie.webp */
  path: string;
  alt: string;
}

const { path, alt } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const found = existsSync(new URL(`../../public/${path}`, import.meta.url));
---

{found ? (
  <img src={`${baseUrl}/${path}`} alt={alt} loading="lazy" />
) : (
  <div class="img-placeholder" role="img" aria-label={`Missing image: ${alt}`}>
    <ImageOff size={28} aria-hidden="true" />
    <span>{alt}</span>
    <span>public/{path}</span>
  </div>
)}
