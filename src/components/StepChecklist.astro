---
import { renderRich, inline } from '../lib/text';
import type { Step } from '../lib/guideData';

interface Props {
  guideId: string;
  steps: Step[];
}

const { guideId, steps = [] } = Astro.props;
---

<ol class="step-list" id="step-checklist">
  {steps.map((st) => {
    const num = st.step_number ?? st.id;
    const key = `p4g-step-${guideId}-${num}`;
    const body = st.description ?? st.instruction;
    return (
      <li class="step">
        <input type="checkbox" class="step-checkbox" data-key={key} aria-label={`Step ${num} done`} />
        <div class="step-body">
          {st.title && <h3 class="step-title" set:html={inline(st.title)} />}
          <Fragment set:html={renderRich(body)} />
        </div>
      </li>
    );
  })}
</ol>

<script>
  // Tick state is stored per step in localStorage (no account, no server).
  document.querySelectorAll<HTMLInputElement>('.step-checkbox').forEach((cb) => {
    const key = cb.dataset.key;
    if (!key) return;
    try { cb.checked = localStorage.getItem(key) === 'true'; } catch {}
    cb.addEventListener('change', () => {
      try { localStorage.setItem(key, String(cb.checked)); } catch {}
    });
  });
</script>
