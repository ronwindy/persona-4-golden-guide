---
// src/components/HomeIntro.astro
import SidebarToC from "./SidebarToC.astro";
---

<SidebarToC />

<div class="content-column home-page-content">
  <div class="home-hero p4g-shadow anim-pop">
    <div class="guide-badge font-pop">100% Guide</div>

    <div class="hero-main-content">
      <h1 class="guide-title font-pop">
        <span class="anim-pop stagger-1">Persona 4</span>
        <span class="anim-pop stagger-2">Golden</span>
      </h1>

      <div class="guide-metadata font-pop">
        <p class="version anim-pop stagger-3">Version 1.00</p>
        <div class="author-tag anim-pop stagger-4 p4g-shadow-sm">
          <span class="label">Created by</span>
          <span class="author">Hurricanehaon</span>
        </div>
      </div>

      <div class="warning-box cutout-box p4g-shadow-sm anim-slide-up">
        <h2 class="font-pop">Warning!!!</h2>
        <p class="font-read">
          This guide will include gameplay and minor story spoilers.
        </p>
      </div>
    </div>
  </div>

  <section class="format-changes cutout-box p4g-shadow anim-slide-up">
    <div class="section-accent bg-stripes"></div>
    <h2 class="font-pop section-title">Guide Format Changes</h2>

    <div class="change-entry font-read">
      <p class="intro-text">
        Version 0.76 features a significant change to the format of this guide.
        This is due primarily to space limitations within GameFAQ's Editor.
        Although the format has changed, the content within this guide is still
        largely the same. Some portions of this guide have been edited for ease
        of usability/understanding. If any major changes are made, they will be
        listed here.
      </p>

      <div class="version-log">
        <div class="log-item">
          <h3 class="font-pop">Version 0.76</h3>
          <p>
            Major overhaul of guide format, Boss List removed and boss info has
            moved to Dungeons
          </p>
        </div>

        <div class="log-item">
          <h3 class="font-pop">Version 1.00</h3>
          <p>
            Walkthrough has been retested, some parts of the walkthrough have
            been added or rewritten for clarity
          </p>
        </div>
      </div>
    </div>
  </section>
</div>

<style is:global>
  /* Override main layout for 2-column view on home page */
  @media (min-width: 1024px) {
    .main-layout:has(.home-page-content) {
      grid-template-columns: 360px 1fr !important;
      max-width: 1400px;
    }
  }
</style>

<style>
  .content-column {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    padding-bottom: 5rem;
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
  }

  /* Hero Section */
  .home-hero {
    background: var(--bg-white);
    border: 6px solid var(--secondary);
    padding: 6rem 2rem;
    position: relative;
    text-align: center;
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(4px);
    overflow: hidden;
    min-height: 450px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Dim Artwork Background */
  .home-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("/p4g-hero-bg.webp");
    background-size: cover;
    background-position: center 76%;
    opacity: 0.6;
    z-index: 1;
    filter: contrast(1.1) saturate(1.2);
  }

  /* Dot pattern overlay */
  .home-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      var(--secondary) 1.5px,
      transparent 1.5px
    );
    background-size: 24px 24px;
    z-index: 2;
    pointer-events: none;
    opacity: 0.6;
  }

  .hero-main-content {
    position: relative;
    z-index: 10;
    width: 100%;
  }

  .guide-badge {
    position: absolute;
    top: 2rem;
    left: 2rem;
    background: var(--secondary);
    color: var(--primary);
    padding: 0.6rem 1.25rem;
    font-size: 1.5rem;
    transform: rotate(-3deg);
    box-shadow: 6px 6px 0 var(--accent-orange);
    z-index: 20;
    white-space: nowrap;
  }

  .guide-title {
    font-size: clamp(3rem, 12vw, 5.5rem);
    line-height: 0.9;
    color: var(--secondary);
    text-shadow:
      4px 4px 0 var(--primary),
      8px 8px 0 var(--accent-orange);
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .guide-title span {
    display: block;
    width: fit-content;
  }

  .stagger-1 { animation-delay: 0.2s; }
  .stagger-2 { animation-delay: 0.3s; }
  .stagger-3 { animation-delay: 0.5s; }
  .stagger-4 { animation-delay: 0.7s; }

  .guide-metadata {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 4rem;
    align-items: center;
  }

  .version {
    font-size: clamp(1.5rem, 6vw, 2.5rem);
    color: var(--accent-orange);
    text-shadow: 3px 3px 0 var(--secondary);
    transform: rotate(1deg);
  }

  .author-tag {
    font-size: clamp(1.1rem, 4vw, 1.75rem);
    background: var(--secondary);
    color: var(--bg-white);
    padding: 0.5rem 2rem;
    transform: skewX(-12deg);
    display: block;
    width: fit-content;
  }

  .author-tag .author {
    color: var(--primary);
    margin-left: 0.75rem;
    letter-spacing: 0.1em;
  }

  /* Warning Box Styling */
  .warning-box {
    background: var(--accent-blue);
    color: var(--bg-white);
    padding: 2.5rem;
    max-width: 650px;
    margin: 0 auto;
    border: 6px solid var(--secondary);
  }

  .warning-box h2 {
    color: var(--primary);
    font-size: clamp(1.75rem, 8vw, 3rem);
    margin-bottom: 0.75rem;
    letter-spacing: 0.2em;
    animation: warningPulse 1.5s infinite ease-in-out;
  }

  @keyframes warningPulse {
    0%, 100% { transform: scale(1) rotate(0deg); opacity: 1; }
    50% { transform: scale(1.05) rotate(1deg); opacity: 0.9; }
  }

  .warning-box p {
    font-size: clamp(1rem, 3.5vw, 1.25rem);
    font-weight: 600;
  }

  /* Format Changes Section */
  .format-changes {
    background: rgba(200, 204, 255, 0.92);
    border: 6px solid var(--secondary);
    padding: 4rem 3rem;
    position: relative;
    backdrop-filter: blur(10px);
    overflow: hidden;
  }

  .section-accent {
    position: absolute;
    top: -20px;
    right: -20px;
    width: 140px;
    height: 140px;
    opacity: 0.15;
    transform: rotate(15deg);
  }

  .section-title {
    font-size: clamp(2rem, 8vw, 3.5rem);
    color: var(--secondary);
    border-bottom: 8px solid var(--secondary);
    margin-bottom: 2.5rem;
    padding-bottom: 0.75rem;
    text-shadow: 3px 3px 0 var(--primary);
  }

  .intro-text {
    font-size: clamp(1.1rem, 3.5vw, 1.35rem);
    line-height: 1.7;
    margin-bottom: 4rem;
    font-weight: 500;
    color: var(--secondary);
  }

  .version-log {
    display: grid;
    gap: 3rem;
  }

  .log-item {
    border-left: 8px solid var(--secondary);
    padding-left: 2rem;
    transition: transform 0.2s;
  }

  .log-item:hover {
    transform: translateX(10px);
  }

  .log-item h3 {
    font-size: clamp(1.5rem, 6vw, 2.25rem);
    color: var(--accent-orange);
    margin-bottom: 0.5rem;
    text-shadow: 2px 2px 0 var(--secondary);
  }

  .log-item p {
    font-size: clamp(1rem, 3.5vw, 1.25rem);
    font-weight: 700;
    color: var(--secondary);
  }

  /* Entrance Animations */
  @keyframes slideUp {
    from { transform: translateY(60px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .anim-slide-up {
    animation: slideUp 0.8s cubic-bezier(0.23, 1, 0.32, 1) both;
  }

  .format-changes.anim-slide-up {
    animation-delay: 1s;
  }

  @media (max-width: 1024px) {
    .content-column {
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .home-hero {
      padding: 5rem 1rem 3rem;
      min-height: auto;
    }
    .guide-badge {
      top: 1rem;
      left: 1rem;
      font-size: 1.2rem;
      box-shadow: 4px 4px 0 var(--accent-orange);
    }
    .guide-title {
        margin-top: 1.5rem;
    }
    .format-changes {
      padding: 3rem 1.5rem;
    }
    .warning-box {
      padding: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .guide-title {
        text-shadow: 2px 2px 0 var(--primary), 4px 4px 0 var(--accent-orange);
    }
    .author-tag {
        padding: 0.5rem 1rem;
        transform: none; /* Straighten for more space on tiny screens */
    }
    .log-item {
        padding-left: 1rem;
    }
  }
</style>
