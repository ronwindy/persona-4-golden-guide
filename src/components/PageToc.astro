---
import '../styles/page-toc.css';
import type { PageToc } from '../lib/guideData';

interface Props {
  entries: PageToc[];
}

const { entries } = Astro.props;

const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const WEEKDAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const DATE_RE = new RegExp(`^(${MONTHS.join('|')})\\s+(\\d{1,2})(?:st|nd|rd|th)?\\b`);

// Persona 4 runs April 2011 to March 2012, which fixes the weekday of every in-game date.
const rows = entries.map((e) => {
  const m = e.title.match(DATE_RE);
  if (!m) return { ...e, date: null };
  const month = MONTHS.indexOf(m[1]);
  const day = Number(m[2]);
  const dow = new Date(month >= 3 ? 2011 : 2012, month, day).getDay();
  return { ...e, date: { month, day, weekday: WEEKDAYS[dow], weekend: dow === 0 || dow === 6 } };
});

const dated = rows.filter((r) => r.date);
const first = dated[0]?.date;
const last = dated[dated.length - 1]?.date;
const abbr = (month: number) => MONTHS[month].slice(0, 3);
const range = first && last && dated.length > 1 ? `${abbr(first.month)} ${first.day}` + ' → ' + `${abbr(last.month)} ${last.day}` : '';
const ghost = first && last ? (first.month === last.month ? MONTHS[first.month] : `${abbr(first.month)}–${abbr(last.month)}`) : '';
const ghostSize = Math.min(3.9, 12.5 / (Math.max(ghost.length, 1) * 0.78));
const usePips = rows.length <= 31;
---

{entries.length > 0 && (
  <nav class="page-toc" aria-label="On this page" data-page-toc>
    <details class="page-toc-box">
      <summary>
        {ghost && <span class="page-toc-ghost" aria-hidden="true" style={`font-size:${ghostSize.toFixed(2)}rem`}>{ghost}</span>}
        <span class="page-toc-slab"><span>On this page</span></span>
        {range
          ? <span class="page-toc-range"><span class="page-toc-range-label">Covers</span><span class="page-toc-range-text">{range}</span></span>
          : <span class="page-toc-range"><span class="page-toc-range-label">Sections</span><span class="page-toc-range-text">{entries.length}</span></span>}
        {usePips
          ? <span class="page-toc-pips" aria-hidden="true">{rows.map(() => <span data-toc-pip />)}</span>
          : <span class="page-toc-pips page-toc-bar" aria-hidden="true"><span /></span>}
      </summary>
      <ol class="page-toc-list">
        {rows.map((r) => (
          <li>
            <a href={`#${r.id}`} data-toc-link>
              {r.date
                ? (
                  <span class={`toc-leaf${r.date.weekend ? ' is-weekend' : ''}`} aria-hidden="true">
                    <span class="toc-leaf-band">{r.date.weekday}</span>
                    <span class="toc-leaf-num">{r.date.day}</span>
                  </span>
                )
                : <span class="toc-mark" aria-hidden="true"><i /></span>}
              <span class="toc-label">
                <span class="toc-now">Now reading</span>
                <span class="toc-title">{r.title}</span>
              </span>
              <svg class="toc-check" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
            </a>
          </li>
        ))}
      </ol>
    </details>
  </nav>
)}

<script is:inline>
  (function () {
    var nav = document.querySelector('[data-page-toc]');
    if (!nav) return;
    var box = nav.querySelector('details');
    var wide = window.matchMedia('(min-width: 1280px)');
    var sync = function () { if (wide.matches) box.setAttribute('open', ''); else box.removeAttribute('open'); };
    sync();
    if (wide.addEventListener) wide.addEventListener('change', sync);

    var links = Array.prototype.slice.call(nav.querySelectorAll('[data-toc-link]'));
    var heads = links.map(function (a) { return document.getElementById(a.getAttribute('href').slice(1)); });
    var pips = Array.prototype.slice.call(nav.querySelectorAll('[data-toc-pip]'));
    var article = document.querySelector('.guide-body');
    var current = -1;
    var progress = function () {
      if (!article) return;
      var r = article.getBoundingClientRect();
      var total = r.height - window.innerHeight * 0.5;
      var p = total > 0 ? Math.min(1, Math.max(0, (window.innerHeight * 0.25 - r.top) / total)) : 0;
      nav.style.setProperty('--toc-progress', p.toFixed(3));
    };
    var update = function () {
      progress();
      var at = -1;
      for (var i = 0; i < heads.length; i++) {
        if (heads[i] && heads[i].getBoundingClientRect().top <= 120) at = i; else break;
      }
      if (at === current) return;
      current = at;
      links.forEach(function (a, i) {
        a.parentNode.classList.toggle('is-read', i < at);
        if (pips[i]) {
          pips[i].classList.toggle('is-done', i < at);
          pips[i].classList.toggle('is-now', i === at);
        }
        if (i === at) {
          a.setAttribute('aria-current', 'true');
          if (wide.matches) {
            var list = a.closest('.page-toc-list');
            var top = a.offsetTop, bottom = top + a.offsetHeight;
            if (top < list.scrollTop || bottom > list.scrollTop + list.clientHeight) list.scrollTop = top - list.clientHeight / 2;
          }
        } else a.removeAttribute('aria-current');
      });
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>
