---
// Quick page search: a command palette over page titles and category names (no page text, no h4s).
// Rows are rendered here once; the script filters, highlights and reorders them in place.
import { getToc } from '../lib/guideData';
import { navCategoryIcon, navEntryIcon } from '../lib/icons';
import { Search, X, CornerDownLeft, BookOpen, Clock } from '@lucide/astro';

const categories = getToc();
const total = categories.reduce((n, c) => n + c.entries.length, 0);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<dialog id="quick-search" class="qs" aria-label="Search pages">
  <div class="qs-top">
    <span class="qs-slab" aria-hidden="true"><span>Search</span></span>
    <button type="button" class="qs-cancel" data-qs-close>Cancel</button>
  </div>

  <div class="qs-input-row">
    <Search class="qs-input-icon" size={20} aria-hidden="true" />
    <label class="qs-sr" for="qs-input">Search page titles</label>
    <input
      id="qs-input"
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="qs-list"
      aria-autocomplete="list"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="go"
      placeholder="Search pages…"
    />
    <kbd class="qs-esc">Esc</kbd>
    <button type="button" class="qs-clear" aria-label="Clear search" hidden><X size={18} aria-hidden="true" /></button>
  </div>
  <div class="qs-rule" aria-hidden="true"></div>

  <div class="qs-list" id="qs-list" role="listbox" aria-label="Pages">
    <div class="qs-recent" data-qs-recent>
      <section class="qs-group" data-qs-continue hidden>
        <div class="qs-group-head"><BookOpen size={14} aria-hidden="true" /><span class="qs-group-label">Continue reading</span></div>
        <div class="qs-rows"></div>
      </section>
      <section class="qs-group" data-qs-history hidden>
        <div class="qs-group-head"><Clock size={14} aria-hidden="true" /><span class="qs-group-label">Recent</span></div>
        <div class="qs-rows"></div>
      </section>
      <p class="qs-hint" data-qs-hint hidden>Type to find a page by its title or category.</p>
    </div>

    <div class="qs-results" data-qs-results hidden>
      {categories.map((cat) => {
        const CatIcon = navCategoryIcon(cat.category);
        return (
          <section class="qs-group" data-qs-group>
            <div class="qs-group-head"><CatIcon size={14} aria-hidden="true" /><span class="qs-group-label" data-label={cat.category}>{cat.category}</span></div>
            {cat.entries.map((entry) => {
              const EntryIcon = navEntryIcon(cat.category, entry.title);
              return (
                <a class="qs-row" role="option" id={`qs-p-${entry.id}`} href={`${baseUrl}/guide/${entry.id}`} data-id={entry.id} data-title={entry.title} data-cat={cat.category}>
                  <EntryIcon class="qs-row-icon" size={18} aria-hidden="true" />
                  <span class="qs-row-title">{entry.title}</span>
                  <span class="qs-row-crumb"></span>
                  <CornerDownLeft class="qs-row-enter" size={15} aria-hidden="true" />
                </a>
              );
            })}
          </section>
        );
      })}
    </div>

    <div class="qs-empty" data-qs-empty hidden>
      <p>No page title or category matches “<span data-qs-empty-q></span>”.</p>
      <p class="qs-empty-sub">Search covers page titles and category names.</p>
    </div>
  </div>

  <div class="qs-foot">
    <span class="qs-key"><kbd>↑</kbd><kbd>↓</kbd> Move</span>
    <span class="qs-key"><kbd>Enter</kbd> Open</span>
    <span class="qs-key"><kbd>Esc</kbd> Close</span>
    <span class="qs-count" data-qs-count data-total={total}>{total} pages</span>
  </div>
</dialog>

<script>
  const RECENT_KEY = 'p4g-recent-v1';
  const PROGRESS_KEY = 'p4g-progress-v2';

  const dialog = document.getElementById('quick-search') as HTMLDialogElement | null;
  if (dialog) {
    const input = dialog.querySelector<HTMLInputElement>('#qs-input')!;
    const clearBtn = dialog.querySelector<HTMLButtonElement>('.qs-clear')!;
    const list = dialog.querySelector<HTMLElement>('.qs-list')!;
    const recentBox = dialog.querySelector<HTMLElement>('[data-qs-recent]')!;
    const resultsBox = dialog.querySelector<HTMLElement>('[data-qs-results]')!;
    const emptyBox = dialog.querySelector<HTMLElement>('[data-qs-empty]')!;
    const emptyQ = dialog.querySelector<HTMLElement>('[data-qs-empty-q]')!;
    const countEl = dialog.querySelector<HTMLElement>('[data-qs-count]')!;
    const total = Number(countEl.dataset.total || 0);
    const groups = Array.from(resultsBox.querySelectorAll<HTMLElement>('[data-qs-group]'));
    const rowById = new Map<string, HTMLAnchorElement>();
    resultsBox.querySelectorAll<HTMLAnchorElement>('.qs-row').forEach((r) => rowById.set(r.dataset.id!, r));

    let visible: HTMLAnchorElement[] = [];
    let active = 0;

    const readJson = (key: string) => {
      try { return JSON.parse(localStorage.getItem(key) || 'null'); } catch { return null; }
    };
    const currentId = document.querySelector('.sidebar a[aria-current="page"]')?.getAttribute('data-page-id') || '';

    // Remember this page as recently opened (newest first, a few kept).
    if (currentId) {
      const recent: string[] = (readJson(RECENT_KEY) || []).filter((id: unknown) => typeof id === 'string' && id !== currentId);
      recent.unshift(currentId);
      try { localStorage.setItem(RECENT_KEY, JSON.stringify(recent.slice(0, 6))); } catch {}
    }

    function setText(el: HTMLElement, text: string, at = -1, len = 0) {
      el.textContent = '';
      if (at < 0) { el.textContent = text; return; }
      const mark = document.createElement('mark');
      mark.textContent = text.slice(at, at + len);
      el.append(text.slice(0, at), mark, text.slice(at + len));
    }

    function cloneRow(id: string, prefix: string, crumb: string, hash = '') {
      const src = rowById.get(id);
      if (!src) return null;
      const row = src.cloneNode(true) as HTMLAnchorElement;
      row.id = `${prefix}-${id}`;
      if (hash) row.href = `${src.href}#${hash}`;
      row.querySelector<HTMLElement>('.qs-row-crumb')!.textContent = crumb;
      return row;
    }

    function buildRecent() {
      const contSec = recentBox.querySelector<HTMLElement>('[data-qs-continue]')!;
      const histSec = recentBox.querySelector<HTMLElement>('[data-qs-history]')!;
      const contRows = contSec.querySelector<HTMLElement>('.qs-rows')!;
      const histRows = histSec.querySelector<HTMLElement>('.qs-rows')!;
      contRows.textContent = '';
      histRows.textContent = '';

      const last = readJson(PROGRESS_KEY)?.last;
      const cont = last && last.page ? cloneRow(last.page, 'qs-c', last.label || rowById.get(last.page)?.dataset.cat || '', last.date || '') : null;
      if (cont) contRows.append(cont);
      contSec.hidden = !cont;

      const ids: string[] = (readJson(RECENT_KEY) || []).filter((id: unknown) => typeof id === 'string' && id !== currentId).slice(0, 5);
      ids.forEach((id) => {
        const row = cloneRow(id, 'qs-h', rowById.get(id)?.dataset.cat || '');
        if (row) histRows.append(row);
      });
      histSec.hidden = !histRows.children.length;
      recentBox.querySelector<HTMLElement>('[data-qs-hint]')!.hidden = !!cont || !!histRows.children.length;
    }

    function render() {
      const q = input.value.trim().toLowerCase();
      clearBtn.hidden = !input.value;
      if (!q) {
        recentBox.hidden = false;
        resultsBox.hidden = true;
        emptyBox.hidden = true;
        visible = Array.from(recentBox.querySelectorAll<HTMLAnchorElement>('.qs-row'));
        countEl.textContent = `${total} pages`;
      } else {
        recentBox.hidden = true;
        const titleGroups: HTMLElement[] = [];
        const catGroups: HTMLElement[] = [];
        for (const group of groups) {
          const label = group.querySelector<HTMLElement>('.qs-group-label')!;
          const catText = label.dataset.label || '';
          const catAt = catText.toLowerCase().indexOf(q);
          setText(label, catText, catAt, q.length);
          let shown = 0;
          let titleHit = false;
          group.querySelectorAll<HTMLAnchorElement>('.qs-row').forEach((row) => {
            const title = row.dataset.title || '';
            const at = title.toLowerCase().indexOf(q);
            const show = at >= 0 || catAt >= 0;
            if (at >= 0) titleHit = true;
            row.hidden = !show;
            if (show) shown++;
            setText(row.querySelector<HTMLElement>('.qs-row-title')!, title, at, q.length);
          });
          group.hidden = !shown;
          if (shown) (titleHit ? titleGroups : catGroups).push(group);
        }
        // Groups with a title match first, then groups matched only by their category name; sidebar order within each.
        [...titleGroups, ...catGroups].forEach((g) => resultsBox.append(g));
        visible = Array.from(resultsBox.querySelectorAll<HTMLAnchorElement>('.qs-row:not([hidden])'));
        resultsBox.hidden = !visible.length;
        emptyBox.hidden = !!visible.length;
        emptyQ.textContent = input.value.trim();
        countEl.textContent = visible.length ? `${visible.length} ${visible.length === 1 ? 'page' : 'pages'}` : 'No matches';
      }
      setActive(0, false);
      list.scrollTop = 0;
    }

    function setActive(i: number, scroll = true) {
      dialog!.querySelectorAll('.qs-row[aria-selected="true"]').forEach((r) => r.setAttribute('aria-selected', 'false'));
      if (!visible.length) { input.removeAttribute('aria-activedescendant'); return; }
      active = (i + visible.length) % visible.length;
      const row = visible[active];
      row.setAttribute('aria-selected', 'true');
      input.setAttribute('aria-activedescendant', row.id);
      if (scroll) row.scrollIntoView({ block: 'nearest' });
    }

    function open() {
      if (dialog!.open) return;
      buildRecent();
      input.value = '';
      render();
      dialog!.showModal();
      document.documentElement.setAttribute('data-qs-open', '');
      input.focus();
    }
    function close() { if (dialog!.open) dialog!.close(); }

    dialog.addEventListener('close', () => document.documentElement.removeAttribute('data-qs-open'));
    input.addEventListener('input', render);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
      else if (e.key === 'Enter') {
        const row = visible[active];
        if (row) { e.preventDefault(); row.click(); }
      }
    });
    clearBtn.addEventListener('click', () => { input.value = ''; render(); input.focus(); });
    // Hover picks the row under the pointer (mousemove, so keyboard scrolling does not steal the selection).
    list.addEventListener('mousemove', (e) => {
      const row = (e.target as Element).closest?.('.qs-row') as HTMLAnchorElement | null;
      const i = row ? visible.indexOf(row) : -1;
      if (i >= 0 && i !== active) setActive(i, false);
    });
    // Following a row closes the palette (matters for same-page links such as "Continue reading").
    list.addEventListener('click', (e) => { if ((e.target as Element).closest?.('.qs-row')) close(); });
    dialog.querySelectorAll('[data-qs-close]').forEach((b) => b.addEventListener('click', close));
    // Click on the dimmed backdrop closes.
    dialog.addEventListener('click', (e) => { if (e.target === dialog) close(); });

    document.querySelectorAll('[data-qs-open]').forEach((b) => b.addEventListener('click', open));
    const isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
    if (isMac) document.querySelectorAll('[data-qs-shortcut]').forEach((k) => { k.textContent = '⌘ K'; });
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && !e.altKey && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (dialog.open) close(); else open();
        return;
      }
      if (e.key === '/' && !e.ctrlKey && !e.metaKey && !e.altKey && !dialog.open) {
        const t = e.target as HTMLElement;
        if (t.closest('input, textarea, select, [contenteditable=""], [contenteditable="true"]')) return;
        e.preventDefault();
        open();
      }
    });
  }
</script>
