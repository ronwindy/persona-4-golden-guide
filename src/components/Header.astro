---
// src/components/Header.astro
import HeaderDecorations from "./HeaderDecorations.astro";
import MobileMenuButton from "./MobileMenuButton.astro";
---

<header class="header bg-p4g-flow">
  <HeaderDecorations />
  <div class="header-banner-img"></div>
  <div class="bg-scanlines"></div>
  <div class="header-container">
    <MobileMenuButton />
    <a href="/persona-4-golden-guide/" class="header-logo-link">
      <img
        src="/persona-4-golden-guide/Persona_4_Golden_logo.webp"
        alt="Persona 4 Golden Logo"
        class="header-logo"
      />
    </a>
    <div class="header-text">
      <h1 class="header-fragmented-title font-pop">
        <span class="anim-pop stagger-1"><span class="frag-the">The</span></span
        >
        <span class="anim-pop stagger-2"
          ><span class="frag-100">100%</span></span
        >
        <span class="anim-pop stagger-2"
          ><span class="frag-true">True</span></span
        >
        <span class="anim-pop stagger-3">
          <span class="frag-golden">
            <span class="gold-text">Golden</span>
            <span class="star s-1">✦</span>
            <span class="star s-2">✦</span>
            <span class="star s-3">✦</span>
            <span class="star s-4">✦</span>
          </span>
        </span>
        <span class="anim-pop stagger-4"
          ><span class="frag-walk">Walkthrough</span></span
        >
      </h1>
    </div>
  </div>
</header>

<style>
  /* Base Styles */
  .header {
    position: relative;
    width: 100%;
    background-color: var(--primary);
    border-bottom: 8px solid var(--secondary);
    padding: 1.5rem 0;
    overflow: hidden;
    box-shadow: none;
  }

  /* High-energy geometric animation */
  .header.bg-p4g-flow {
    animation: headerPump 2s ease-in-out infinite alternate;
  }

  @keyframes headerPump {
    0% {
      filter: contrast(1) brightness(1);
    }
    100% {
      filter: contrast(1.1) brightness(1.05);
    }
  }

  .header-banner-img {
    position: absolute;
    inset: 0;
    background-image: url("/persona-4-golden-guide/p4g-header-banner.jpg");
    background-repeat: no-repeat;
    pointer-events: none;
    z-index: 5;
    background-size: 50% auto;
    background-position: right top;
    opacity: 0.7;
  }

  .header-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    gap: 2.5rem;
    position: relative;
    z-index: 20;
  }

  .header-logo-link {
    flex-shrink: 0;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .header-logo-link:hover {
    transform: scale(1.05) rotate(-2deg);
  }

  .header-logo {
    display: block;
    height: 110px;
    width: auto;
    max-width: 400px;
    filter: drop-shadow(6px 6px 0px var(--secondary));
    object-fit: contain;
  }

  .header-fragmented-title {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    max-width: fit-content;
    perspective: 1000px;
    flex-wrap: wrap;
  }

  .header-fragmented-title > span {
    display: inline-block;
    line-height: 1;
    transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    white-space: nowrap;
    will-change: transform;
  }

  .header-fragmented-title > span > span {
    display: inline-block;
    padding: 0.2rem 0.8rem;
  }

  .frag-the {
    font-size: 2rem;
    color: var(--bg-white);
    text-shadow: 2px 2px 0 var(--secondary);
  }

  .frag-100 {
    font-size: 2.5rem;
    background: #fff;
    color: var(--secondary);
    transform: rotate(-6deg) translateY(-4px) translateX(0px);
    box-shadow: 6px 6px 0 var(--secondary);
    z-index: 5;
  }

  .frag-true {
    font-size: 2rem;
    color: var(--bg-white);
    text-shadow: 2px 2px 0 var(--secondary);
  }

  .frag-golden {
    font-size: 3.5rem;
    background: radial-gradient(
      circle at center,
      var(--accent-blue) 0%,
      var(--secondary) 100%
    );
    box-shadow:
      10px 10px 0 var(--accent-orange),
      inset 0 0 30px rgba(0, 0, 0, 0.8);
    z-index: 10;
    margin: 0 0.5rem;
    position: relative;
    border: 3px solid var(--primary);
    line-height: 1;
    overflow: hidden;
  }

  /* Static CRT Texture */
  .frag-golden::before {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      transparent 0,
      transparent 2px,
      rgba(0, 0, 0, 0.15) 2px,
      rgba(0, 0, 0, 0.15) 4px
    );
    pointer-events: none;
    z-index: 2;
  }

  /* Subtle TV Screen Glow */
  .frag-golden::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 40% 40%,
      rgba(255, 215, 0, 0.05) 0%,
      transparent 60%
    );
    pointer-events: none;
    z-index: 1;
  }

  .gold-text {
    background: linear-gradient(
      to bottom,
      #fff 0%,
      #ffd700 20%,
      #d4af37 45%,
      #ffff7e 50%,
      #d4af37 55%,
      #ffd700 80%,
      #fff 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent !important;
    font-weight: 800;
    display: inline-block;
    padding: 0 0.9rem;
    filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.5));
    animation: goldPulse 4s infinite ease-in-out;
  }

  @keyframes goldPulse {
    0%,
    100% {
      filter: drop-shadow(0 0 2px rgba(255, 215, 0, 0.5));
    }
    50% {
      filter: drop-shadow(0 0 15px rgba(255, 215, 0, 0.8));
    }
  }

  /* Frag Stars */
  .frag-golden .star {
    position: absolute;
    color: #fff;
    filter: drop-shadow(0 0 8px #fff);
    pointer-events: none;
    opacity: 0;
    line-height: 1;
    z-index: 15;
    animation: twinkle var(--tw-dur) infinite ease-in-out var(--tw-del);
  }

  .s-1 {
    top: 10%;
    left: 5%;
    font-size: 1.2rem;
    --tw-dur: 1.8s;
    --tw-del: 0.2s;
  }
  .s-2 {
    top: 65%;
    left: 85%;
    font-size: 0.9rem;
    --tw-dur: 2.2s;
    --tw-del: 0.7s;
  }
  .s-3 {
    top: 15%;
    left: 60%;
    font-size: 1.4rem;
    --tw-dur: 1.5s;
    --tw-del: 1.1s;
  }
  .s-4 {
    top: 75%;
    left: 25%;
    font-size: 1rem;
    --tw-dur: 2.5s;
    --tw-del: 0.4s;
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 0;
      transform: scale(0.4) rotate(0deg);
    }
    50% {
      opacity: 1;
      transform: scale(1.1) rotate(60deg);
    }
  }

  .frag-walk {
    font-size: 2.26rem;
    color: #fff;
    text-shadow: 2px 2px 0 var(--secondary);
  }

  /* Tablet / Landscape Phone Overrides */
  @media (min-width: 769px) and (max-width: 1023px) {
    .header-container {
      padding-left: 10rem;
    }

    .header-fragmented-title {
      font-size: 0.8rem;
    }

    .header-banner-img {
      background-size: cover;
      background-position: right -100px top;
      opacity: 0.7;
      mix-blend-mode: darken;
    }
  }

  /* Mobile Overrides */
  @media (max-width: 768px) {
    .header-container {
      flex-direction: column;
      text-align: center;
    }

    .header-logo {
      height: 85px;
      margin: 0 auto;
    }

    .header-fragmented-title {
      justify-content: center;
      gap: 1rem;
      width: 360px;
    }

    .header-banner-img {
      background-size: cover;
      background-position: right 30% top;
      opacity: 0.5;
    }
  }
</style>
