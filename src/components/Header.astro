---
// src/components/Header.astro
import HeaderDecorations from './HeaderDecorations.astro';
import MobileMenuButton from './MobileMenuButton.astro';
---

<header class="header bg-p4g-flow">
  <HeaderDecorations />
  <div class="header-banner-img"></div>
  <div class="bg-scanlines"></div>
  <div class="header-container">
    <MobileMenuButton />
    <a href="/persona-4-golden-guide/" class="header-logo-link">
      <img
        src="/persona-4-golden-guide/Persona_4_Golden_logo.webp"
        alt="Persona 4 Golden Logo"
        class="header-logo"
      />
    </a>
    <div class="header-text">
      <h1 class="font-pop header-title">
        <span class="anim-pop stagger-1">Persona</span>
        <span class="anim-pop stagger-2">4</span>
        <span class="anim-pop stagger-3">Golden</span>
        <span class="anim-pop stagger-4">Walkthrough</span>
      </h1>
      <p class="font-read header-subtitle anim-slide-in">
        The 100% True Golden Walkthrough
      </p>
    </div>
  </div>
</header>

<style>
  /* Specific fix for Mobile Landscape / Medium Widths */
  @media (min-width: 769px) and (max-width: 1023px) {
    .header-container {
      padding-left: 11rem; /* Push logo out of the menu button's way */
      gap: 1.5rem;
      justify-content: flex-start;
    }
    
    .header-logo {
      height: 90px; /* Slightly smaller for better fit in short landscape heights */
    }

    .header-title {
      font-size: 2.2rem;
    }
    
    .header-title span:nth-child(2) {
      font-size: 2.8rem;
    }
  }

  /* Simplified Header Styles */
  .header {
    position: relative;
    width: 100%;
    background-color: var(--primary);
    border-bottom: 8px solid var(--secondary);
    padding: 1.5rem 0;
    overflow: hidden;
    display: block;
    box-shadow: none; /* Remove shadow on mobile to prevent overflow */
  }

  /* High-energy geometric animation */
  .header.bg-p4g-flow {
    animation: headerPump 2s ease-in-out infinite alternate;
  }

  @keyframes headerPump {
    0% { filter: contrast(1) brightness(1); }
    100% { filter: contrast(1.1) brightness(1.05); }
  }

  .header-banner-img {
    position: absolute;
    inset: 0;
    background-image: url("/persona-4-golden-guide/p4g-header-banner.jpg");
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center bottom;
    opacity: 0.6;
    pointer-events: none;
    z-index: 5; 
  }

  /* Specific fix for Mobile Landscape / Medium Widths (Phone landscape/Tablets) */
  @media (min-width: 769px) and (max-width: 1023px) {
    .header-banner-img {
      background-size: cover;
      background-position: center right;
      opacity: 0.7;
      -webkit-mask-image: linear-gradient(to right, transparent, black 60%);
      mask-image: linear-gradient(to right, transparent, black 60%);
    }
  }

  /* Restore the user's carefully positioned Desktop BG */
  @media (min-width: 1024px) {
    .header {
      box-shadow: 8px 8px 0 var(--secondary);
    }
    .header-banner-img {
      background-size: 50% auto;
      background-position: right top;
      opacity: 0.7;
      mask-image: none;
      -webkit-mask-image: none;
    }
  }

  .header-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    gap: 2.5rem;
    position: relative;
    z-index: 20;
  }

  .header-logo-link {
    display: block;
    flex: 0 0 auto;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    line-height: 0;
  }

  .header-logo-link:hover {
    transform: scale(1.05) rotate(-2deg);
  }

  .header-logo {
    display: block;
    height: 110px;
    width: auto;
    max-width: 400px;
    filter: drop-shadow(6px 6px 0px var(--secondary));
    object-fit: contain;
    flex-shrink: 0; /* Prevent the logo from squishing in landscape */
  }

  .header-title {
    font-size: 2.8rem;
    font-weight: 400;
    color: #fff;
    line-height: 1;
    text-transform: uppercase;
    margin: 0;
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: flex-start;
    padding-top: 0.5rem;
  }

  .header-title span {
    position: relative;
    display: inline-block;
    padding: 0.15rem 0.4rem;
    background: var(--secondary);
    color: #fff;
    transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 4px 4px 0 var(--accent-orange);
    will-change: transform;
  }

  .header-title span:nth-child(odd) {
    transform: rotate(-2deg) translateY(-5px);
  }

  .header-title span:nth-child(even) {
    transform: rotate(2deg) translateY(5px);
  }

  .header-title span:nth-child(2) {
    background: #fff;
    color: var(--secondary);
    z-index: 10;
    font-size: 3.4rem;
    padding: 0 0.8rem;
    margin: 0 -0.4rem;
    box-shadow: 6px 6px 0 var(--secondary);
  }

  .header-title:hover span {
    transform: rotate(0deg) scale(1.1);
    background: var(--accent-orange);
    color: var(--secondary);
    box-shadow: 10px 10px 0 var(--secondary);
    z-index: 30;
  }

  .header-title span::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.2) 1px, transparent 1px);
    background-size: 4px 4px;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .header-title:hover span::before {
    opacity: 1;
  }

  .header-subtitle {
    background: var(--secondary);
    color: var(--primary);
    display: inline-block;
    padding: 0.15rem 0.6rem;
    margin-top: 0.75rem;
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    font-style: italic;
    width: fit-content;
    transform: rotate(-0.5deg);
    box-shadow: 3px 3px 0 var(--accent-orange);
    transition: all 0.3s;
  }

  .header-text:hover .header-subtitle {
    transform: rotate(1deg) scale(1.05);
    background: var(--accent-orange);
    color: var(--secondary);
  }

  @media (max-width: 768px) {
    .header-container {
      flex-direction: column;
      text-align: center;
      gap: 1.25rem;
      padding: 1.5rem 1rem;
    }

    .header-logo {
      height: 70px !important;
      margin: 0 auto;
    }

    .header-title {
      font-size: 1.6rem;
      justify-content: center;
      gap: 0.25rem;
    }

    .header-title span:nth-child(2) {
      font-size: 2.2rem;
      padding: 0 0.4rem;
      margin: 0 -0.2rem;
    }

    .header-subtitle {
      font-size: 0.8rem;
      padding: 0.2rem 0.5rem;
      margin-top: 0.5rem;
    }
  }

  @media (max-width: 380px) {
    .header-title {
        font-size: 1.3rem;
    }
    .header-title span:nth-child(2) {
        font-size: 1.8rem;
    }
    .header-logo {
        height: 60px;
    }
  }
</style>
