---
// src/components/Header.astro
---

<header class="header bg-halftone p4g-shadow">
  <div class="header-decorations">
    <span class="shape-1"></span>
    <span class="shape-2"></span>
    <span class="shape-3"></span>
  </div>
  <div class="header-banner-img"></div>
  <div class="bg-scanlines"></div>
  <div class="header-container">
    <a href="/" class="header-logo-link">
      <img
        src="/Persona_4_Golden_logo.webp"
        alt="Persona 4 Golden Logo"
        class="header-logo"
      />
    </a>
    <div class="header-text">
      <h1 class="font-pop header-title">
        <span class="anim-pop stagger-1">Persona</span>
        <span class="anim-pop stagger-2">4</span>
        <span class="anim-pop stagger-3">Golden</span>
        <span class="anim-pop stagger-4">Walkthrough</span>
      </h1>
      <p class="font-read header-subtitle anim-slide-in">
        The 100% True Golden Walkthrough
      </p>
    </div>
  </div>
</header>

<style>
  /* Simplified Header Styles */
  .header {
    position: relative;
    width: 100%;
    background-color: var(--primary) !important;
    border-bottom: 8px solid var(--secondary);
    padding: 1.5rem 0;
    overflow: hidden;
    display: block;
  }

  /* Animated halftone for header only */
  .header.bg-halftone {
    animation: halftonePulse 8s ease-in-out infinite;
  }

  @keyframes halftonePulse {
    0%, 100% { background-size: 12px 12px; }
    50% { background-size: 13px 13px; }
  }

  .header-banner-img {
    position: absolute;
    inset: 0;
    background-image: url("/p4g-header-banner.jpg");
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center bottom;
    opacity: 0.6;
    pointer-events: none;
    z-index: 5; 
  }

  @media (min-width: 769px) {
    .header-banner-img {
      background-size: 50% auto;
      background-position: right top;
      opacity: 0.7;
    }
  }

  .header-decorations {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    overflow: hidden;
  }

  .header-decorations span {
    position: absolute;
    opacity: 0.2;
    background: var(--accent-orange);
    clip-path: polygon(10% 0, 100% 0, 90% 100%, 0 100%);
  }

  .shape-1 {
    width: 200px;
    height: 40px;
    top: 20%;
    left: 10%;
    animation: float 10s ease-in-out infinite;
  }

  .shape-2 {
    width: 150px;
    height: 30px;
    bottom: 30%;
    right: 30%;
    background: var(--accent-blue) !important;
    animation: float 15s ease-in-out infinite reverse;
  }

  .shape-3 {
    width: 100px;
    height: 100px;
    top: 50%;
    left: 40%;
    opacity: 0.1 !important;
    animation: float 12s ease-in-out infinite 2s;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(20px, -20px) rotate(2deg); }
  }

  .header-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    gap: 2.5rem;
    position: relative;
    z-index: 20;
  }

  .header-logo-link {
    display: block;
    flex: 0 0 auto;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    line-height: 0;
  }

  .header-logo-link:hover {
    transform: scale(1.05) rotate(-2deg);
  }

  .header-logo {
    display: block;
    height: 110px !important;
    width: auto !important;
    max-width: 400px;
    filter: drop-shadow(6px 6px 0px var(--secondary));
    object-fit: contain;
  }

  .header-title {
    font-family: "Staatliches", cursive;
    font-size: 3.5rem;
    font-weight: 400;
    color: #fff;
    line-height: 1.1;
    text-transform: uppercase;
    font-style: italic;
    text-shadow:
      -2px -2px 0 var(--secondary),
      2px -2px 0 var(--secondary),
      -2px 2px 0 var(--secondary),
      2px 2px 0 var(--secondary),
      6px 6px 0 var(--secondary),
      8px 8px 0 var(--accent-orange);
    margin: 0;
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    justify-content: flex-start;
  }

  /* Note: 'jitter' animation is defined in global.css */
  .header-title:hover span {
    animation: jitter 0.2s infinite;
    color: #fff;
    text-shadow:
      -4px -4px 0 #ff0000,
      4px 4px 0 #00ffff,
      -2px -2px 0 var(--secondary),
      2px -2px 0 var(--secondary),
      -2px 2px 0 var(--secondary),
      2px 2px 0 var(--secondary),
      6px 6px 0 var(--secondary);
  }

  .header-subtitle {
    background: var(--secondary);
    color: var(--primary);
    display: inline-block;
    padding: 0.15rem 0.6rem;
    margin-top: 0.75rem;
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    font-style: italic;
    width: fit-content;
    transform: rotate(-0.5deg);
    box-shadow: 3px 3px 0 var(--accent-orange);
    transition: all 0.3s;
  }

  .header-text:hover .header-subtitle {
    transform: rotate(1deg) scale(1.05);
    background: var(--accent-orange);
    color: var(--secondary);
  }

  @media (max-width: 768px) {
    .header-container {
      flex-direction: column;
      text-align: center;
      gap: 1.25rem;
      padding: 1.5rem 1rem;
    }

    .header-logo {
      height: 75px !important;
      margin: 0 auto;
    }

    .header-title {
      font-size: 1.8rem;
      justify-content: center;
      gap: 0.25rem;
    }

    .header-subtitle {
      font-size: 0.85rem;
      padding: 0.2rem 0.5rem;
    }

    .shape-1, .shape-2, .shape-3 {
        display: none;
    }
  }
</style>
