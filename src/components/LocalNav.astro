---
// src/components/LocalNav.astro
import { Icon } from "astro-icon/components";

export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: TocHeading[];
}

const { headings = [] } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  filteredHeadings.length > 0 && (
    <>
      {/* Inline Accordion TOC for Tablets and Mobile (< 1280px) */}
      <div class="mobile-toc-container">
        <details class="mobile-toc-details">
          <summary class="mobile-toc-summary">
            <span class="summary-left">
              <Icon name="lucide:list" class="icon-toc" size={15} aria-hidden="true" />
              <span class="summary-title">On this page</span>
            </span>
            <span class="summary-chevron" aria-hidden="true">
              ▾
            </span>
          </summary>
          <nav class="mobile-toc-nav" aria-label="On this page (mobile)">
            <ul class="mobile-toc-list">
              {filteredHeadings.map((heading) => (
                <li class:list={["mobile-toc-item", `depth-${heading.depth}`]}>
                  <a href={`#${heading.slug}`} class="mobile-toc-link">
                    {heading.depth === 3 && (
                      <span class="mobile-toc-dash" aria-hidden="true">
                        –
                      </span>
                    )}
                    <span>{heading.text}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      </div>

      {/* Desktop Sticky Local Navigation (>= 1280px) */}
      <aside class="desktop-toc-rail" aria-label="Table of Contents">
        <div class="sticky-toc-wrapper">
          <nav class="local-nav" aria-label="On this page">
            <div class="toc-header">
              <div class="toc-header-content">
                <Icon name="lucide:list" class="toc-header-icon" size={14} aria-hidden="true" />
                <span class="toc-label">ON THIS PAGE</span>
              </div>
              <span class="toc-badge">{filteredHeadings.length}</span>
            </div>

            <ul class="toc-list" id="desktop-toc-list">
              {filteredHeadings.map((heading) => (
                <li class:list={["toc-item", `depth-${heading.depth}`]}>
                  <a
                    href={`#${heading.slug}`}
                    class="toc-link"
                    data-slug={heading.slug}
                  >
                    {heading.depth === 3 && (
                      <span class="toc-bullet" aria-hidden="true">
                        –
                      </span>
                    )}
                    <span class="toc-link-text">{heading.text}</span>
                  </a>
                </li>
              ))}
            </ul>

            <div class="toc-footer">
              <a href="#top" class="back-to-top-link">
                <span class="back-to-top-text">Back to top</span>
                <Icon
                  name="lucide:chevron-up"
                  class="back-to-top-icon"
                  size={13}
                  aria-hidden="true"
                />
              </a>
            </div>
          </nav>
        </div>
      </aside>
    </>
  )
}

<style>
  /* =========================================
     Desktop Sticky Rail (>= 1280px)
     ========================================= */
  .desktop-toc-rail {
    display: none;
    width: var(--local-nav-width);
    flex-shrink: 0;
  }

  .sticky-toc-wrapper {
    position: sticky;
    top: 2rem;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    background-color: var(--p4g-surface);
    border: 1px solid var(--p4g-border);
    border-radius: 8px;
    padding: 1.25rem 1.15rem;
    box-shadow: var(--shadow-local-nav);
  }

  .sticky-toc-wrapper::-webkit-scrollbar {
    width: 4px;
  }

  .sticky-toc-wrapper::-webkit-scrollbar-thumb {
    background-color: var(--p4g-border);
    border-radius: 4px;
  }

  .sticky-toc-wrapper::-webkit-scrollbar-thumb:hover {
    background-color: var(--p4g-gray);
  }

  .local-nav {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  /* Header with refined typography and topic count pill */
  .toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--p4g-border-subtle);
  }

  .toc-header-content {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .toc-header-icon {
    color: var(--p4g-gray);
    opacity: 0.8;
    flex-shrink: 0;
  }

  .toc-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    color: var(--p4g-gray);
    text-transform: uppercase;
  }

  .toc-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--p4g-gray);
    background-color: rgba(0, 0, 0, 0.05);
    padding: 0.08rem 0.45rem;
    border-radius: 9999px;
    line-height: 1.2;
  }

  /* Subtle vertical guide track */
  .toc-list {
    list-style: none;
    padding: 0.2rem 0;
    margin: 0;
    border-left: 2px solid var(--p4g-border-subtle);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .toc-item {
    margin: 0;
  }

  .toc-item.depth-3 {
    padding-left: 0.75rem;
  }

  .toc-link {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--p4g-gray);
    padding: 0.3rem 0.5rem 0.3rem 0.75rem;
    position: relative;
    left: -2px; /* aligns active border with container track */
    border-left: 2px solid transparent;
    border-radius: 0 6px 6px 0;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      transform var(--transition-fast);
    overflow-wrap: break-word;
    word-break: break-word;
    text-decoration: none;
  }

  .toc-bullet {
    color: rgba(0, 0, 0, 0.3);
    font-size: 0.7rem;
    flex-shrink: 0;
    transition: color var(--transition-fast);
  }

  /* Depth 3 subsection subtle font size reduction */
  .toc-item.depth-3 .toc-link {
    font-size: 0.775rem;
    color: #888888;
  }

  .toc-link:hover:not(.active) {
    color: var(--p4g-dark);
    background-color: rgba(0, 0, 0, 0.025);
    transform: translateX(2px);
  }

  .toc-link:hover:not(.active) .toc-bullet {
    color: var(--p4g-dark);
  }

  /* Active scrollspy item: yellow accent bar and gentle amber tint capsule */
  .toc-link.active {
    color: var(--p4g-dark);
    font-weight: 700;
    border-left-color: var(--p4g-yellow);
    background-color: rgba(242, 201, 78, 0.14);
  }

  .toc-link.active .toc-bullet {
    color: var(--p4g-yellow-hover);
    font-weight: 700;
  }

  /* Refined Footer Action */
  .toc-footer {
    padding-top: 0.55rem;
    margin-top: 0.2rem;
    border-top: 1px solid var(--p4g-border-subtle);
  }

  .back-to-top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--p4g-gray);
    text-decoration: none;
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
    padding: 0.15rem 0;
  }

  .back-to-top-icon {
    transition:
      transform var(--transition-fast),
      color var(--transition-fast);
    flex-shrink: 0;
  }

  .back-to-top-link:hover {
    color: var(--p4g-dark);
  }

  .back-to-top-link:hover .back-to-top-icon {
    transform: translateY(-2px);
    color: var(--p4g-yellow-hover);
  }

  /* =========================================
     Mobile / Tablet Collapsible Accordion (< 1280px)
     ========================================= */
  .mobile-toc-container {
    display: block;
    width: 100%;
    order: -1;
    margin-bottom: 0.75rem;
  }

  .mobile-toc-details {
    background-color: var(--p4g-surface);
    border: 1px solid var(--p4g-border);
    border-radius: 6px;
    overflow: hidden;
    box-shadow: var(--shadow-mobile-nav);
  }

  .mobile-toc-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0.95rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--p4g-dark);
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background-color var(--transition-fast);
  }

  .mobile-toc-summary:hover {
    background-color: rgba(0, 0, 0, 0.02);
  }

  .mobile-toc-summary::-webkit-details-marker {
    display: none;
  }

  .summary-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .icon-toc {
    color: var(--p4g-gray);
    opacity: 0.8;
  }

  .summary-title {
    letter-spacing: 0.01em;
  }

  .summary-chevron {
    font-size: 0.85rem;
    color: var(--p4g-gray);
    transition: transform var(--transition-fast);
  }

  .mobile-toc-details[open] .summary-chevron {
    transform: rotate(180deg);
  }

  .mobile-toc-nav {
    padding: 0.5rem 0.95rem 0.85rem;
    border-top: 1px solid var(--p4g-border-subtle);
  }

  .mobile-toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .mobile-toc-item.depth-3 {
    padding-left: 0.85rem;
  }

  .mobile-toc-dash {
    color: rgba(0, 0, 0, 0.3);
    margin-right: 0.25rem;
  }

  .mobile-toc-link {
    font-size: 0.8125rem;
    color: #555555;
    display: flex;
    align-items: baseline;
    padding: 0.25rem 0;
    transition: color var(--transition-fast);
  }

  .mobile-toc-link:hover {
    color: var(--p4g-dark);
  }

  /* =========================================
     Breakpoint Switching (DESIGN.md Section 10)
     ========================================= */
  @media (min-width: 1280px) {
    .desktop-toc-rail {
      display: block;
    }

    .mobile-toc-container {
      display: none;
    }
  }
</style>

<script>
  // Scrollspy to highlight active TOC heading
  function setupScrollspy() {
    const links = document.querySelectorAll<HTMLAnchorElement>(
      "#desktop-toc-list .toc-link",
    );
    if (!links.length) return;

    const headingElements: HTMLElement[] = [];
    links.forEach((link) => {
      const slug = link.getAttribute("data-slug");
      if (slug) {
        const el = document.getElementById(slug);
        if (el) headingElements.push(el);
      }
    });

    if (!headingElements.length) return;

    function onScroll() {
      const scrollPos = window.scrollY + 120;
      let currentActiveId = "";

      for (let i = 0; i < headingElements.length; i++) {
        const el = headingElements[i];
        if (el.offsetTop <= scrollPos) {
          currentActiveId = el.id;
        } else {
          break;
        }
      }

      links.forEach((link) => {
        if (link.getAttribute("data-slug") === currentActiveId) {
          link.classList.add("active");
        } else {
          link.classList.remove("active");
        }
      });
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  setupScrollspy();
  document.addEventListener("astro:page-load", setupScrollspy);
</script>
