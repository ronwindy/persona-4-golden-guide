---
// src/layouts/GuideLayout.astro
import Layout from "./Layout.astro";
import SidebarToC from "../components/SidebarToC.astro";

interface Props {
  title: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<Layout {title}>
  <SidebarToC />

  <div class:list={["guide-content-wrapper", className]}>
    <slot />
  </div>
</Layout>

<style>
  .guide-content-wrapper {
    width: 100%;
    position: relative;
    padding: 1rem 1rem 3rem 1rem;
    /* Prevent shadows and rotated elements from triggering horizontal scroll */
    overflow-x: hidden;
  }

  /* Robust box-sizing reset for all guide content */
  .guide-content-wrapper :global(*) {
    box-sizing: border-box;
  }

  /* 
     Centralized Grid Strategy 
     This controls the Sidebar (360px) + Main Content relationship
  */
  :global(.main-layout) {
    display: grid !important;
    max-width: 100vw;
    overflow-x: hidden;
    gap: 1.5rem !important;
    width: 100%;
    margin: 0 auto;
    padding: 0 !important;
  }

  @media (min-width: 1024px) {
    :global(.main-layout) {
      grid-template-columns: 360px 1fr !important;
      max-width: 1600px !important;
      gap: 2.5rem !important;
      padding: 3rem 2rem !important;
    }
  }

  /* Mobile Containment & Safe Zones */
  @media (max-width: 768px) {
    .guide-content-wrapper {
      padding: 1rem 1rem 3rem 1rem;
      width: 100%;
    }

    :global(.main-layout) {
      grid-template-columns: 1fr !important;
      gap: 1rem !important;
      padding: 0 !important;
    }
  }

  /* High-fidelity CRT texture on the guide area */
  .guide-content-wrapper::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      rgba(18, 16, 16, 0) 50%,
      rgba(0, 0, 0, 0.02) 50%
    );
    background-size: 100% 4px;
    pointer-events: none;
    z-index: 1;
    opacity: 0.3;
  }
</style>
