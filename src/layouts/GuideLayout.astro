---
// src/layouts/GuideLayout.astro
import Layout from "./Layout.astro";
import Navigation from "../components/Navigation.astro";
import LocalNav, { type TocHeading } from "../components/LocalNav.astro";

interface Props {
  title?: string;
  description?: string;
  headings?: TocHeading[];
}

const { title, description, headings = [] } = Astro.props;
---

<Layout {title} {description}>
  <div id="top" class="guide-app-wrapper">
    <!-- Global Sidebar (Desktop & Mobile Drawer) -->
    <Navigation />

    <!-- Guide Content Area -->
    <div class="guide-workspace">
      <div class="guide-layout-columns">
        <!-- Main Reading Content Surface -->
        <main class="guide-content-surface">
          <div class="guide-body">
            <slot />
          </div>
        </main>

        <!-- Local Navigation ("On this page") -->
        <LocalNav {headings} />
      </div>
    </div>
  </div>
</Layout>

<style>
  .guide-app-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    width: 100%;
  }

  /* Desktop Multi-column Layout Container */
  @media (min-width: 1024px) {
    .guide-app-wrapper {
      flex-direction: row;
    }
  }

  /* Workspace filling the remaining screen area */
  .guide-workspace {
    flex: 1;
    display: flex;
    justify-content: center;
    padding: 1.25rem 1rem 4rem;
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .guide-workspace {
      padding: 2.5rem 2rem 5rem;
    }
  }

  /* 
     Central Grid Strategy (DESIGN.md Section 4)
     Main Content (~700-800px optimal reading width) + Local Nav (~200-240px)
     Max container: ~1300-1440px, Gap: ~24-32px
  */
  .guide-layout-columns {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: var(--container-max-width);
    gap: 1.5rem;
  }

  @media (min-width: 1280px) {
    .guide-layout-columns {
      flex-direction: row;
      justify-content: center;
      align-items: flex-start;
      gap: 2rem;
    }
  }

  /* Main Reading Content (Constrained for comfortable line measure) */
  .guide-content-surface {
    width: 100%;
    max-width: var(--content-max-width);
    min-width: 0;
  }

  .guide-body {
    background-color: var(--p4g-surface);
    border: 1px solid var(--p4g-border);
    border-radius: 8px;
    padding: 2rem 1.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
  }

  @media (min-width: 768px) {
    .guide-body {
      padding: 2.75rem 2.5rem;
    }
  }
</style>
