---
// src/layouts/Layout.astro
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Persona 4 Golden Guide — Companion & Walkthrough",
  description = "A clean, modern companion guide for Persona 4 Golden covering walkthrough, calendar, social links, and database.",
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${baseUrl}/fav_icon.png`} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Staatliches&display=swap"
      rel="stylesheet"
    />
  </head>
  <body style={`--bg-image: url('${baseUrl}/background.jpeg');`}>
    <slot />
  </body>
</html>
