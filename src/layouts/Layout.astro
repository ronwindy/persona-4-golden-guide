---
import "../styles/global.css";
import Header from "../components/Header.astro";

const { title = "P4G Guide - Reach Out To The Truth" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/png"
      href="/persona-4-golden-guide/fav_icon.png"
    />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Staatliches&family=Outfit:wght@400;600;700&family=Montserrat:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Midnight Channel Background Layer -->
    <div class="midnight-bg">
      <div class="crt-overlay"></div>
    </div>

    <!-- Extracted Header Component -->
    <Header />

    <!-- Caution Tape Divider -->
    <div class="divider bg-stripes"></div>

    <!-- Main Layout -->
    <main class="main-layout">
      <slot />
    </main>
  </body>
</html>
