---
const { title = 'P4G Guide - Reach Out To The Truth' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Montserrat:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Midnight Channel Background Layer -->
    <div class="midnight-bg">
      <div class="crt-overlay"></div>
    </div>

    <!-- Sticky Calendar Tracker -->
    <div class="tracker">
      <div class="tracker-date">
        <span class="font-pop day">MON</span>
        <span class="font-pop date">4/11</span>
      </div>
      <div class="tracker-weather p4g-shadow">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#0C1431"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242" />
          <path d="M16 14v6" />
          <path d="M8 14v6" />
          <path d="M12 16v6" />
        </svg>
      </div>
    </div>

    <!-- Caution Tape Divider -->
    <div class="divider bg-stripes"></div>

    <!-- Hero Section -->
    <header class="hero bg-halftone p4g-shadow">
      <div class="bg-scanlines"></div>
      <div class="hero-content">
        <div class="hero-badge cutout-header font-pop">
          <h2>100% COMPLETION</h2>
        </div>
        <h1 class="font-pop hero-title">REACH OUT TO THE TRUTH</h1>
        <p class="font-read hero-subtitle p4g-shadow-sm">
          The Definitive Day-by-Day Walkthrough
        </p>
      </div>
    </header>

    <!-- Main Layout -->
    <main class="main-layout">
		<slot />
	</main>

    <script is:inline>
      // ToC Accordion Logic
      document.querySelectorAll(".toc-parent").forEach((parent) => {
        parent.addEventListener("click", () => {
          const childList = parent.nextElementSibling;
          const icon = parent.querySelector(".toc-icon");
          if (childList) {
            childList.classList.toggle("active");
            icon.classList.toggle("open");
          }
        });
      });

      // Show More Logic for specific ToC categories
      function toggleShowMore(className, btn) {
        document
          .querySelectorAll("." + className)
          .forEach((el) => (el.style.display = "list-item"));
        btn.parentElement.style.display = "none";
      }

      // Make toggleShowMore available globally for inline onclick
      window.toggleShowMore = toggleShowMore;
    </script>
  </body>
</html>

<style is:global>
:root {
  --primary: #fce300; /* Midnight Channel Yellow */
  --secondary: #1a1a1a; /* Inaba Black */
  --bg-white: #fafafa; /* Static White */
  --accent-orange: #ff6b00; /* Junes Orange */
  --accent-blue: #0c1431; /* Velvet Blue */
}

/* Base Resets & Typography */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  background-color: var(--secondary); /* Base "Midnight Channel" black */
}

body {
  font-family: "Montserrat", sans-serif;
  background-color: transparent; /* Allow background layer to show through */
  color: var(--secondary);
  line-height: 1.6;
  overflow-x: hidden;
}

.midnight-bg {
  position: fixed;
  inset: 0;
  z-index: -10;
  background-color: transparent;
}

.midnight-bg::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: url("/background.jpeg");
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  opacity: 0.3; /* Increased for recognizability as requested */
}

.crt-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    rgba(18, 16, 16, 0) 50%,
    rgba(0, 0, 0, 0.05) 50%
  );
  background-size: 100% 4px;
  pointer-events: none;
  z-index: 1;
}

/* Subtle Digital Grain */
.midnight-bg::after {
  content: "";
  position: absolute;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  opacity: 0.03;
  pointer-events: none;
}

::selection {
  background: var(--primary);
  color: var(--secondary);
}

.font-pop {
  font-family: "Anton", sans-serif;
  text-transform: uppercase;
  font-style: italic;
  letter-spacing: 0.05em;
}

.font-read {
  font-family: "Montserrat", sans-serif;
}

/* Motifs & Textures */
.bg-halftone {
  background-color: var(--primary);
  background-image: radial-gradient(
    var(--secondary) 1px,
    transparent 1px
  );
  background-size: 12px 12px;
}

.bg-scanlines {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(255, 255, 255, 0),
    rgba(255, 255, 255, 0) 50%,
    rgba(0, 0, 0, 0.05) 50%,
    rgba(0, 0, 0, 0.05)
  );
  background-size: 100% 4px;
  pointer-events: none;
  z-index: 10;
  opacity: 0.7;
}

.bg-stripes {
  background: repeating-linear-gradient(
    -45deg,
    var(--primary),
    var(--primary) 10px,
    var(--secondary) 10px,
    var(--secondary) 20px
  );
}

/* Layout Utilities */
.container {
  max-w-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

.flex {
  display: flex;
}
.items-center {
  align-items: center;
}
.justify-between {
  justify-content: space-between;
}
.gap-2 {
  gap: 0.5rem;
}
.gap-4 {
  gap: 1rem;
}

/* Component Styles */
.p4g-shadow {
  box-shadow: 8px 8px 0px var(--secondary);
}

.p4g-shadow-sm {
  box-shadow: 4px 4px 0px var(--secondary);
}

.cutout-box {
  clip-path: polygon(0 0, 100% 2%, 98% 100%, 2% 98%);
}

.cutout-header {
  clip-path: polygon(0 0, 100% 0, 95% 100%, 0 90%);
}

.hover-invert {
  transition: all 0s;
  cursor: pointer;
}

.hover-invert:hover {
  background-color: var(--secondary) !important;
  color: var(--primary) !important;
  transform: rotate(-2deg);
}

/* Navigation */
nav {
  background-color: var(--secondary);
  color: var(--bg-white);
  border-bottom: 8px solid var(--primary);
  padding: 1rem 1.5rem;
  position: sticky;
  top: 0;
  z-index: 40;
}

.nav-logo span {
  color: var(--primary);
  font-size: 1.5rem;
  letter-spacing: 0.1em;
  text-shadow: 2px 2px 0 var(--accent-orange);
}

.nav-links {
  display: none;
  gap: 1.5rem;
  font-size: 1.25rem;
}

@media (min-width: 768px) {
  .nav-links {
    display: flex;
  }
}

.nav-links a {
  color: var(--bg-white);
  text-decoration: none;
  transition: transform 0.2s;
}

.nav-links a:hover {
  color: var(--primary);
  transform: translateY(-4px);
}

.search-btn {
  background-color: var(--primary);
  color: var(--secondary);
  border: 2px solid var(--primary);
  padding: 0.25rem 1rem;
  font-size: 1.125rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  text-decoration: none;
}

/* Sticky Tracker */
.tracker {
  position: fixed;
  top: 1rem;
  right: 1rem;
  z-index: 50;
  display: flex;
  align-items: flex-start;
  filter: drop-shadow(4px 4px 0px var(--secondary));
}

.tracker-date {
  background: var(--secondary);
  border: 4px solid var(--secondary);
  color: var(--bg-white);
  width: 4rem;
  height: 5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: rotate(-2deg);
}

.tracker-date .day {
  color: var(--primary);
  font-size: 0.875rem;
}
.tracker-date .date {
  font-size: 1.875rem;
  line-height: 1;
}

.tracker-weather {
  background: var(--bg-white);
  border: 4px solid var(--secondary);
  border-left: none;
  height: 5rem;
  width: 4rem;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-2deg);
  transform-origin: left;
}

/* Hero Section */
header.hero {
  position: relative;
  width: 100%;
  height: 40vh;
  min-height: 300px;
  background-color: rgba(252, 227, 0, 0.9) !important; /* Semi-transparent Yellow */
  backdrop-filter: blur(8px);
  border-bottom: 8px solid var(--secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.bg-halftone {
  background-image: radial-gradient(
    var(--secondary) 1px,
    transparent 1px
  );
  background-size: 12px 12px;
}

.hero-content {
  position: relative;
  z-index: 20;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-badge {
  background-color: var(--secondary);
  color: var(--bg-white);
  padding: 0.5rem 2rem;
  margin-bottom: 1rem;
  transform: rotate(-3deg);
  font-size: 1.25rem;
  letter-spacing: 0.1em;
}

.hero-title {
  font-size: 4rem;
  color: var(--primary);
  line-height: 1;
  text-shadow:
    4px 4px 0 var(--secondary),
    8px 8px 0 var(--accent-orange);
}

@media (min-width: 768px) {
  .hero-title {
    font-size: 6rem;
  }
}

.hero-subtitle {
  background: var(--bg-white);
  border: 4px solid var(--secondary);
  padding: 0.25rem 1rem;
  margin-top: 1.5rem;
  font-weight: bold;
  transform: rotate(1deg);
}

/* Divider */
.divider {
  height: 1rem;
  width: 100%;
  border-bottom: 4px solid var(--secondary);
}

/* Main Content Layout */
.main-layout {
  max-width: 1400px;
  margin: 0 auto;
  padding: 3rem 1.25rem;
  display: grid;
  grid-template-columns: 1fr;
  gap: 2.5rem;
}

@media (min-width: 1024px) {
  .main-layout {
    grid-template-columns: 300px 2fr 1fr;
  }
}

/* Left Sidebar ToC */
.left-sidebar {
  background: rgba(250, 250, 250, 0.9); /* Semi-translucent */
  backdrop-filter: blur(4px);
  border: 4px solid var(--secondary);
  padding: 1.5rem;
  align-self: start;
  position: sticky;
  top: 2rem;
  max-height: calc(100vh - 4rem);
  overflow-y: auto;
}

/* Custom Scrollbar for ToC */
.left-sidebar::-webkit-scrollbar {
  width: 8px;
}
.left-sidebar::-webkit-scrollbar-track {
  background: var(--bg-white);
  border-left: 2px solid var(--secondary);
}
.left-sidebar::-webkit-scrollbar-thumb {
  background: var(--primary);
  border: 2px solid var(--secondary);
}

.toc-list {
  list-style: none;
  padding: 0;
}
.toc-list > li {
  margin-bottom: 1rem;
}

.toc-parent {
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 3px solid var(--secondary);
  padding-bottom: 0.25rem;
  margin-bottom: 0.5rem;
  transition:
    color 0.2s,
    transform 0.2s;
}
.toc-parent:hover {
  color: var(--accent-orange);
  transform: translateX(4px);
}
.toc-parent .font-pop {
  font-size: 1.25rem;
}

.toc-icon {
  font-size: 0.8rem;
  transition: transform 0.3s;
}
.toc-icon.open {
  transform: rotate(180deg);
  color: var(--accent-orange);
}

.toc-child-list {
  list-style: none;
  padding-left: 0.75rem;
  display: none;
  border-left: 2px dashed var(--secondary);
  margin-left: 0.5rem;
}
.toc-child-list.active {
  display: block;
}

.toc-child-list li {
  margin-bottom: 0.25rem;
}
.toc-child-list li a {
  color: var(--secondary);
  text-decoration: none;
  font-size: 0.95rem;
  font-weight: 600;
  display: block;
  padding: 0.25rem 0.5rem;
  transition: all 0.2s;
}
.toc-child-list li a:hover {
  color: var(--primary);
  background: var(--secondary);
  padding-left: 1rem;
}

.show-more-btn a {
  color: var(--accent-orange) !important;
  font-style: italic;
}

/* Walkthrough Entries */
.month-header {
  display: flex;
  align-items: flex-end;
  border-bottom: 4px solid var(--secondary);
  margin-bottom: 1.5rem;
  padding-bottom: 0.5rem;
}

.month-header h2 {
  font-size: 3rem;
  color: var(--secondary);
  text-shadow: 2px 2px 0 var(--primary);
  line-height: 0.9;
}

.month-header span {
  color: var(--accent-orange);
  font-size: 1.5rem;
  margin-left: 1rem;
  margin-bottom: 0.25rem;
}

.daily-entry {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(4px);
  border: 4px solid var(--secondary);
  padding: 2rem 1.5rem;
  position: relative;
  margin-bottom: 3rem;
}

.entry-date-badge {
  position: absolute;
  top: -1rem;
  left: -1rem;
  background: var(--accent-blue);
  border: 4px solid var(--secondary);
  color: var(--bg-white);
  padding: 0.25rem 1rem;
  font-size: 1.25rem;
  transform: rotate(-3deg);
  box-shadow: 4px 4px 0 var(--primary);
}

.entry-content {
  margin-top: 1rem;
  font-size: 1.125rem;
}

.entry-content ul {
  padding-left: 1.5rem;
  margin: 1rem 0;
  font-weight: 600;
}

.callout-blue {
  margin-top: 2rem;
  background: var(--accent-blue);
  border: 4px solid var(--secondary);
  color: var(--bg-white);
  padding: 1rem;
  display: flex;
  gap: 1rem;
}

.callout-blue h4 {
  color: var(--primary);
  font-size: 1.25rem;
  margin-bottom: 0.25rem;
}
.callout-blue p {
  font-size: 0.875rem;
}

.callout-orange {
  background: var(--accent-orange);
  border: 4px solid var(--secondary);
  padding: 1.25rem;
  margin: 1.5rem 0;
  transform: rotate(1deg);
  color: var(--bg-white);
}

.callout-orange h3 {
  color: var(--secondary);
  font-size: 1.5rem;
}
.callout-orange .answer-box {
  background: var(--bg-white);
  border: 2px solid var(--secondary);
  color: var(--secondary);
  padding: 0.5rem;
  display: inline-block;
  margin: 0.5rem 0;
  font-size: 1.25rem;
}

/* Sidebar Widgets */
.widget {
  border: 4px solid var(--secondary);
  padding: 1.25rem;
  margin-bottom: 2rem;
}

.widget-yellow {
  background: var(--primary);
}
.widget-black {
  background: var(--secondary);
  color: var(--bg-white);
  position: relative;
  overflow: hidden;
}

.widget-title {
  font-size: 1.875rem;
  margin-bottom: 1rem;
  border-bottom: 4px solid currentColor;
  padding-bottom: 0.5rem;
}

.jump-btn {
  display: block;
  width: 100%;
  text-align: left;
  background: rgba(250, 250, 250, 0.85);
  backdrop-filter: blur(2px);
  border: 2px solid var(--secondary);
  padding: 0.5rem 1rem;
  margin-bottom: 0.75rem;
  font-size: 1.25rem;
  color: var(--secondary);
  text-decoration: none;
}

.jump-btn.active {
  background: var(--secondary);
  color: var(--primary);
}

.widget-black .corner-stripes {
  position: absolute;
  top: 0;
  right: 0;
  width: 4rem;
  height: 4rem;
  opacity: 0.5;
}
</style>
