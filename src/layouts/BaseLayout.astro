---
import '../styles/global.css';
import '../styles/header-icons.css';
import '../styles/objectives.css';
import '../styles/notes.css';
import '../styles/problems.css';
import '../styles/response.css';
import '../styles/formula.css';
import '../styles/field-mechanics.css';
import '../styles/social-link.css';
import '../styles/status-parameters.css';
import '../styles/status-ailments.css';
import '../styles/battle-mechanics.css';
import '../styles/shuffle-time.css';
import '../styles/tv-channels.css';
import '../styles/infographic.css';
import '../styles/velvet-room.css';
import '../styles/calendar.css';
import '../styles/controls.css';
import '../styles/trophy.css';
import '../styles/search.css';
import project from '../../project.config.json';
import SidebarNav from '../components/SidebarNav.astro';
import IconSheet from '../components/IconSheet.astro';
import SearchPalette from '../components/SearchPalette.astro';
import { Menu, X, PanelLeft, ArrowUp, Search } from '@lucide/astro';

interface Props {
  title?: string;
  description?: string;
  currentId?: string;
}

const {
  title = project.defaultTitle,
  description = project.defaultDescription,
  currentId = '',
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en" style={`--bg-image: url('${baseUrl}/background.webp')`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="icon" type="image/png" href={`${baseUrl}/favicon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@1,100..125,900&family=Chakra+Petch:wght@300;500;600&family=Dela+Gothic+One&family=Kanit:ital,wght@1,400;1,500;1,600;1,800&family=Jost:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" />
    <script is:inline>
      // Apply the saved sidebar state before first paint (no flash).
      (function () {
        var state = 'open';
        try { state = localStorage.getItem('sidebar-state') === 'collapsed' ? 'collapsed' : 'open'; } catch (e) {}
        document.documentElement.setAttribute('data-sidebar', state);
      })();
    </script>
  </head>
  <body>
    <IconSheet />
    <!-- Mobile: header with drawer button (below 1024px) -->
    <header class="mobile-header">
      <button type="button" id="open-mobile-drawer" aria-label="Open navigation" aria-controls="mobile-drawer-panel" class="icon-btn"><Menu size={18} aria-hidden="true" /> Menu</button>
      <a href={`${baseUrl}/`} aria-label={`${project.game} home`}><img class="logo logo-sm" src={`${baseUrl}/logo.webp`} alt={project.game} /></a>
      <button type="button" class="icon-btn qs-mobile-btn" data-qs-open aria-label="Search pages" aria-haspopup="dialog"><Search size={18} aria-hidden="true" /></button>
    </header>

    <div id="mobile-drawer-backdrop" class="drawer-backdrop" aria-hidden="true"></div>
    <div id="mobile-drawer-panel" class="drawer" role="dialog" aria-modal="true" aria-label="Navigation">
      <div class="drawer-head nav-site-title">
        <a href={`${baseUrl}/`} aria-label={`${project.game} home`}><img class="logo" src={`${baseUrl}/logo.webp`} alt={project.game} /><span class="nav-banner">Guide by Hurricanehaon</span></a>
        <button type="button" id="close-mobile-drawer" aria-label="Close navigation" class="icon-btn"><X size={18} aria-hidden="true" /></button>
      </div>
      <div id="tab-content-chapters" class="drawer-panel">
        <SidebarNav currentId={currentId} listId="mobile-sidebar-list" />
      </div>
    </div>

    <div class="shell">
      <!-- Desktop: left sidebar -->
      <aside id="desktop-sidebar" class="sidebar">
        <a class="nav-site-title" href={`${baseUrl}/`} aria-label={`${project.game} home`}><img class="logo" src={`${baseUrl}/logo.webp`} alt={project.game} /><span class="nav-banner">Guide by Hurricanehaon</span></a>
        <button type="button" class="qs-trigger" data-qs-open aria-haspopup="dialog" aria-keyshortcuts="Control+K /"><Search size={17} aria-hidden="true" /><span>Search pages</span><kbd data-qs-shortcut>Ctrl K</kbd></button>
        <SidebarNav currentId={currentId} />
      </aside>
      <button type="button" id="sidebar-toggle" class="sidebar-toggle" aria-controls="desktop-sidebar" aria-label="Hide or show sidebar"><PanelLeft size={20} aria-hidden="true" /></button>

      <div class="content-col">
        <main class="content">
          <slot />
        </main>
        <slot name="aside" />
      </div>
    </div>

    <button type="button" id="back-to-top" class="back-to-top" aria-label="Back to top" hidden><ArrowUp size={20} aria-hidden="true" /></button>

    <SearchPalette />

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var topBtn = document.getElementById('back-to-top');
        if (topBtn) {
          var syncTop = function () { topBtn.hidden = window.scrollY < window.innerHeight; };
          window.addEventListener('scroll', syncTop, { passive: true });
          topBtn.addEventListener('click', function () { window.scrollTo({ top: 0 }); });
          syncTop();
        }
        var body = document.body;
        // Mobile header: hide while scrolling down, show again on any scroll up or near the top.
        var header = document.querySelector('.mobile-header');
        if (header) {
          var lastY = window.scrollY;
          window.addEventListener('scroll', function () {
            var y = window.scrollY, dy = y - lastY;
            if (y < 80 || dy < -4) header.removeAttribute('data-hidden');
            else if (dy > 4 && !body.hasAttribute('data-drawer')) header.setAttribute('data-hidden', '');
            if (Math.abs(dy) > 4) lastY = y;
          }, { passive: true });
        }
        var toggle = document.getElementById('sidebar-toggle');
        if (toggle) {
          toggle.addEventListener('click', function () {
            var next = root.getAttribute('data-sidebar') === 'collapsed' ? 'open' : 'collapsed';
            root.setAttribute('data-sidebar-anim', '');
            root.setAttribute('data-sidebar', next);
            try { localStorage.setItem('sidebar-state', next); } catch (e) {}
          });
        }

        function setDrawer(open) {
          if (open) body.setAttribute('data-drawer', 'open'); else body.removeAttribute('data-drawer');
        }
        var openBtn = document.getElementById('open-mobile-drawer');
        var closeBtn = document.getElementById('close-mobile-drawer');
        var backdrop = document.getElementById('mobile-drawer-backdrop');
        if (openBtn) openBtn.addEventListener('click', function () { setDrawer(true); });
        if (closeBtn) closeBtn.addEventListener('click', function () { setDrawer(false); });
        if (backdrop) backdrop.addEventListener('click', function () { setDrawer(false); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setDrawer(false); });

        var panel = document.getElementById('mobile-drawer-panel');
        if (panel) {
          // Tapping a jump link or a section link closes the drawer.
          panel.addEventListener('click', function (e) {
            var a = e.target.closest && e.target.closest('a');
            if (a && a.closest('.drawer-panel')) setDrawer(false);
          });
        }

      })();
    </script>

    <script is:inline>
      // Walkthrough progress (April to March pages only): per-month "read" marks, plus the last month and
      // in-game date you were reading. Kept in this browser only.
      (function () {
        var KEY = 'p4g-progress-v2';
        var MONTH_RE = /^walkthrough-(april|may|june|july|august|september|october|november|december|january|february|march)$/;
        var state = { done: {}, last: null };
        try {
          var raw = JSON.parse(localStorage.getItem(KEY) || 'null');
          if (raw && raw.done) state = { done: raw.done, last: raw.last && MONTH_RE.test(raw.last.page || '') ? raw.last : null };
          else {
            var old = JSON.parse(localStorage.getItem('p4g-progress-v1') || '{}');
            if (old && old.done) Object.keys(old.done).forEach(function (k) { if (MONTH_RE.test(k)) state.done[k] = 1; });
          }
        } catch (e) {}
        function save() { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {} }

        var current = document.querySelector('.sidebar a[aria-current="page"]');
        var pageId = current ? current.getAttribute('data-page-id') : '';
        var onMonth = MONTH_RE.test(pageId);

        function trackDate() {
          var marks = document.querySelectorAll('.guide-body h4.date-board[id]');
          var line = window.innerHeight * 0.3, hit = null;
          for (var i = 0; i < marks.length; i++) { if (marks[i].getBoundingClientRect().top <= line) hit = marks[i]; else break; }
          var date = hit ? hit.id : '';
          var label = hit ? (hit.querySelector('.db-sr') || hit).textContent.trim() : '';
          if (!state.last || state.last.page !== pageId || state.last.date !== date) {
            state.last = { page: pageId, date: date, label: label };
            save();
          }
        }
        if (onMonth) {
          var ticking = false;
          window.addEventListener('scroll', function () {
            if (ticking) return;
            ticking = true;
            setTimeout(function () { ticking = false; trackDate(); }, 120);
          }, { passive: true });
          window.addEventListener('load', function () { setTimeout(trackDate, 50); });
        }

        function paint() {
          document.querySelectorAll('a[data-page-id]').forEach(function (a) {
            var id = a.getAttribute('data-page-id');
            a.toggleAttribute('data-done', MONTH_RE.test(id) && !!state.done[id]);
          });
          document.querySelectorAll('[data-progress-resume]').forEach(function (a) {
            var target = state.last && document.querySelector('a[data-page-id="' + state.last.page + '"]');
            if (target) {
              a.href = target.href + (state.last.date ? '#' + state.last.date : '');
              a.hidden = false;
              var text = target.textContent.trim();
              if (state.last.label) text += ' · ' + state.last.label;
              var slot = a.querySelector('[data-resume-title]');
              if (slot) slot.textContent = text; else a.textContent = 'Continue reading: ' + text;
            } else { a.hidden = true; }
          });
          document.querySelectorAll('[data-mark-read]').forEach(function (b) {
            var on = !!state.done[b.getAttribute('data-mark-read')];
            b.setAttribute('aria-pressed', String(on));
            b.textContent = on ? 'Read' : 'Mark as read';
          });
        }
        document.querySelectorAll('[data-mark-read]').forEach(function (b) {
          b.addEventListener('click', function () {
            var id = b.getAttribute('data-mark-read');
            if (state.done[id]) delete state.done[id]; else state.done[id] = 1;
            save(); paint();
          });
        });
        paint();
      })();
    </script>
  </body>
</html>
