---
import GuideLayout from "../../layouts/GuideLayout.astro";
---

<GuideLayout title="Update & Schedule | Persona 4 Golden Guide">
  <header class="schedule-header anim-pop">
    <div class="header-accent bg-stripes"></div>
    <h1 class="font-pop">UPDATE & <span class="highlight">SCHEDULE</span></h1>
  </header>

  <section class="message-card p4g-shadow anim-slide-in">
    <div class="card-halftone bg-p4g-flow"></div>

    <div class="message-content font-read">
      <p class="intro-text">
        Thank you everyone for your support for this guide! I am currently
        working on this guide on and off until it eventually is completed.
      </p>

      <div class="contact-callout cutout-box p4g-shadow-sm">
        <h2 class="font-pop">Found a Bug?</h2>
        <p>
          If you spot any formatting errors or typos, or if you have any
          questions about this guide feel free to send me a message on GameFAQs
          or an email at:
        </p>
        <a href="mailto:Hurricanehaon@gmail.com" class="email-link font-pop"
          >Hurricanehaon@gmail.com</a
        >
      </div>

      <p class="outro-text">Thank you very much for all your support!</p>
    </div>

    <div class="card-decoration"></div>
  </section>

  <div class="tv-noise-decoration anim-pop stagger-2">
    <div class="noise-box p4g-shadow-sm"></div>
    <div class="noise-box p4g-shadow-sm"></div>
    <div class="noise-box p4g-shadow-sm"></div>
  </div>
</GuideLayout>

<style>
  .schedule-header {
    width: 100%;
    background: var(--secondary);
    color: var(--primary);
    padding: 2rem;
    position: relative;
    border: 6px solid var(--primary);
    margin-bottom: 3rem;
    overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 95% 100%, 5% 100%);

    @media (max-width: 768px) {
      padding: 1.5rem 1rem;
      border-width: 4px;
      margin-bottom: 2rem;
      clip-path: polygon(0 0, 100% 0, 98% 100%, 2% 100%);
    }

    .header-accent {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 10px;
    }

    h1 {
      font-size: clamp(2rem, 8vw, 4rem);
      text-align: center;
      margin: 0;
      text-shadow: 4px 4px 0 var(--accent-orange);

      @media (max-width: 768px) {
        font-size: 2.25rem;
        text-shadow: 3px 3px 0 var(--accent-orange);
      }

      .highlight {
        color: var(--secondary);
        background: var(--primary);
        padding: 0 0.5rem;
      }
    }
  }

  .message-card {
    background: var(--bg-white);
    border: 6px solid var(--secondary);
    padding: 3rem 2rem;
    position: relative;
    overflow: hidden;
    min-height: 400px;

    @media (max-width: 768px) {
      padding: 2rem 1.25rem;
      border-width: 4px;
      min-height: auto;
    }

    .card-halftone {
      position: absolute;
      top: 0;
      right: 0;
      width: 150px;
      height: 150px;
      opacity: 0.1;
      z-index: 1;
      pointer-events: none;
    }

    .message-content {
      position: relative;
      z-index: 2;

      .intro-text {
        font-size: 1.5rem;
        line-height: 1.4;
        font-weight: 700;
        color: var(--secondary);
        margin-bottom: 3rem;
        border-left: 8px solid var(--primary);
        padding-left: 1.5rem;

        @media (max-width: 768px) {
          font-size: 1.1rem;
          padding-left: 1rem;
          border-left-width: 6px;
          margin-bottom: 2rem;
        }
      }

      .contact-callout {
        background: var(--accent-blue);
        color: white;
        padding: 2.5rem 2rem;
        margin: 2.5rem 0;
        transform: rotate(1deg);
        border: 4px solid var(--secondary);

        @media (max-width: 768px) {
          padding: 1.5rem 1.25rem;
          margin: 2rem 0;
          border-width: 3px;
        }

        h2 {
          color: var(--primary);
          font-size: 2.5rem;
          margin-bottom: 1rem;
          letter-spacing: 0.1em;

          @media (max-width: 768px) {
            font-size: 1.75rem;
            letter-spacing: 0.05em;
          }
        }

        p {
          font-size: 1.125rem;
          margin-bottom: 1.5rem;
          font-weight: 600;

          @media (max-width: 768px) {
            font-size: 1rem;
          }
        }

        .email-link {
          display: inline-block;
          background: var(--primary);
          color: var(--secondary);
          padding: 0.8rem 1.5rem;
          font-size: 1.5rem;
          text-decoration: none;
          transition: all 0.2s;
          border: 3px solid var(--secondary);
          box-shadow: 6px 6px 0 var(--secondary);

          @media (max-width: 768px) {
            font-size: 1rem;
            padding: 0.6rem 1rem;
            box-shadow: 4px 4px 0 var(--secondary);
            word-break: break-all;
          }

          &:hover {
            background: var(--accent-orange);
            color: white;
            transform: translate(-4px, -4px);
            box-shadow: 10px 10px 0 var(--secondary);
          }
        }
      }

      .outro-text {
        font-size: 1.25rem;
        font-weight: 800;
        text-transform: uppercase;
        color: var(--accent-orange);
        text-align: right;
        margin-top: 3rem;
        font-style: italic;

        @media (max-width: 768px) {
          font-size: 1.1rem;
          margin-top: 2rem;
        }
      }
    }

    .card-decoration {
      position: absolute;
      bottom: -10px;
      right: -10px;
      width: 50px;
      height: 50px;
      background: var(--primary);
      transform: rotate(45deg);
      border: 4px solid var(--secondary);
    }
  }

  .tv-noise-decoration {
    display: flex;
    gap: 1rem;
    margin-top: 3rem;
    justify-content: center;

    @media (max-width: 768px) {
      margin-top: 2rem;
    }

    .noise-box {
      width: 60px;
      height: 40px;
      background: var(--secondary);
      background-image: repeating-linear-gradient(
        0deg,
        rgba(255, 255, 255, 0.05) 0px,
        rgba(255, 255, 255, 0.05) 1px,
        transparent 1px,
        transparent 2px
      );
      border: 3px solid var(--primary);
      transform: rotate(var(--rot, 0deg));

      @media (max-width: 768px) {
        width: 45px;
        height: 30px;
      }

      &:nth-child(2) {
        --rot: -5deg;
        background-color: var(--accent-orange);
      }
      &:nth-child(3) {
        --rot: 3deg;
        background-color: var(--accent-blue);
      }
    }
  }
</style>
