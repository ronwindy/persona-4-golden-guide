---
import GuideLayout from "../../layouts/GuideLayout.astro";
---

<GuideLayout title="Update & Schedule | Persona 4 Golden Guide">
  <header class="schedule-header anim-pop">
    <h1 class="font-pop title-stack">
      <span class="word part-update">UPDATE</span>
      <span class="symbol">&</span>
      <span class="word part-schedule">SCHEDULE</span>
    </h1>
    <p class="description font-read">
      Thank you everyone for your support for this guide! I am currently
      working on this guide on and off until it eventually is completed.
    </p>
  </header>

  <section class="message-card p4g-shadow anim-slide-in">
    <div class="card-halftone bg-p4g-flow"></div>

    <div class="message-content font-read">


      <div class="contact-callout cutout-box p4g-shadow-sm">
        <h2 class="font-pop">Found a Bug?</h2>
        <p>
          If you spot any formatting errors or typos, or if you have any
          questions about this guide feel free to send me a message on GameFAQs
          or an email at:
        </p>
        <a href="mailto:Hurricanehaon@gmail.com" class="email-link font-pop"
          >Hurricanehaon@gmail.com</a
        >
      </div>

      <p class="outro-text">Thank you very much for all your support!</p>
    </div>

    <div class="card-decoration"></div>
  </section>

  <div class="tv-noise-decoration anim-pop stagger-2">
    <div class="noise-box p4g-shadow-sm"></div>
    <div class="noise-box p4g-shadow-sm"></div>
    <div class="noise-box p4g-shadow-sm"></div>
  </div>
</GuideLayout>

<style>
  .schedule-header {
    width: 100%;
    margin-bottom: 3rem;
    padding: 3rem 2rem;
    background:
      linear-gradient(rgba(255, 221, 0, 0.2) 0%, rgba(255, 221, 0, 0.95) 100%),
      url("/p4-key-art-2.png");
    background-size: cover;
    background-position: center 20%;
    background-attachment: scroll;
    border: 6px solid var(--secondary);
    position: relative;
    overflow: hidden;
    box-shadow: 10px 10px 0 var(--secondary);
    transition: transform 0.3s ease;

    &:hover {
      transform: translate(-4px, -4px);
      box-shadow: 14px 14px 0 var(--secondary);
    }

    &::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: repeating-linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.03) 0px,
        rgba(0, 0, 0, 0.03) 1px,
        transparent 1px,
        transparent 2px
      );
      pointer-events: none;
      z-index: 1;
    }

    .title-stack {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      position: relative;
      z-index: 2;

      @media (min-width: 640px) {
        flex-direction: row;
        justify-content: center;
        gap: 1.5rem;
      }

      .word {
        padding: 0.5rem 1.5rem;
        font-size: clamp(2.5rem, 8vw, 4.5rem);
        line-height: 1;
        box-shadow: 8px 8px 0 var(--secondary);
        transition: all 0.2s;
        display: inline-block;

        &:hover {
          transform: scale(1.05) rotate(0deg) !important;
          box-shadow: 12px 12px 0 var(--secondary);
        }
      }

      .part-update {
        background: var(--bg-white);
        color: var(--secondary);
        transform: rotate(-3deg);
        border: 4px solid var(--secondary);
      }

      .part-schedule {
        background: var(--secondary);
        color: var(--primary);
        transform: rotate(2deg);
        border: 4px solid var(--primary);
        box-shadow: 8px 8px 0 var(--accent-orange);
      }

      .symbol {
        font-size: clamp(2rem, 6vw, 3.5rem);
        color: var(--accent-orange);
        text-shadow: 3px 3px 0 var(--secondary);
        transform: rotate(10deg);
        font-weight: 900;
        display: inline-block;
      }
    }

    .description {
      position: relative;
      z-index: 2;
      margin-top: 2.5rem;
      font-size: 1.1rem;
      font-weight: 700;
      background: rgba(255, 255, 255, 0.2);
      backdrop-filter: blur(10px);
      padding: 1.5rem;
      border-left: 8px solid var(--secondary);
      border-right: 2px solid rgba(255, 255, 255, 0.3);
      border-top: 2px solid rgba(255, 255, 255, 0.3);
      border-bottom: 2px solid rgba(255, 255, 255, 0.3);
      box-shadow: 8px 8px 0 rgba(0, 0, 0, 0.1);
      color: var(--secondary);
      line-height: 1.6;
    }
  }

  .message-card {
    background: var(--bg-white);
    border: 6px solid var(--secondary);
    padding: 3rem 2rem;
    position: relative;
    overflow: hidden;
    min-height: 200px;

    @media (max-width: 768px) {
      padding: 2rem 1.25rem;
      border-width: 4px;
      min-height: auto;
    }

    .card-halftone {
      position: absolute;
      top: 0;
      right: 0;
      width: 150px;
      height: 150px;
      opacity: 0.1;
      z-index: 1;
      pointer-events: none;
    }

    .message-content {
      position: relative;
      z-index: 2;



      .contact-callout {
        background: var(--accent-blue);
        color: white;
        padding: 2.5rem 2rem;
        margin: 2.5rem 0;
        transform: rotate(1deg);
        border: 4px solid var(--secondary);

        @media (max-width: 768px) {
          padding: 1.5rem 1.25rem;
          margin: 2rem 0;
          border-width: 3px;
        }

        h2 {
          color: var(--primary);
          font-size: 2.5rem;
          margin-bottom: 1rem;
          letter-spacing: 0.1em;

          @media (max-width: 768px) {
            font-size: 1.75rem;
            letter-spacing: 0.05em;
          }
        }

        p {
          font-size: 1.125rem;
          margin-bottom: 1.5rem;
          font-weight: 600;

          @media (max-width: 768px) {
            font-size: 1rem;
          }
        }

        .email-link {
          display: inline-block;
          background: var(--primary);
          color: var(--secondary);
          padding: 0.8rem 1.5rem;
          font-size: 1.5rem;
          text-decoration: none;
          transition: all 0.2s;
          border: 3px solid var(--secondary);
          box-shadow: 6px 6px 0 var(--secondary);

          @media (max-width: 768px) {
            font-size: 1rem;
            padding: 0.6rem 1rem;
            box-shadow: 4px 4px 0 var(--secondary);
            word-break: break-all;
          }

          &:hover {
            background: var(--accent-orange);
            color: white;
            transform: translate(-4px, -4px);
            box-shadow: 10px 10px 0 var(--secondary);
          }
        }
      }

      .outro-text {
        font-size: 1.25rem;
        font-weight: 800;
        text-transform: uppercase;
        color: var(--accent-orange);
        text-align: right;
        margin-top: 3rem;
        font-style: italic;

        @media (max-width: 768px) {
          font-size: 1.1rem;
          margin-top: 2rem;
        }
      }
    }

    .card-decoration {
      position: absolute;
      bottom: -10px;
      right: -10px;
      width: 50px;
      height: 50px;
      background: var(--primary);
      transform: rotate(45deg);
      border: 4px solid var(--secondary);
    }
  }

  .tv-noise-decoration {
    display: flex;
    gap: 1rem;
    margin-top: 3rem;
    justify-content: center;

    @media (max-width: 768px) {
      margin-top: 2rem;
    }

    .noise-box {
      width: 60px;
      height: 40px;
      background: var(--secondary);
      background-image: repeating-linear-gradient(
        0deg,
        rgba(255, 255, 255, 0.05) 0px,
        rgba(255, 255, 255, 0.05) 1px,
        transparent 1px,
        transparent 2px
      );
      border: 3px solid var(--primary);
      transform: rotate(var(--rot, 0deg));

      @media (max-width: 768px) {
        width: 45px;
        height: 30px;
      }

      &:nth-child(2) {
        --rot: -5deg;
        background-color: var(--accent-orange);
      }
      &:nth-child(3) {
        --rot: 3deg;
        background-color: var(--accent-blue);
      }
    }
  }
</style>
