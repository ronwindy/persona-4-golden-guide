---
import BaseLayout from '../../layouts/BaseLayout.astro';
import project from '../../../project.config.json';
import PageToc from '../../components/PageToc.astro';
import { getPages, getPageHtml, getPageToc, getNeighbours } from '../../lib/guideData';

export function getStaticPaths() {
  return getPages().map((page) => ({ params: { id: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { prev, next } = getNeighbours(page.id);
// Part headings carry their own text as data-word (ghost word in CSS) plus a size bucket data-wl.
const withParts = getPageHtml(page.id).replace(
  /<h5 class="part-marker"([^>]*)>([\s\S]*?)<\/h5>/g,
  (_m, attrs: string, inner: string) => {
    const word = inner.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();
    const len = word.length;
    const wl = len <= 10 ? 1 : len <= 16 ? 2 : len <= 22 ? 3 : 4;
    const safe = word.replace(/&(?!(?:[a-z]+|#\d+);)/gi, '&amp;').replace(/"/g, '&quot;');
    return `<h5 class="part-marker"${attrs} data-word="${safe}" data-wl="${wl}">${inner}</h5>`;
  },
);
// Day dividers that are real dates ("April 19th") become a departure board: letter/digit tiles.
// Other date-marker headings (names, "Monthly Progress") keep the plain style.
const tiles = (s: string) => [...s].map((c) => `<span class="db-tile">${c}</span>`).join('');
const html = withParts.replace(
  /<h4 class="date-marker"([^>]*)>([A-Za-z]+) (\d+)([a-z]{2})?<\/h4>/g,
  (_m, attrs: string, month: string, day: string, ord: string | undefined) => {
    const text = `${month} ${day}${ord ?? ''}`;
    return (
      `<h4 class="date-marker date-board"${attrs}>` +
      `<span class="db-sr">${text}</span>` +
      `<span class="db-group" aria-hidden="true"><span class="db-label">MONTH</span><span class="db-tiles">${tiles(month.toUpperCase())}</span></span>` +
      `<span class="db-sep" aria-hidden="true"></span>` +
      `<span class="db-group" aria-hidden="true"><span class="db-label">DAY</span><span class="db-tiles">${tiles(day + (ord ?? '').toUpperCase())}</span></span>` +
      `</h4>`
    );
  },
);
const toc = getPageToc(page.id);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (id: string) => `${baseUrl}/guide/${id}`;
---

<BaseLayout
  title={`${page.title} - ${project.pageTitleSuffix}`}
  description={`${project.pageDescriptionPrefix} - ${page.category}: ${page.title}`}
  currentId={page.id}
>
  <article>
    <p class="breadcrumb">
      <a href={`${baseUrl}/`}>Contents</a> / {page.category}
    </p>
    <div class="guide-body" set:html={html} />

    <nav class="page-nav" aria-label="Previous and next">
      {prev ? <a href={href(prev.id)} class="nav-prev"><span aria-hidden="true">&larr;</span><span>{prev.title}</span></a> : <span></span>}
      <button type="button" class="mark-read" data-mark-read={page.id} aria-pressed="false">Mark as read</button>
      {next ? <a href={href(next.id)} class="nav-next"><span>{next.title}</span><span aria-hidden="true">&rarr;</span></a> : <span></span>}
    </nav>
  </article>
  <PageToc slot="aside" entries={toc} />
</BaseLayout>
