---
import Layout from "../../layouts/Layout.astro";
import SidebarToC from "../../components/SidebarToC.astro";

const heroBg = "/persona-4-golden-guide/p4g-key-art-1.png";

const categories = [
  {
    title: "VISUALS & PRESENTATION",
    icon: "📺",
    items: [
      {
        name: "New Animated Scenes",
        desc: "Multiple high-quality animated cutscenes added to key story moments.",
      },
      {
        name: "Updated Graphics",
        desc: "Higher resolution textures and improved lighting across all environments.",
      },
      {
        name: "New Songs",
        desc: "Brand new tracks including 'Shadow World' and 'Time To Make History'.",
      },
      {
        name: "Fast Forward & Logs",
        desc: "Can now fast forward cutscenes and view dialogue logs at any time.",
      },
      {
        name: "Costumes & Models",
        desc: "Added customizable outfits for battle and collectible figurines/models.",
      },
    ],
  },
  {
    title: "STORY & EXPANSIONS",
    icon: "📖",
    items: [
      {
        name: "Marie (The Aeon)",
        desc: "A brand new central character with her own Social Link and importance to the true ending.",
      },
      {
        name: "New Social Links",
        desc: "The Jester (Adachi) and Aeon (Marie) links add significant depth to the plot.",
      },
      {
        name: "The Golden Months",
        desc: "January and February are now playable, extending the school year.",
      },
      {
        name: "New Endings",
        desc: "Two additional major endings and a refined epilogue for the True Ending.",
      },
      {
        name: "New Locations",
        desc: "Explore Okina City and Shichiri Beach for unique activities and dates.",
      },
    ],
  },
  {
    title: "GAMEPLAY MECHANICS",
    icon: "🎮",
    items: [
      {
        name: "Night Exploration",
        desc: "The protagonist can now leave the house at night to visit the shrine, pub, or work.",
      },
      {
        name: "Gardening & Harvesting",
        desc: "Grow useful recovery items on the rooftop with Nanako.",
      },
      {
        name: "Bugs & Fishing",
        desc: "Catch bugs for bait and enjoy a completely remade fishing mini-game.",
      },
      {
        name: "Scooters",
        desc: "Obtain a license to travel to distant areas and use bikes in combat for support.",
      },
      {
        name: "Cinema & Dates",
        desc: "Visit the movies in Okina City with friends to level up their Personas.",
      },
    ],
  },
  {
    title: "COMBAT & PERSONAS",
    icon: "⚔️",
    items: [
      {
        name: "3rd Tier Evolutions",
        desc: "Party members can evolve their Personas a second time for ultimate skills.",
      },
      {
        name: "Combination Moves",
        desc: "New dual-attacks that trigger after an All-Out Attack for massive damage.",
      },
      {
        name: "Search Fusion",
        desc: "A powerful search tool to find specific Persona results based on your current stock.",
      },
      {
        name: "Skill Cards",
        desc: "Obtain and duplicate cards to teach any Persona specific abilities manually.",
      },
      {
        name: "Rise's Support",
        desc: "Rise is significantly buffed with combat shields, HP/SP recovery, and buffs.",
      },
    ],
  },
  {
    title: "QUALITY OF LIFE",
    icon: "📡",
    items: [
      {
        name: "Difficulty Choice",
        desc: "Two new difficulty levels and the ability to customize EXP/Money gain in NG+.",
      },
      {
        name: "Online Vox Populi",
        desc: "See what other players did today or request help in dungeons (Rescue Request).",
      },
      {
        name: "Quest Markers",
        desc: "NPCs with active quests are now clearly marked on the map.",
      },
      {
        name: "Saving Grace",
        desc: "Added save points between long story events and cutscene stretches.",
      },
      {
        name: "Skill Selection",
        desc: "Manually choose which skills to inherit during fusion—no more RNG rerolling!",
      },
    ],
  },
];
---

<Layout title="Persona 4 vs. Golden | Comparison Guide">
  <SidebarToC />

  <div class="vs-page-wrapper">
    <!-- Hero Header -->
    <header
      class="hero-broadcast p4g-shadow"
      style={`--bg-image: url(${heroBg})`}
    >
      <div class="header-overlay"></div>
      <div class="hero-content">
        <div class="hero-labels anim-pop">
          <span class="label-box p4-orig">ORIGINAL P4</span>
          <span class="vs-badge">VS</span>
          <span class="label-box p4-golden">P4 GOLDEN</span>
        </div>
        <h1 class="font-pop main-title">EVOLUTION OF THE TRUTH</h1>
        <p class="font-read subtitle">
          Breaking down every refinement, addition, and secret in the definitive
          version.
        </p>
      </div>
    </header>

    <!-- Main Content Section -->
    <main class="data-grid">
      <div class="grid-intro bg-stripes p4g-shadow-sm">
        <span class="font-pop">● STATUS: ANALYZING DIFFERENCES</span>
      </div>

      <div class="categories-container">
        {
          categories.map((cat, idx) => (
            <section class={`category-section stagger-${(idx % 4) + 1}`}>
              <div class="category-header font-pop">
                <span class="cat-icon">{cat.icon}</span>
                <h2>{cat.title}</h2>
              </div>

              <ul class="diff-list font-read">
                {cat.items.map((item) => (
                  <li class="diff-item">
                    <div class="item-marker" />
                    <div class="item-content">
                      <strong class="item-name">{item.name}</strong>
                      <p class="item-desc">{item.desc}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <!-- Comparison Footer -->
      <footer class="vs-footer">
        <div class="conclusion p4g-shadow">
          <h3 class="font-pop">THE VERDICT</h3>
          <p class="font-read">
            Persona 4 Golden isn't just a remaster; it's a complete mechanical
            overhaul. From the manual skill inheritance to the entire extra
            semester, it is the definitive way to reach out to the truth.
          </p>
        </div>
        <div class="broadcast-tag bg-stripes anim-jitter">
          <span class="font-pop">END OF DATA LOG — STAY TUNED</span>
        </div>
      </footer>
    </main>
  </div>
</Layout>

<style>
  .vs-page-wrapper {
    width: 100%;
    position: relative;
    padding-bottom: 5rem;
  }

  /* Override Layout.astro's 3-column grid to give content more room */
  :global(.main-layout) {
    display: grid !important;
    max-width: 100vw;
    overflow-x: hidden;
    gap: 1.5rem !important;
  }

  @media (min-width: 1024px) {
    :global(.main-layout) {
      grid-template-columns: 360px 1fr !important;
      max-width: 1600px !important;
      gap: 2.5rem !important;
      padding: 3rem 2rem !important;
    }
  }

  /* Hero Section */
  .hero-broadcast {
    position: relative;
    background: var(--secondary);
    background-image: var(--bg-image);
    background-size: cover;
    background-position: center;
    min-height: 500px;
    display: flex;
    flex-direction: column;
    padding: 2rem;
    margin-bottom: 4rem;
    border: 8px solid var(--secondary);
    overflow: hidden;
  }

  .header-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(26, 26, 26, 0.5),
      rgba(26, 26, 26, 0.8)
    );
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 5;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center; /* Center for purely typographic hero */
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .hero-labels {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    justify-content: center;
  }

  .label-box {
    padding: 0.5rem 1.5rem;
    font-family: "Staatliches", sans-serif;
    font-size: 1.5rem;
    border: 4px solid var(--secondary);
    transform: skewX(-10deg);
    box-shadow: 6px 6px 0 var(--secondary);
  }

  .p4-orig {
    background: #333;
    color: #999;
  }
  .p4-golden {
    background: var(--primary);
    color: var(--secondary);
    font-weight: 900;
  }

  .vs-badge {
    background: var(--accent-orange);
    color: white;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    border-radius: 50%;
    border: 3px solid var(--secondary);
    box-shadow: 6px 6px 0 var(--secondary);
  }

  .main-title {
    font-size: clamp(3rem, 8vw, 6rem);
    color: var(--primary);
    line-height: 0.85;
    margin-bottom: 1rem;
    text-shadow:
      4px 4px 0 var(--secondary),
      8px 8px 0 var(--accent-orange);
  }

  .subtitle {
    font-size: 1.5rem;
    color: white;
    max-width: 600px;
    font-weight: 600;
  }

  @media (min-width: 1024px) {
    .hero-broadcast {
      padding: 6rem 4rem;
    }
  }

  /* Data Grid */
  .data-grid {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .grid-intro {
    background: var(--accent-orange);
    color: white;
    padding: 1rem 2rem;
    width: fit-content;
    border: 4px solid var(--secondary);
    font-size: 1.25rem;
    font-weight: 900;
    margin-left: 2rem;
    transform: rotate(-2deg);
  }

  .categories-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding: 0;
  }

  @media (min-width: 1200px) {
    .categories-container {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .category-section {
    background: rgba(255, 255, 255, 0.95);
    border: 6px solid var(--secondary);
    box-shadow: 12px 12px 0 var(--secondary);
    padding: 2.5rem;
    transition: transform 0.3s;
    position: relative;
    overflow: hidden;
  }

  .category-section:hover {
    transform: translateY(-5px) scale(1.02);
  }

  .category-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    border-bottom: 6px solid var(--primary);
    padding-bottom: 1rem;
    font-size: 2rem;
  }

  .cat-icon {
    font-size: 2.5rem;
    filter: drop-shadow(2px 2px 0 var(--secondary));
  }

  .category-header h2 {
    color: var(--secondary);
    line-height: 1;
  }

  .diff-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .diff-item {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .item-marker {
    width: 12px;
    height: 12px;
    background: var(--primary);
    border: 3px solid var(--secondary);
    margin-top: 0.5rem;
    flex-shrink: 0;
    transform: rotate(45deg);
  }

  .item-name {
    display: block;
    font-size: 1.25rem;
    color: var(--secondary);
    margin-bottom: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .item-desc {
    color: #444;
    font-size: 1.1rem;
    line-height: 1.4;
  }

  /* Footer Section */
  .vs-footer {
    margin-top: 5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    padding: 0 1rem;
  }

  .conclusion {
    background: var(--secondary);
    border: 8px solid var(--primary);
    color: white;
    padding: 3rem;
    max-width: 800px;
    text-align: center;
    clip-path: polygon(0 5%, 100% 0, 95% 100%, 2% 95%);
  }

  .conclusion h3 {
    font-size: 3rem;
    color: var(--primary);
    margin-bottom: 1rem;
  }

  .conclusion p {
    font-size: 1.25rem;
    font-style: italic;
    opacity: 0.9;
  }

  .broadcast-tag {
    background: var(--secondary);
    color: var(--primary);
    padding: 1rem 4rem;
    font-size: 1.5rem;
    border: 4px solid var(--primary);
    border-radius: 50px;
  }

  /* Staggered Animations */
  .stagger-1 {
    animation: popIn 0.5s ease-out 0.1s both;
  }
  .stagger-2 {
    animation: popIn 0.5s ease-out 0.2s both;
  }
  .stagger-3 {
    animation: popIn 0.5s ease-out 0.3s both;
  }
  .stagger-4 {
    animation: popIn 0.5s ease-out 0.4s both;
  }

  @keyframes popIn {
    0% {
      transform: scale(0.8);
      opacity: 0;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stagger-1,
    .stagger-2,
    .stagger-3,
    .stagger-4,
    .anim-pop,
    .anim-slide-in,
    .anim-jitter {
      animation: none !important;
    }
  }
</style>
