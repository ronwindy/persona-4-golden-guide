---

<GuideLayout title="Version History | Persona 4 Golden Guide">
  <header class="history-header anim-pop">
    <div class="header-content">
      <h1 class="font-pop">VERSION <span class="highlight">HISTORY</span></h1>
      <div class="subtitle font-pop">DEVELOPMENT ARCHIVE</div>
    </div>
    <div class="header-decoration bg-stripes"></div>
  </header>

  <div class="timeline">
    {
      history.map((item, index) => (
        <div class={`timeline-item anim-slide-in stagger-${(index % 5) + 1}`}>
          <div class="version-badge p4g-shadow">
            <span class="v-label font-pop">VER</span>
            <span class="v-number font-pop">{item.version}</span>
          </div>

          <div class="timeline-content p4g-shadow">
            <div class="date-header font-pop">
              <span class="icon">📅</span> {item.date}
            </div>
            <ul class="change-list font-read">
              {item.changes.map((change) => (
                <li>{change}</li>
              ))}
            </ul>
            <div class="corner-decoration" />
          </div>
        </div>
      ))
    }
  </div>
</GuideLayout>

<style>
  .history-header {
    background: var(--secondary);
    border: 6px solid var(--primary);
    padding: 3rem 2rem;
    position: relative;
    margin-bottom: 4rem;
    box-shadow: 12px 12px 0 var(--secondary);
    overflow: hidden;
  }

  .header-content {
    position: relative;
    z-index: 2;
  }

  .history-header h1 {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    color: var(--primary);
    margin: 0;
    line-height: 0.9;
    transform: rotate(-1.5deg);
  }

  .history-header h1 .highlight {
    color: var(--secondary);
    background: var(--primary);
    padding: 0 0.75rem;
    display: inline-block;
    transform: rotate(3deg);
    box-shadow: 4px 4px 0 var(--accent-orange);
  }

  .subtitle {
    margin-top: 1rem;
    font-size: 1.5rem;
    color: var(--primary);
    opacity: 0.8;
    letter-spacing: 0.2em;
    font-style: italic;
  }

  .header-decoration {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 100%;
    height: 15px;
    background-size: 30px 30px;
  }

  .timeline {
    position: relative;
    padding-left: 2rem;
    border-left: 8px solid var(--secondary);
    margin-left: 1rem;
  }

  .timeline::before {
    content: "";
    position: absolute;
    top: 0;
    left: -12px;
    width: 16px;
    height: 16px;
    background: var(--accent-orange);
    border: 4px solid var(--secondary);
    border-radius: 50%;
  }

  .timeline-item {
    position: relative;
    margin-bottom: 3rem;
  }

  .version-badge {
    position: absolute;
    left: -58px;
    top: 0;
    background: var(--primary);
    border: 3px solid var(--secondary);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.2rem 0.5rem;
    transform: rotate(-5deg);
    z-index: 10;
    min-width: 60px;
  }

  .version-badge .v-label {
    font-size: 0.7rem;
    color: var(--secondary);
    font-weight: 800;
  }

  .version-badge .v-number {
    font-size: 1.1rem;
    color: var(--secondary);
    font-weight: 900;
  }

  .timeline-content {
    background: var(--bg-white);
    border: 4px solid var(--secondary);
    padding: 1.5rem;
    position: relative;
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(4px);
    transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .timeline-content:hover {
    transform: translate(6px, -4px);
    box-shadow: 12px 12px 0 var(--secondary);
    background: var(--primary);
  }

  .date-header {
    background: var(--secondary);
    color: var(--primary);
    display: inline-block;
    padding: 0.3rem 1rem;
    font-size: 1.1rem;
    margin-bottom: 1rem;
    transform: skewX(-10deg);
  }

  .change-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .change-list li {
    padding: 0.5rem 0;
    padding-left: 1.5rem;
    position: relative;
    font-weight: 600;
    color: var(--secondary);
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .change-list li::before {
    content: "▶";
    position: absolute;
    left: 0;
    color: var(--accent-orange);
    font-size: 0.8rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .corner-decoration {
    position: absolute;
    bottom: -4px;
    right: -4px;
    width: 20px;
    height: 20px;
    background: var(--accent-orange);
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
    border: 2px solid var(--secondary);
  }

  /* Animations Stagger */
  .stagger-1 {
    animation-delay: 0.1s;
  }
  .stagger-2 {
    animation-delay: 0.2s;
  }
  .stagger-3 {
    animation-delay: 0.3s;
  }
  .stagger-4 {
    animation-delay: 0.4s;
  }
  .stagger-5 {
    animation-delay: 0.5s;
  }

  @media (max-width: 640px) {
    .timeline {
      margin-left: 0.5rem;
      padding-left: 1.5rem;
    }
    .version-badge {
      left: -48px;
      min-width: 50px;
    }
    .history-header {
      padding: 2rem 1rem;
    }
  }
</style>
