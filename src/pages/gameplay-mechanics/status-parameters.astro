---
// src/pages/gameplay-mechanics/status-parameters.astro
import GuideLayout from "../../layouts/GuideLayout.astro";

const heroImagePath = "/persona-4-golden-guide/p4g-key-art-1.png";
---

<GuideLayout title="Status Parameters | Persona 4 Golden Guide">
   <header class="status-header anim-pop">
      <div class="header-bg" style={`background-image: url(${heroImagePath});`}>
      </div>
      <div class="header-overlay"></div>
      <div class="tv-scanlines"></div>

      <div class="header-content">
         <h1 class="font-pop">
            STATUS <span class="skew-highlight">PARAMETERS</span>
         </h1>
         <div class="breadcrumb font-pop">SYSTEMS // MC STATUS // GROWTH</div>
      </div>
   </header>

   <div class="divider bg-stripes"></div>

   <main class="fragment-layout anim-slide-in">
      <div class="intro-card fragment-card full-width">
         <div class="fragment-body font-read">
            <p>
               There are five <span class="text-highlight">
                  Status Parameters</span
               > exclusive to the Main Character:
               <strong>Courage</strong>, <strong>Diligence</strong>, <strong
                  >Knowledge</strong
               >, <strong>Expression</strong>, and <strong>Understanding</strong
               >. They have five ranks each and are essential for ranking up
               Social Links, taking certain jobs, and choosing unique dialogue
               responses.
            </p>
            <div class="point-tip font-pop">
               TIP: NORMAL INCREASE: +3 PTS // GREAT INCREASE: +5 PTS
            </div>
         </div>
      </div>

      <!-- Courage -->
      <section
         class="fragment-card stat-card courage-stat anim-slide-right stagger-1"
      >
         <div class="fragment-header font-pop">
            <div class="title-group"><span class="fragment-num">01</span> COURAGE</div>
         </div>
         <div class="fragment-body font-read">
            <div class="rank-grid p4g-shadow-sm">
               <div class="rank-row">
                  <span>Rank 1</span>
                  <span>Average (0)</span>
               </div>
               <div class="rank-row">
                  <span>Rank 2</span>
                  <span>Reliable (16)</span>
               </div>
               <div class="rank-row">
                  <span>Rank 3</span>
                  <span>Brave (40)</span>
               </div>
               <div class="rank-row">
                  <span>Rank 4</span>
                  <span>Daring (80)</span>
               </div>
               <div class="rank-row">
                  <span>Rank 5</span>
                  <span>Heroic (140)</span>
               </div>
            </div>

            <div class="stat-info">
               <h4 class="font-pop">HOW TO EARN</h4>
               <ul class="mechanic-list">
                  <li>Hospital part-time job</li>
                  <li>Aiya Beef Bowl challenge</li>
                  <li>Reading certain books</li>
                  <li>Riding the scooter</li>
                  <li>Defeating side bosses</li>
                  <li>Eating fridge food (Great Increase)</li>
               </ul>

               <h4 class="font-pop">NEEDED FOR</h4>
               <div class="badge-row">
                  <span class="feature-badge">Moon S.Link (Brave)</span>
                  <span class="feature-badge">Fortune S.Link (Heroic)</span>
                  <span class="feature-badge">Shrine at Night (Reliable)</span>
               </div>
            </div>

            <div class="opinion-note">
               <p>
                  <em
                     >"Courage is the easiest stat to rank up due to the variety
                     of ways to earn points. Usually the first stat you max."</em
                  >
               </p>
            </div>
         </div>
      </section>

      <!-- Diligence -->
      <section
         class="fragment-card stat-card diligence-stat anim-slide-left stagger-2"
      >
         <div class="fragment-header font-pop">
            <div class="title-group"><span class="fragment-num">02</span> DILIGENCE</div>
         </div>
         <div class="fragment-body font-read">
            <div class="rank-grid p4g-shadow-sm">
               <div class="rank-row">
                  <span>Rank 1</span>
                  <span>Callow (0)</span>
               </div>
               <div class="rank-row">
                  <span>Rank 2</span>
                  <span>Persistent (16)</span>
               </div>
               <div class="rank-row">
                  <span>Rank 3</span>
                  <span>Strong (40)</span>
               </div>
               <div class="rank-row">
                  <span>Rank 4</span>
                  <span>Persuasive (80)</span>
               </div>
               <div class="rank-row">
                  <span>Rank 5</span>
                  <span>Rock Solid (130)</span>
               </div>
            </div>

            <div class="stat-info">
               <h4 class="font-pop">HOW TO EARN</h4>
               <ul class="mechanic-list">
                  <li>Attend the sports club</li>
                  <li>Aiya Beef Bowl challenge</li>
                  <li>Sealing envelopes job</li>
                  <li>Maintain the garden</li>
                  <li>Aiya Chow Mein (Great Increase)</li>
               </ul>

               <h4 class="font-pop">NEEDED FOR</h4>
               <div class="badge-row">
                  <span class="feature-badge">Hospital Job (Strong)</span>
                  <span class="feature-badge">Origami Job (Persistent)</span>
                  <span class="feature-badge">Fishing (More lines)</span>
               </div>
            </div>

            <div class="opinion-note">
               <p>
                  <em
                     >"Diligence makes the hospital job hard to obtain early.
                     Keep up with it and it's not the worst stat."</em
                  >
               </p>
            </div>
         </div>
      </section>

      <!-- Knowledge -->
      <section
         class="fragment-card stat-card knowledge-stat anim-slide-right stagger-3"
      >
         <div class="fragment-header font-pop">
            <div class="title-group"><span class="fragment-num">03</span> KNOWLEDGE</div>
         </div>
         <div class="fragment-body font-read">
            <div class="rank-grid p4g-shadow-sm">
               <div class="rank-row">
                  <span>Rank 1</span>
                  <span>Aware (0)</span>
               </div>
               <div class="rank-row">
                  <span>Rank 2</span>
                  <span>Informed (30)</span>
               </div>
               <div class="rank-row">
                  <span>Rank 3</span>
                  <span>Expert (80)</span>
               </div>
               <div class="rank-row">
                  <span>Rank 4</span>
                  <span>Professor (150)</span>
               </div>
               <div class="rank-row">
                  <span>Rank 5</span>
                  <span>Sage (240)</span>
               </div>
            </div>

            <div class="stat-info">
               <h4 class="font-pop">HOW TO EARN</h4>
               <ul class="mechanic-list">
                  <li>Study at Library/Desk</li>
                  <li>Rainy day study bonuses</li>
                  <li>Reading certain books</li>
                  <li>Answering questions in class</li>
                  <li>Aiya Beef Bowl challenge</li>
               </ul>

               <h4 class="font-pop">NEEDED FOR</h4>
               <div class="badge-row">
                  <span class="feature-badge">Exam Bonuses</span>
                  <span class="feature-badge">Empress S.Link (Expert)</span>
                  <span class="feature-badge">Fortune S.Link (Sage)</span>
                  <span class="feature-badge">Translator Job (Informed)</span>
               </div>
            </div>

            <div class="opinion-note">
               <p>
                  <em
                     >"Hardest stat to rank up due to high points. Early exam
                     bonuses are tough but rewarding."</em
                  >
               </p>
            </div>
         </div>
      </section>

      <!-- Expression -->
      <section
         class="fragment-card stat-card expression-stat anim-slide-left stagger-4"
      >
         <div class="fragment-header font-pop">
            <div class="title-group"><span class="fragment-num">04</span> EXPRESSION</div>
         </div>
         <div class="fragment-body font-read">
            <div class="rank-grid p4g-shadow-sm">
               <div class="rank-row">
                  <span>Rank 1</span>
                  <span>Rough (0)</span>
               </div>
               <div class="rank-row">
                  <span>Rank 2</span>
                  <span>Eloquent (13)</span>
               </div>
               <div class="rank-row">
                  <span>Rank 3</span>
                  <span>Persuasive (33)</span>
               </div>
               <div class="rank-row">
                  <span>Rank 4</span>
                  <span>Touching (53)</span>
               </div>
               <div class="rank-row">
                  <span>Rank 5</span>
                  <span>Enthralling (85)</span>
               </div>
            </div>

            <div class="stat-info">
               <h4 class="font-pop">HOW TO EARN</h4>
               <ul class="mechanic-list">
                  <li>Helping classmates with questions</li>
                  <li>Translator part-time job</li>
                  <li>Tutor part-time job</li>
                  <li>Cultural Club activities</li>
                  <li>Reading certain books</li>
               </ul>

               <h4 class="font-pop">NEEDED FOR</h4>
               <div class="badge-row">
                  <span class="feature-badge">Hierophant S.Link (Multiple)</span
                  >
                  <span class="feature-badge">Justice S.Link (Multiple)</span>
                  <span class="feature-badge">Quest 12</span>
               </div>
            </div>

            <div class="opinion-note">
               <p>
                  <em
                     >"Hardest stat to rank due to limited ways to increase.
                     Critical for Dojima family links."</em
                  >
               </p>
            </div>
         </div>
      </section>

      <!-- Understanding -->
      <section
         class="fragment-card stat-card understanding-stat anim-slide-right stagger-1"
      >
         <div class="fragment-header font-pop">
            <div class="title-group"><span class="fragment-num">05</span> UNDERSTANDING</div>
         </div>
         <div class="fragment-body font-read">
            <div class="rank-grid p4g-shadow-sm">
               <div class="rank-row">
                  <span>Rank 1</span>
                  <span>Basic (0)</span>
               </div>
               <div class="rank-row">
                  <span>Rank 2</span>
                  <span>Kindly (16)</span>
               </div>
               <div class="rank-row">
                  <span>Rank 3</span>
                  <span>Generous (40)</span>
               </div>
               <div class="rank-row">
                  <span>Rank 4</span>
                  <span>Motherly (80)</span>
               </div>
               <div class="rank-row">
                  <span>Rank 5</span>
                  <span>Saintly (140)</span>
               </div>
            </div>

            <div class="stat-info">
               <h4 class="font-pop">HOW TO EARN</h4>
               <ul class="mechanic-list">
                  <li>Folding origami job</li>
                  <li>Daycare part-time job</li>
                  <li>Reading certain books</li>
                  <li>Aiya Beef Bowl challenge</li>
               </ul>

               <h4 class="font-pop">NEEDED FOR</h4>
               <div class="badge-row">
                  <span class="feature-badge">Hanged Man S.Link (Generous)</span
                  >
                  <span class="feature-badge">Tower S.Link (Saintly)</span>
                  <span class="feature-badge">Dishwasher Job (Kindly)</span>
               </div>
            </div>

            <div class="opinion-note">
               <p>
                  <em
                     >"Not too hard to rank up. Mostly needed for Hanged Man and
                     Tower links."</em
                  >
               </p>
            </div>
         </div>
      </section>
   </main>

   <footer class="status-footer anim-pop">
      <div class="footer-content p4g-shadow-sm bg-halftone">
         <div class="footer-icon font-pop">STAT</div>
         <div class="footer-text font-read">
            <h3 class="font-pop">"THE POTENTIAL WITHIN..."</h3>
            <p>
               Every choice you make shapes the person you become. Master your
               parameters to forge deeper bonds.
            </p>
         </div>
      </div>
   </footer>
</GuideLayout>

<style>
   .status-header {
      min-height: 200px;
      height: auto;
      position: relative;
      overflow: hidden;
      border: 6px solid var(--secondary);
      box-shadow: 10px 10px 0 var(--secondary);
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 3rem 1rem;

      .header-bg {
         position: absolute;
         inset: 0;
         background-size: cover;
         background-position: center 20%;
         z-index: 1;
      }

      .header-overlay {
         position: absolute;
         inset: 0;
         background: linear-gradient(
            135deg,
            rgba(255, 241, 0, 0.4) 0%,
            rgba(26, 26, 26, 0.5) 100%
         );
         z-index: 2;
      }

      .tv-scanlines {
         position: absolute;
         inset: 0;
         background: linear-gradient(
            rgba(18, 16, 16, 0) 50%,
            rgba(0, 0, 0, 0.1) 50%
         );
         background-size: 100% 4px;
         pointer-events: none;
         z-index: 3;
         opacity: 0.4;
      }

      .header-content {
         position: relative;
         z-index: 10;
         transform: rotate(-1.5deg);
         width: 100%;

         h1 {
            font-size: clamp(1.8rem, 8vw, 4.5rem);
            color: var(--secondary);
            margin: 0;
            text-shadow: 3px 3px 0 rgba(255, 255, 255, 0.9);

            .skew-highlight {
               background: var(--secondary);
               color: var(--primary);
               padding: 0 0.8rem;
               display: inline-block;
               transform: skew(-8deg) rotate(2deg);
               box-shadow: 4px 4px 0 var(--accent-orange);
               margin-top: 0.25rem;
            }
         }

         .breadcrumb {
            margin-top: 1rem;
            background: var(--secondary);
            color: white;
            padding: 0.2rem 1.25rem;
            display: inline-block;
            letter-spacing: 0.15rem;
            font-size: 0.8rem;
         }
      }
   }

   .fragment-layout {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      gap: 3rem;
      padding: 2rem 0 5rem 0;
   }

   .fragment-card {
      background: white;
      border: 4px solid var(--secondary);
      padding: 2.5rem;
      position: relative;
      box-shadow: 12px 12px 0 var(--secondary);
      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      overflow: hidden;

      &.full-width {
         grid-column: 1 / -1;
      }

      &:hover {
         transform: translate(-4px, -4px) scale(1.01);
         box-shadow: 16px 16px 0 var(--accent-orange);
      }

      .fragment-header {
         font-size: 1.6rem;
         margin-bottom: 2rem;
         color: var(--secondary);
         display: flex;
         align-items: center;
         justify-content: space-between;
         border-bottom: 4px solid var(--primary);
         padding-bottom: 0.5rem;

         .title-group {
            display: flex;
            align-items: center;
            gap: 1rem;
         }

         .fragment-num {
            background: var(--secondary);
            color: var(--primary);
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            transform: rotate(-5deg);
            box-shadow: 3px 3px 0 var(--accent-orange);
            margin-right: 1rem;
         }
      }
   }

   .rank-grid {
      background: #f8f8f8;
      border: 2px solid var(--secondary);
      margin-bottom: 1.5rem;

      .rank-row {
         display: flex;
         justify-content: space-between;
         padding: 0.5rem 1rem;
         border-bottom: 1px solid #ddd;
         font-size: 0.95rem;

         &:last-child {
            border-bottom: none;
         }

         span:last-child {
            font-weight: 800;
            color: var(--secondary);
         }
      }
   }

   .stat-info h4 {
      font-size: 1rem;
      color: var(--secondary);
      margin-bottom: 0.8rem;
      background: var(--primary);
      display: inline-block;
      padding: 0.1rem 0.6rem;
      transform: skewX(-10deg);
      margin-top: 1rem;
   }

   .mechanic-list {
      list-style: square;
      padding-left: 1.5rem;
      margin-bottom: 1.5rem;
      font-size: 0.95rem;
      li {
         margin-bottom: 0.4rem;
      }
   }

   .badge-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-bottom: 1.5rem;
   }

   .feature-badge {
      background: var(--secondary);
      color: white;
      padding: 0.2rem 0.7rem;
      font-size: 0.8rem;
      font-weight: 800;
      border-left: 4px solid var(--primary);
   }

   .opinion-note {
      background: #fff9e6;
      border: 2px dashed var(--accent-orange);
      padding: 1rem;
      margin-top: 1.5rem;
      font-size: 0.95rem;
      color: #555;
   }

   .point-tip {
      margin-top: 1.5rem;
      background: var(--secondary);
      color: var(--primary);
      padding: 0.75rem 1.25rem;
      font-weight: 800;
      display: inline-block;
      transform: rotate(-1deg);
      box-shadow: 4px 4px 0 var(--accent-orange);
   }

   .text-highlight {
      background: var(--primary);
      color: var(--secondary);
      padding: 0.1rem 0.4rem;
      font-weight: 800;
      box-shadow: 2px 2px 0 var(--secondary);
   }

   .status-footer {
      margin-top: 3rem;
      margin-bottom: 5rem;
      display: flex;
      justify-content: center;
   }

   .footer-content {
      background: var(--primary);
      border: 4px solid var(--secondary);
      padding: 2rem 3rem;
      display: flex;
      align-items: center;
      gap: 2rem;
      transform: rotate(0.5deg);

      .footer-icon {
         background: var(--secondary);
         color: var(--primary);
         font-size: 2rem;
         padding: 1rem;
         box-shadow: 5px 5px 0 white;
         transform: rotate(-5deg);
      }

      .footer-text h3 {
         font-size: 1.8rem;
         color: var(--secondary);
         margin-bottom: 0.25rem;
      }

      .footer-text p {
         font-size: 1.1rem;
         color: rgba(0, 0, 0, 0.7);
         max-width: 500px;
      }
   }

   @media (max-width: 850px) {
      .fragment-layout {
         grid-template-columns: 1fr;
         gap: 1.5rem;
      }

      .footer-content {
         flex-direction: column;
         text-align: center;
         padding: 2rem 1.5rem;
      }
   }
</style>
