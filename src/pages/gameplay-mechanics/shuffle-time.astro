---
// src/pages/gameplay-mechanics/shuffle-time.astro
import GuideLayout from "../../layouts/GuideLayout.astro";

const heroImagePath = "/persona-4-golden-guide/p4g-key-art-3.webp";

const cards = [
  {
    name: "Fool",
    effect: "+1 Draw, Changes all undrawn cards.",
    type: "Arcana",
  },
  {
    name: "Magician",
    effect:
      "Rare Card. Changes a Skill of currently equipped Persona to a better one. If all Skills on Persona are the best Skill available, nothing happens.",
    type: "Rare",
  },
  {
    name: "Priestess",
    effect: "+1 Draw, Changes one undrawn card into a random Arcana card.",
    type: "Arcana",
  },
  {
    name: "Empress",
    effect: "+1 Draw, Removes one undrawn card.",
    type: "Arcana",
  },
  {
    name: "Emperor",
    effect: "Rare Card. Currently equipped Persona gains one level.",
    type: "Rare",
  },
  {
    name: "Hierophant",
    effect: "+1 Draw, Changes one undrawn card into a random Persona card.",
    type: "Arcana",
  },
  {
    name: "Lovers",
    effect: "+2 Draw, No item drops from battle are awarded.",
    type: "Arcana",
  },
  {
    name: "Chariot",
    effect: "Gives one point of AG to currently equipped Persona.",
    type: "Arcana",
  },
  {
    name: "Justice",
    effect: "Gives one point of ST to currently equipped Persona.",
    type: "Arcana",
  },
  {
    name: "Hermit",
    effect:
      "Shadows will not aggro. Effect ends upon next battle or leaving current floor.",
    type: "Arcana",
  },
  {
    name: "Fortune",
    effect: "Gives one point of LU to currently equipped Persona.",
    type: "Arcana",
  },
  {
    name: "Strength",
    effect: "Gives one point of MA to currently equipped Persona.",
    type: "Arcana",
  },
  {
    name: "Hanged Man",
    effect: "Gives one point of EN to currently equipped Persona.",
    type: "Arcana",
  },
  { name: "Death", effect: "Ends Shuffle Time.", type: "Arcana" },
  { name: "Temperance", effect: "Gives one Chest Key.", type: "Arcana" },
  {
    name: "Devil",
    effect: "+3 Draw, No Exp from battle is awarded.",
    type: "Arcana",
  },
  {
    name: "Tower",
    effect: "+3 Draw, No money from battle is awarded.",
    type: "Arcana",
  },
  { name: "Star", effect: "+1 Draw, Removes one drawn card.", type: "Arcana" },
  {
    name: "Moon",
    effect: "+2 Draw, Exp from battle is cut in half.",
    type: "Arcana",
  },
  {
    name: "Sun",
    effect: "+2 Draw, Money from battle is cut in half.",
    type: "Arcana",
  },
  { name: "Judgement", effect: "No effect.", type: "Arcana" },
  { name: "Aeon", effect: "Rare Card. +4 Draw.", type: "Rare" },
  { name: "World", effect: "No effect.", type: "Arcana" },
  {
    name: "Sword",
    effect: "Gives one Skill Card. Skill Card given is based on card rank.",
    type: "Minor",
  },
  {
    name: "Cup",
    effect: "Restores party's HP and SP. Formula for this is unknown.",
    type: "Minor",
  },
  {
    name: "Coin",
    effect:
      "Increases money earned from battle. Formula assumed to be an additional 0.2 times card rank. This stacks with Sun/Tower card, meaning Rank 5 card will negate Tower card.",
    type: "Minor",
  },
  {
    name: "Wand",
    effect:
      "Increases Exp earned from battle. Formula assumed to be an additional 0.2 times card rank. This stacks with Moon/Devil card, meaning Rank 5 card will negate Devil card.",
    type: "Minor",
  },
  {
    name: "Persona",
    effect:
      "Gives Persona on card. Personas available are based on current dungeon. If Persona is already in deck, nothing happens.",
    type: "Special",
  },
];
---

<GuideLayout title="Shuffle Time | Persona 4 Golden Guide">
  <header class="shuffle-header anim-pop">
    <div class="header-bg" style={`background-image: url(${heroImagePath});`}>
    </div>
    <div class="header-overlay"></div>
    <div class="tv-scanlines"></div>
    <div class="header-decoration bg-halftone"></div>

    <div class="spinning-halo"></div>

    <div class="card-shower">
      <div class="floating-card c1"><span>0</span></div>
      <div class="floating-card c2"><span>I</span></div>
      <div class="floating-card c3"><span>II</span></div>
      <div class="floating-card c4"><span>III</span></div>
      <div class="floating-card c5"><span>IV</span></div>
      <div class="floating-card c6"><span>V</span></div>
    </div>

    <div class="header-content">
      <div class="badge-sweep font-pop anim-bounce">SWEEP BONUS!</div>
      <div class="shuffle-title-new font-pop">
        <div class="word-container shuffle">
          {
            "SHUFFLE".split("").map((char, i) => (
              <span class="letter-card" style={`--i: ${i}; --total: 7`}>
                {char}
              </span>
            ))
          }
        </div>
        <div class="word-container time">
          {
            "TIME".split("").map((char, i) => (
              <span class="letter-card" style={`--i: ${i}; --total: 4`}>
                {char}
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <div class="corner-decoration top-left"></div>
    <div class="corner-decoration bottom-right"></div>
  </header>

  <div class="divider bg-stripes"></div>

  <main class="fragment-layout">
    <!-- Section: Overview -->
    <section
      class="fragment-card overview-fragment full-width anim-slide-up stagger-1"
    >
      <div class="fragment-header font-pop">
        <div class="title-group">
          <span class="fragment-num">01</span>
          <svg
            class="header-icon pulse"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M12 2v20M2 12h20"></path><path
              d="m17 7-5-5-5 5M17 17l-5 5-5-5"></path></svg
          >
          WHAT IS SHUFFLE TIME?
        </div>
      </div>
      <div class="fragment-body font-read">
        <div class="intro-content">
          <p>
            <strong>Shuffle Time</strong> is a minigame awarded after battle where
            you can obtain new Personas and other benefits. It has a random chance
            of appearing, with a higher probability triggered by various actions taken
            in battle, such as hitting weaknesses and performing <strong
              >All-Out Attacks</strong
            >.
          </p>
          <div class="highlight-box p4g-shadow">
            <span class="highlight-label font-pop">PRO TIP</span>
            Finishing the battle with an <strong>All-Out Attack</strong> will guarantee
            Shuffle Time.
          </div>
          <p>
            During Shuffle Time, multiple cards will appear with various
            effects. You normally start with <strong>one draw</strong>, and may
            earn extra draws through card effects.
          </p>
        </div>
      </div>
    </section>

    <!-- Section: Sweep Bonus -->
    <section class="fragment-card sweep-fragment anim-slide-right stagger-2">
      <div class="fragment-header font-pop">
        <div class="title-group">
          <span class="fragment-num">02</span>
          <svg
            class="header-icon bounce"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M12 2v20M2 12h20"></path><path
              d="m7 17 5 5 5-5M7 7l5-5 5 5"></path></svg
          >
          SWEEP BONUS
        </div>
      </div>
      <div class="fragment-body font-read">
        <p>
          If you manage to draw <strong>every card</strong> available during Shuffle
          Time, you will earn a <strong>Sweep Bonus</strong>.
        </p>
        <div class="sweep-benefits">
          <div class="benefit-item">
            <span class="bullet">✦</span>
            <strong>Guarantees</strong> Shuffle Time in the next battle.
          </div>
          <div class="benefit-item">
            <span class="bullet">✦</span> Grants <strong>two extra draws</strong
            > in the next Shuffle Time.
          </div>
          <div class="benefit-item">
            <span class="bullet">✦</span> Replaces Death, Judgement, or currently
            owned Persona cards in the next set.
          </div>
        </div>
      </div>
    </section>

    <!-- Section: Mechanics -->
    <section class="fragment-card mechanics-fragment anim-slide-left stagger-3">
      <div class="fragment-header font-pop">
        <div class="title-group">
          <span class="fragment-num">03</span>
          <svg
            class="header-icon spin"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"
            ></path></svg
          >
          CARD MECHANICS
        </div>
      </div>
      <div class="fragment-body font-read">
        <p>
          Some cards have negative immediate effects (like cutting EXP or Gold)
          but grant <strong>extra draws</strong>. Use these strategically to
          clear the board and trigger a Sweep Bonus.
        </p>
        <ul class="mechanics-list">
          <li>
            <strong>Draw Count:</strong> Starts at 1. Maximize this to clear the board.
          </li>
          <li>
            <strong>Card Replacement:</strong> Some cards swap or remove others.
          </li>
          <li>
            <strong>Rare Cards:</strong> Only appear occasionally and provide powerful
            buffs.
          </li>
        </ul>
      </div>
    </section>

    <!-- Section: Card List -->
    <section
      class="fragment-card cards-fragment full-width anim-slide-up stagger-4"
    >
      <div class="fragment-header font-pop">
        <div class="title-group">
          <span class="fragment-num">04</span>
          <svg
            class="header-icon hover-swing"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><line
              x1="3"
              x2="21"
              y1="9"
              y2="9"></line><line x1="9" x2="9" y1="21" y2="9"></line></svg
          >
          SHUFFLE TIME CARD LIST
        </div>
      </div>
      <div class="fragment-body">
        <div class="cards-grid">
          {
            cards.map((card) => (
              <div
                class={`card-item p4g-shadow type-${card.type.toLowerCase()}`}
              >
                <div class="card-header font-pop">
                  <span class="card-name">{card.name}</span>
                  <span class={`card-type badge ${card.type.toLowerCase()}`}>
                    {card.type}
                  </span>
                </div>
                <p class="card-effect font-read">{card.effect}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <div class="status-ticker bg-stripes">
    <div class="ticker-content font-pop">
      PICK A CARD // SWEEP BONUS // ONE MORE DRAW // ARCANA CHANCE // SHUFFLE
      TIME // PICK A CARD // SWEEP BONUS
    </div>
  </div>
</GuideLayout>

<style>
  .divider {
    height: 20px;
    margin: 4rem 0;
    width: 100%;
    border-top: 4px solid var(--secondary);
    border-bottom: 4px solid var(--secondary);
  }

  /* Header Section */
  .shuffle-header {
    min-height: 400px;
    height: auto;
    position: relative;
    overflow: hidden;
    border: 8px solid var(--secondary);
    box-shadow: 15px 15px 0 var(--secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6rem 2rem;
    margin-bottom: 3rem;
    background: var(--primary);

    .header-bg {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center center;
      z-index: 1;
      filter: contrast(1.2) brightness(0.6) grayscale(0.3);
      mix-blend-mode: multiply;
    }

    .header-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        135deg,
        rgba(252, 227, 0, 0.6) 0%,
        rgba(26, 26, 26, 0.8) 100%
      );
      z-index: 2;
    }

    .tv-scanlines {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        rgba(18, 16, 16, 0) 50%,
        rgba(0, 0, 0, 0.2) 50%
      );
      background-size: 100% 6px;
      pointer-events: none;
      z-index: 3;
      opacity: 0.6;
    }

    .header-decoration {
      position: absolute;
      inset: 0;
      background-image: radial-gradient(
        var(--secondary) 1.5px,
        transparent 1.5px
      );
      background-size: 12px 12px;
      opacity: 0.15;
      z-index: 4;
      pointer-events: none;
    }

    .spinning-halo {
      position: absolute;
      width: 600px;
      height: 600px;
      border: 40px double var(--primary);
      border-radius: 50%;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      opacity: 0.1;
      z-index: 2;
      animation: rotateHalo 20s linear infinite;

      &::after {
        content: "";
        position: absolute;
        inset: -60px;
        border: 20px dotted var(--primary);
        border-radius: 50%;
        animation: rotateHalo 30s linear infinite reverse;
      }
    }

    .card-shower {
      position: absolute;
      inset: 0;
      z-index: 5;
      pointer-events: none;

      .floating-card {
        position: absolute;
        width: 70px;
        height: 110px;
        background: white;
        border: 3px solid var(--secondary);
        border-radius: 6px;
        box-shadow: 6px 6px 0 var(--secondary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        color: var(--secondary);
        font-size: 1.8rem;
        opacity: 0.7;
        transition: transform 0.3s;

        span {
          transform: rotate(-5deg);
        }

        &.c1 {
          top: 15%;
          left: 10%;
          transform: rotate(-20deg);
          animation: cardFloat 7s ease-in-out infinite;
        }
        &.c2 {
          top: 55%;
          left: 5%;
          transform: rotate(15deg);
          animation: cardFloat 9s ease-in-out infinite reverse;
        }
        &.c3 {
          top: 10%;
          right: 12%;
          transform: rotate(25deg);
          animation: cardFloat 8s ease-in-out infinite 1s;
        }
        &.c4 {
          top: 60%;
          right: 8%;
          transform: rotate(-15deg);
          animation: cardFloat 10s ease-in-out infinite 0.5s;
        }
        &.c5 {
          top: 5%;
          left: 45%;
          transform: rotate(5deg);
          animation: cardFloat 11s ease-in-out infinite 2s;
          opacity: 0.4;
        }
        &.c6 {
          bottom: 10%;
          left: 40%;
          transform: rotate(-10deg);
          animation: cardFloat 12s ease-in-out infinite 1.5s;
          opacity: 0.4;
        }
      }
    }

    .header-content {
      position: relative;
      z-index: 10;
      width: 100%;

      .badge-sweep {
        position: absolute;
        top: -60px;
        right: 15%;
        background: var(--accent-orange);
        color: white;
        padding: 0.5rem 1.5rem;
        font-weight: 900;
        font-size: 1.2rem;
        border: 4px solid var(--secondary);
        box-shadow: 6px 6px 0 var(--secondary);
        transform: rotate(8deg);
        z-index: 15;

        &::before {
          content: "★";
          margin-right: 0.5rem;
        }
      }

      .shuffle-title-new {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        perspective: 1000px;
        margin: 2rem 0;

        .word-container {
          display: flex;
          gap: 0.4rem;
          justify-content: center;
          flex-wrap: wrap;

          &.shuffle {
            transform: rotate(-2deg);
          }
          &.time {
            transform: rotate(3deg) translateY(-10px);
          }
        }

        .letter-card {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          width: clamp(50px, 12vw, 90px);
          height: clamp(80px, 18vw, 130px);
          font-size: clamp(2.5rem, 8vw, 5rem);
          font-weight: 900;
          border: 5px solid var(--secondary);
          position: relative;
          background: white;
          color: var(--secondary);
          box-shadow: 8px 8px 0 var(--secondary);
          transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
          animation: dealCard 0.6s cubic-bezier(0.2, 1, 0.3, 1) both;
          animation-delay: calc(var(--i) * 0.1s);

          /* Fan effect */
          --rot: calc((var(--i) - (var(--total) / 2)) * 5deg);
          transform: rotate(var(--rot))
            translateY(calc(abs(var(--i) - (var(--total) / 2)) * 5px));

          &:hover {
            transform: scale(1.1) rotate(0deg) translateY(-20px);
            z-index: 100;
            background: var(--primary);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
          }

          &::before {
            content: "";
            position: absolute;
            inset: 5px;
            border: 1px solid rgba(0, 0, 0, 0.1);
          }
        }

        .shuffle .letter-card {
          background: var(--primary);
          &:nth-child(odd) {
            background: white;
          }
        }

        .time .letter-card {
          background: var(--accent-orange);
          color: white;
          &:nth-child(even) {
            background: var(--secondary);
          }
        }
      }
    }

    .corner-decoration {
      position: absolute;
      width: 100px;
      height: 100px;
      z-index: 12;
      pointer-events: none;

      &.top-left {
        top: 0;
        left: 0;
        border-top: 20px solid var(--secondary);
        border-left: 20px solid var(--secondary);
        clip-path: polygon(0 0, 100% 0, 100% 20%, 20% 20%, 20% 100%, 0 100%);
      }

      &.bottom-right {
        bottom: 0;
        right: 0;
        border-bottom: 20px solid var(--accent-orange);
        border-right: 20px solid var(--accent-orange);
        clip-path: polygon(100% 100%, 0 100%, 0 80%, 80% 80%, 80% 0, 100% 0);
      }
    }
  }

  @keyframes rotateHalo {
    from {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  @keyframes cardFloat {
    0%,
    100% {
      transform: translateY(0) rotate(var(--rot, 0deg));
    }
    50% {
      transform: translateY(-25px) rotate(calc(var(--rot, 0deg) + 8deg));
    }
  }

  @keyframes titleFloat {
    from {
      transform: translateY(0) rotate(var(--rot)) skewX(var(--skew));
    }
    to {
      transform: translateY(-12px) rotate(calc(var(--rot) + 1.5deg))
        skewX(var(--skew));
    }
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateY(0) rotate(8deg);
    }
    50% {
      transform: translateY(-10px) rotate(8deg);
    }
  }

  @keyframes dealCard {
    from {
      opacity: 0;
      transform: translateY(100px) rotate(20deg) scale(0.5);
    }
    to {
      opacity: 1;
      transform: rotate(var(--rot))
        translateY(calc(abs(var(--i) - (var(--total) / 2)) * 5px));
    }
  }

  .anim-bounce {
    animation: bounce 2s ease-in-out infinite;
  }
  .part-shuffle {
    --rot: -3deg;
    --skew: -10deg;
  }
  .part-time {
    --rot: 2.5deg;
    --skew: 10deg;
  }

  /* Fragment Layout */
  .fragment-layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 2.5rem 3rem;
    position: relative;
    width: 100%;
    margin-top: 2rem;
  }

  .fragment-card {
    background: white;
    border: 4px solid var(--secondary);
    padding: 2.5rem;
    position: relative;
    box-shadow: 12px 12px 0 var(--secondary);
    overflow: hidden;

    &.full-width {
      grid-column: 1 / -1;
    }

    .fragment-header {
      font-size: 1.4rem;
      margin-bottom: 1.5rem;
      color: var(--secondary);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      border-bottom: 3px solid var(--primary);
      padding-bottom: 0.5rem;

      .title-group {
        display: flex;
        align-items: center;
        gap: 1rem;

        .fragment-num {
          background: var(--secondary);
          color: var(--primary);
          width: 40px;
          height: 40px;
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 1rem;
          transform: rotate(-5deg);
          box-shadow: 3px 3px 0 var(--accent-orange);
        }
      }
    }
  }

  /* Overview Content */
  .intro-content {
    .highlight-box {
      background: var(--primary);
      border: 3px solid var(--secondary);
      padding: 1.5rem;
      margin: 1.5rem 0;
      position: relative;
      transform: rotate(-0.5deg);

      .highlight-label {
        position: absolute;
        top: -12px;
        left: 20px;
        background: var(--secondary);
        color: var(--primary);
        padding: 0.2rem 0.8rem;
        font-size: 0.8rem;
        font-weight: 900;
        transform: rotate(2deg);
      }
    }
  }

  /* Sweep Benefits */
  .sweep-benefits {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;

    .benefit-item {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
      padding: 0.75rem 1rem;
      background: #f8f8f8;
      border-left: 5px solid var(--accent-orange);

      .bullet {
        color: var(--accent-orange);
        font-weight: 900;
      }
    }
  }

  /* Mechanics List */
  .mechanics-list {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;

    li {
      margin-bottom: 0.75rem;
      padding-left: 1.5rem;
      position: relative;

      &::before {
        content: ">";
        position: absolute;
        left: 0;
        color: var(--primary);
        font-weight: 900;
        text-shadow: 1px 1px 0 var(--secondary);
      }
    }
  }

  /* Cards Grid */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .card-item {
    background: #fff;
    border: 1px solid #ddd;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.2s;

    &:hover {
      transform: translateY(-5px);
      border-color: var(--secondary);
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid #eee;
      padding-bottom: 0.5rem;

      .card-name {
        font-weight: 900;
        color: var(--secondary);
