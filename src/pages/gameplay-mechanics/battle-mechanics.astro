---
// src/pages/gameplay-mechanics/battle-mechanics.astro
import GuideLayout from "../../layouts/GuideLayout.astro";

const heroImagePath = "/persona-4-golden-guide/p4g-key-art.webp";

const stats = [
  { name: "Exp", label: "Experience", desc: "Experience. Used to level up. Enemies drop a fixed amount of Exp. Party members and Personas obtain more Exp if lower leveled, and less if higher leveled." },
  { name: "Lv", label: "Level", desc: "Increases after reaching certain Exp thresholds. Determines Persona fusion eligibility and skill learning." },
  { name: "HP", label: "Hit Points", desc: "Used for Physical Skills. If 0, the character is KO'd. MC reaching 0 HP results in Game Over." },
  { name: "SP", label: "Spirit Points", desc: "Used for Magic Skills. Reaching 0 SP has no immediate penalty other than inability to use magic." },
  { name: "AT", label: "Attack", desc: "Modifier on ST used for the Attack command. Damage is roughly (ST/EN) * AT." },
  { name: "DF", label: "Defense", desc: "Assumed to be a modifier on EN to reduce incoming damage." },
  { name: "HT", label: "Hit Rate", desc: "Assumed to be a modifier on AG for the probability of hitting an enemy." },
  { name: "EV", label: "Evasion", desc: "Assumed to be a modifier on AG to decrease the probability of being hit." },
  { name: "ST", label: "Strength", desc: "Base stat for physical damage and standard attacks." },
  { name: "MA", label: "Magic", desc: "Base stat for all magic skills and healing effectiveness." },
  { name: "EN", label: "Endurance", desc: "Base stat determining damage mitigation." },
  { name: "AG", label: "Agility", desc: "Affects hit/evasion rates and determines turn order in battle." },
  { name: "LU", label: "Luck", desc: "Affects critical hit rates, ailment susceptibility, and dodge/hit rates." }
];
---

<GuideLayout title="Battle Mechanics | Persona 4 Golden Guide">
  <header class="battle-header anim-pop">
    <div class="header-bg" style={`background-image: url(${heroImagePath});`}></div>
    <div class="header-overlay"></div>
    <div class="tv-scanlines"></div>
    <div class="header-decoration bg-halftone"></div>
    
    <div class="header-content">
      <h1 class="font-pop title-stack">
        <span class="word part-battle">BATTLE</span>
        <span class="word part-mechanics">MECHANICS</span>
      </h1>
      <div class="breadcrumb font-pop">
        <span class="bc-item">SYSTEMS</span>
        <span class="bc-sep">//</span>
        <span class="bc-item">COMBAT</span>
        <span class="bc-sep">//</span>
        <span class="bc-item">STRATEGY</span>
      </div>
    </div>
  </header>

  <div class="divider bg-stripes"></div>

  <main class="fragment-layout">
    <!-- Section: Stats -->
    <section class="fragment-card stats-fragment full-width anim-slide-up stagger-1">
      <div class="fragment-header font-pop">
        <div class="title-group">
          <span class="fragment-num">01</span>
          <svg class="header-icon pulse" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20v-6M6 20V10M18 20V4"/></svg>
          CHARACTER STATISTICS
        </div>
      </div>
      <div class="fragment-body">
        <div class="stats-grid">
          {stats.map(stat => (
            <div class="stat-card p4g-shadow">
              <div class="stat-header font-pop">
                <span class="stat-abbr">{stat.name}</span>
                <span class="stat-label">{stat.label}</span>
              </div>
              <p class="stat-desc font-read">{stat.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <!-- Section: Commands -->
    <section class="fragment-card commands-fragment anim-slide-right stagger-2">
      <div class="fragment-header font-pop">
        <div class="title-group">
          <span class="fragment-num">02</span>
          <svg class="header-icon bounce" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 14 7-7 7 7"/><path d="m5 21 7-7 7 7"/></svg>
          BATTLE COMMANDS
        </div>
      </div>
      <div class="fragment-body font-read">
        <div class="commands-list">
          <div class="command-item">
            <span class="cmd-name">Analysis:</span> Shows enemy attributes and information.
          </div>
          <div class="command-item">
            <span class="cmd-name">Tactics:</span> Give instructions to party members.
            <ul class="tactics-sublist">
              <li><strong>Act Freely:</strong> AI decides best move.</li>
              <li><strong>Full Assault:</strong> Maximum damage, low healing.</li>
              <li><strong>Conserve SP:</strong> Avoids SP usage.</li>
              <li><strong>Heal/Support:</strong> Focuses on survival and buffs.</li>
              <li><strong>Direct Commands:</strong> Full player control <span class="highlight-yellow">(Recommended)</span>.</li>
            </ul>
          </div>
          <div class="command-item">
            <span class="cmd-name">Guard:</span> Halves damage and negates weaknesses for one turn.
          </div>
          <div class="command-item">
            <span class="cmd-name">Attack:</span> Uses equipped weapon.
          </div>
          <div class="command-item">
            <span class="cmd-name">Skill:</span> Uses a Persona's Skill.
          </div>
          <div class="command-item">
            <span class="cmd-name">Persona:</span> MC can switch Personas; others can only check stats.
          </div>
          <div class="command-item">
            <span class="cmd-name">Item:</span> Use a consumable item.
          </div>
          <div class="command-item">
            <span class="cmd-name">Escape:</span> Attempt to flee. Reliability varies.
          </div>
        </div>
      </div>
    </section>

    <!-- Section: Attributes -->
    <section class="fragment-card attributes-fragment anim-slide-left stagger-3">
      <div class="fragment-header font-pop">
        <div class="title-group">
          <span class="fragment-num">03</span>
          <svg class="header-icon spin" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          ATTRIBUTES & AFFINITIES
        </div>
      </div>
      <div class="fragment-body font-read">
        <div class="affinity-legend p4g-shadow">
          <div class="legend-item"><span class="badge wk">Wk</span> <strong>Weak:</strong> +10% Damage, Knocks Down.</div>
          <div class="legend-item"><span class="badge res">Res</span> <strong>Resist:</strong> 25-50% Less Damage.</div>
          <div class="legend-item"><span class="badge nul">Nul</span> <strong>Null:</strong> No Damage.</div>
          <div class="legend-item"><span class="badge drn">Drn</span> <strong>Drain:</strong> Absorbs damage as HP.</div>
          <div class="legend-item"><span class="badge rpl">Rpl</span> <strong>Repel:</strong> Reflects damage back.</div>
        </div>
        <div class="attributes-grid">
          <div class="attr-item"><span class="attr-box phys"></span> <strong>Physical:</strong> Only attribute that can Critical Hit.</div>
          <div class="attr-item"><span class="attr-box fire"></span> <strong>Fire</strong></div>
          <div class="attr-item"><span class="attr-box ice"></span> <strong>Ice</strong></div>
          <div class="attr-item"><span class="attr-box elec"></span> <strong>Electric</strong></div>
          <div class="attr-item"><span class="attr-box wind"></span> <strong>Wind</strong></div>
          <div class="attr-item"><span class="attr-box light"></span> <strong>Light:</strong> Usually an instakill.</div>
          <div class="attr-item"><span class="attr-box dark"></span> <strong>Dark:</strong> Usually an instakill.</div>
          <div class="attr-item"><span class="attr-box alm"></span> <strong>Almighty:</strong> Cannot be resisted/reflected.</div>
        </div>
      </div>
    </section>
    <!-- Section: Battle Flow -->
    <section class="fragment-card flow-fragment anim-slide-right stagger-4">
      <div class="fragment-header font-pop">
        <div class="title-group">
          <span class="fragment-num">04</span>
          <svg class="header-icon bounce" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 17l5-5-5-5M6 17l5-5-5-5"/></svg>
          BATTLE FLOW
        </div>
      </div>
      <div class="fragment-body font-read">
        <div class="flow-step">
          <h3 class="font-pop">ONE MORE!</h3>
          <p>
            Inflicting a <span class="badge wk">Wk</span> or Critical hit knocks an enemy Down and grants the attacker a <strong>One More</strong> turn. 
            You can chain these by knocking down different enemies.
          </p>
        </div>
        <div class="flow-step">
          <h3 class="font-pop">ALL-OUT ATTACK</h3>
          <p>
            When <strong>every</strong> enemy is Down, you can initiate an All-Out Attack. 
            The party charges the enemies for massive <strong>Almighty</strong> damage. 
            Requires MC to be healthy and not alone.
          </p>
        </div>
      </div>
    </section>

    <!-- Section: Special Attacks -->
    <section class="fragment-card special-fragment anim-slide-left stagger-5">
      <div class="fragment-header font-pop">
        <div class="title-group">
          <span class="fragment-num">05</span>
          <svg class="header-icon pulse" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
          SPECIAL ATTACKS
        </div>
      </div>
      <div class="fragment-body font-read">
        <div class="special-group">
          <h3 class="font-pop">COMBINATION ATTACKS</h3>
          <p>Flashy follow-up attacks that occur if specific party members are present and the last enemy was knocked down.</p>
          <ul class="combo-list">
            <li><strong>Twin Dragons:</strong> Chie & Yukiko</li>
            <li><strong>Junes Bomber:</strong> Yosuke & Teddie</li>
            <li><strong>Beauty and the Beast:</strong> Kanji & Naoto</li>
          </ul>
        </div>
        <div class="special-group">
          <h3 class="font-pop">CAVALRY ATTACKS</h3>
          <p>Members not currently in the active party may ride in on scooters to perform a follow-up attack after a knockdown.</p>
        </div>
      </div>
    </section>

    <!-- Section: Social Link Abilities -->
    <section class="fragment-card social-abilities-fragment full-width anim-slide-up stagger-6">
      <div class="fragment-header font-pop">
        <div class="title-group">
          <span class="fragment-num">06</span>
          <svg class="header-icon hover-swing" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          SOCIAL LINK BATTLE ABILITIES
        </div>
      </div>
      <div class="fragment-body font-read">
        <div class="abilities-grid-main">
          <div class="ability-block">
            <h3 class="font-pop highlight-yellow">Standard Party Members</h3>
            <div class="rank-list">
              <div class="rank-item"><strong>Rank 1:</strong> Chance to help a downed ally stand up.</div>
              <div class="rank-item"><strong>Rank 3:</strong> Perform a <strong>Follow Up</strong> attack after MC knockdowns an enemy.</div>
              <div class="rank-item"><strong>Rank 5:</strong> Chance to cure Panic, Fear, or Rage.</div>
              <div class="rank-item"><strong>Rank 7:</strong> Endure a fatal hit with 1 HP.</div>
              <div class="rank-item"><strong>Rank 9:</strong> Protect MC from a fatal hit.</div>
            </div>
          </div>
          <div class="ability-block">
            <h3 class="font-pop highlight-blue">Rise Kujikawa (Support)</h3>
            <div class="rank-list">
              <div class="rank-item"><strong>Rank 1:</strong> Chance to increase All-Out Attack damage.</div>
              <div class="rank-item"><strong>Rank 6:</strong> Reveal enemy weaknesses automatically.</div>
              <div class="rank-item"><strong>Rank 7:</strong> Randomly heal HP/SP, buff party, or charge skills.</div>
              <div class="rank-item"><strong>Rank 9:</strong> Block an attack that hits the entire party.</div>
              <div class="rank-item"><strong>Rank 10:</strong> Revive MC with full HP/SP once per battle.</div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <div class="status-ticker bg-stripes">
    <div class="ticker-content font-pop">
      BATTLE READY // ANALYSIS COMPLETE // TACTICS SET // ALL-OUT ATTACK // BATTLE READY // ANALYSIS COMPLETE
    </div>
  </div>
</GuideLayout>

<style>
  .divider {
    height: 20px;
    margin: 4rem 0;
    width: 100%;
    border-top: 4px solid var(--secondary);
    border-bottom: 4px solid var(--secondary);
  }

  /* Header Section */
  .battle-header {
    min-height: 280px;
    height: auto;
    position: relative;
    overflow: hidden;
    border: 6px solid var(--secondary);
    box-shadow: 12px 12px 0 var(--secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 2rem;
    margin-bottom: 2rem;

    .header-bg {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center bottom;
      z-index: 1;
      filter: contrast(1.1) brightness(0.85);
    }

    .header-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        135deg,
        rgba(255, 241, 0, 0.4) 0%,
        rgba(0, 0, 0, 0.6) 100%
      );
      z-index: 2;
    }

    .tv-scanlines {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        rgba(18, 16, 16, 0) 50%,
        rgba(0, 0, 0, 0.15) 50%
      );
      background-size: 100% 4px;
      pointer-events: none;
      z-index: 3;
      opacity: 0.5;
    }

    .header-decoration {
      position: absolute;
      inset: 0;
      background-image: radial-gradient(rgba(0,0,0,0.2) 1px, transparent 1px);
      background-size: 10px 10px;
      opacity: 0.3;
      z-index: 4;
      pointer-events: none;
    }

    .header-content {
      position: relative;
      z-index: 10;
      transform: rotate(-0.5deg);
      width: 100%;

      .title-stack {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        margin: 0;

        @media (min-width: 768px) {
          flex-direction: row;
          justify-content: center;
          gap: 2rem;
        }

        .word {
          font-size: clamp(2.5rem, 10vw, 5.5rem);
          line-height: 1;
          padding: 0.4rem 1.8rem;
          display: inline-block;
          position: relative;
          font-weight: 900;
          letter-spacing: -0.02em;
        }

        .part-battle {
          color: white;
          text-shadow: 4px 4px 0 var(--secondary);
          background: var(--accent-orange);
          transform: rotate(-2.5deg) skewX(-8deg);
          border: 5px solid var(--secondary);
          box-shadow: 10px 10px 0 var(--secondary);
          animation: titleFloat 4s ease-in-out infinite alternate;
        }

        .part-mechanics {
          color: var(--secondary);
          background: var(--primary);
          transform: rotate(2deg) skewX(8deg);
          border: 5px solid var(--secondary);
          box-shadow: 10px 10px 0 var(--secondary);
          animation: titleFloat 4s ease-in-out infinite alternate-reverse;
          
          &::after {
            content: "";
            position: absolute;
            inset: -10px;
            border: 3px solid var(--primary);
            opacity: 0.4;
            z-index: -1;
            transform: rotate(-1.5deg);
            pointer-events: none;
          }
        }
      }

      .breadcrumb {
        margin-top: 3rem;
        background: var(--secondary);
        color: var(--primary);
        padding: 0.6rem 2.5rem;
        display: inline-flex;
        gap: 1.5rem;
        align-items: center;
        letter-spacing: 0.2rem;
        font-size: 0.85rem;
        font-weight: 900;
        transform: rotate(1.2deg);
        box-shadow: 8px 8px 0 rgba(0, 0, 0, 0.3);
        border: 2px solid var(--primary);

        .bc-sep {
          color: var(--accent-orange);
          font-style: normal;
        }

        .bc-item {
          transition: color 0.2s;
          &:hover { color: white; }
        }
      }
    }
  }

  @keyframes titleFloat {
    from { transform: translateY(0) rotate(var(--rot, -2.5deg)) skewX(var(--skew, -8deg)); }
    to { transform: translateY(-8px) rotate(calc(var(--rot, -2.5deg) + 1deg)) skewX(var(--skew, -8deg)); }
  }

  .part-battle { --rot: -2.5deg; --skew: -8deg; }
  .part-mechanics { --rot: 2deg; --skew: 8deg; }

  /* Fragment Layout */
  .fragment-layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 2.5rem 3rem;
    position: relative;
    width: 100%;
    margin-top: 2rem;
  }

  .fragment-card {
    background: white;
    border: 4px solid var(--secondary);
    padding: 2.5rem;
    position: relative;
    box-shadow: 12px 12px 0 var(--secondary);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    overflow: hidden;

    &.full-width {
      grid-column: 1 / -1;
    }

    .fragment-header {
      font-size: 1.4rem;
      margin-bottom: 1.5rem;
      color: var(--secondary);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      border-bottom: 3px solid var(--primary);
      padding-bottom: 0.5rem;
      position: relative;
      z-index: 2;

      .title-group {
        display: flex;
        align-items: center;
        gap: 1rem;

        .fragment-num {
          background: var(--secondary);
          color: var(--primary);
          width: 40px;
          min-width: 40px;
          height: 40px;
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 1rem;
          transform: rotate(-5deg);
          box-shadow: 3px 3px 0 var(--accent-orange);
        }
      }
    }
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .stat-card {
    background: #f8f8f8;
    border-left: 6px solid var(--secondary);
    padding: 1.25rem;
    border-radius: 0;

    .stat-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.5rem;

      .stat-abbr {
        background: var(--secondary);
        color: var(--primary);
        padding: 0.2rem 0.6rem;
        font-weight: 900;
        font-size: 1.1rem;
        transform: skewX(-10deg);
      }

      .stat-label {
        font-weight: 700;
        text-transform: uppercase;
        color: var(--secondary);
        font-size: 0.9rem;
      }
    }

    .stat-desc {
      font-size: 0.95rem;
      color: #444;
      line-height: 1.5;
    }
  }

  /* Commands Section */
  .commands-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;

    .command-item {
      padding-bottom: 0.75rem;
      border-bottom: 1px solid #eee;
      
      &:last-child { border-bottom: none; }

      .cmd-name {
        color: var(--secondary);
        font-weight: 800;
        font-size: 1.1rem;
        text-transform: uppercase;
        margin-right: 0.5rem;
      }
    }

    .tactics-sublist {
      margin-top: 0.5rem;
      list-style: none;
      padding-left: 1.5rem;

      li {
        margin-bottom: 0.4rem;
        position: relative;

        &::before {
          content: '>';
          position: absolute;
          left: -1rem;
          color: var(--accent-orange);
          font-weight: 900;
        }
      }
    }
  }

  .highlight-yellow {
    background: var(--primary);
    padding: 0.1rem 0.4rem;
    font-weight: 700;
    color: var(--secondary);
    box-shadow: 2px 2px 0 var(--secondary);
  }

  /* Attributes Section */
  .affinity-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    background: var(--secondary);
    color: white;
    padding: 1.25rem;
    margin-bottom: 2rem;
    border: 2px solid var(--primary);

    .legend-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.9rem;

      .badge {
        padding: 0.1rem 0.4rem;
        font-weight: 900;
        font-size: 0.75rem;
        color: var(--secondary);
        background: white;
        border-radius: 2px;
        min-width: 32px;
        text-align: center;

        &.wk { background: #ff4d4d; color: white; }
        &.res { background: #4d79ff; color: white; }
        &.nul { background: #999; color: white; }
        &.drn { background: #4dff88; color: var(--secondary); }
        &.rpl { background: #ff99ff; color: var(--secondary); }
      }
    }
  }

  .attributes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;

    .attr-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem;
      background: #fdfdfd;
      border: 1px solid #eee;

      .attr-box {
        width: 12px;
        height: 12px;
        flex-shrink: 0;
        
        &.phys { background: #999; }
        &.fire { background: #ff4d4d; }
        &.ice { background: #4d79ff; }
        &.elec { background: #fc0; }
        &.wind { background: #4dff88; }
        &.light { background: #fff100; box-shadow: 0 0 5px rgba(255, 241, 0, 0.5); }
        &.dark { background: #60c; }
        &.alm { background: #ff99ff; }
      }
    }
  }

  /* Battle Flow Section */
  .flow-step {
    margin-bottom: 2rem;
    padding-left: 1rem;
    border-left: 4px solid var(--accent-orange);

    &:last-child { margin-bottom: 0; }

    h3 {
      font-size: 1.2rem;
      color: var(--secondary);
      margin-bottom: 0.5rem;
    }
  }

  /* Special Attacks Section */
  .special-group {
    margin-bottom: 2rem;
    
    &:last-child { margin-bottom: 0; }

    h3 {
      font-size: 1.2rem;
      color: var(--secondary);
      margin-bottom: 0.75rem;
    }

    .combo-list {
      list-style: none;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 0.75rem;

      li {
        background: #f0f0f0;
        padding: 0.5rem 1rem;
        border-right: 4px solid var(--primary);
        font-weight: 700;
        font-size: 0.9rem;
      }
    }
  }

  /* Social Link Abilities Section */
  .abilities-grid-main {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;

    .ability-block {
      h3 {
