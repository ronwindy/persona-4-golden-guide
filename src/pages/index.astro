---
import BaseLayout from '../layouts/BaseLayout.astro';
import project from '../../project.config.json';
import { getToc } from '../lib/guideData';
import { navCategoryIcon, navEntryIcon } from '../lib/icons';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = getToc();
---

<BaseLayout>
  <h1 class="home-title">{project.game} Guide</h1>
  <a class="progress-resume home-resume" data-progress-resume href={`${baseUrl}/`} hidden>Continue reading</a>
  {categories.map((cat) => (
    <section>
      <h2 class="home-cat">
        {(() => { const CatIcon = navCategoryIcon(cat.category); return <CatIcon class="home-cat-icon" size={20} aria-hidden="true" />; })()}
        <span>{cat.category}</span>
      </h2>
      <ul class="section-index">
        {cat.entries.map((entry) => {
          const EntryIcon = navEntryIcon(cat.category, entry.title);
          return (
            <li>
              <a href={`${baseUrl}/guide/${entry.id}`} data-page-id={entry.id}>
                <EntryIcon class="nav-icon" size={18} aria-hidden="true" />
                <span>{entry.title}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</BaseLayout>
