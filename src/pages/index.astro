---
import BaseLayout from '../layouts/BaseLayout.astro';
import project from '../../project.config.json';
import { getToc } from '../lib/guideData';
import { ArrowRight } from '@lucide/astro';
import { navCategoryIcon, navEntryIcon } from '../lib/icons';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = getToc();
---

<BaseLayout>
  <h1 class="home-title"><span class="home-stack"><span class="home-kicker" aria-hidden="true">● On air · 00:00 AM</span>
    <span class="home-name">{project.game}</span>
    <span class="home-tagrow"><span class="home-tag">Guide</span><span class="home-rule" aria-hidden="true"></span></span></span></h1>
  <a class="progress-resume home-resume" data-progress-resume href={`${baseUrl}/`} hidden>
    <span class="resume-scan" aria-hidden="true"></span>
    <span class="resume-roll" aria-hidden="true"></span>
    <span class="resume-copy">
      <span class="resume-kicker"><i class="resume-dot" aria-hidden="true"></i>Signal found · pick up where you left off</span>
      <span class="resume-title">Continue reading</span>
      <span class="resume-page"><span data-resume-title></span> <span class="resume-sub">· last page you read</span></span>
    </span>
    <span class="resume-go">Resume <ArrowRight size={16} stroke-width={3} aria-hidden="true" /></span>
  </a>
  {categories.map((cat) => (
    <section>
      <h2 class="home-cat">
        {(() => { const CatIcon = navCategoryIcon(cat.category); return <CatIcon class="home-cat-icon" size={20} aria-hidden="true" />; })()}
        <span>{cat.category}</span>
      </h2>
      <ul class:list={['section-index', { 'two-col': cat.entries.length >= 4 }]}>
        {cat.entries.map((entry) => {
          const EntryIcon = navEntryIcon(cat.category, entry.title);
          return (
            <li>
              <a href={`${baseUrl}/guide/${entry.id}`} data-page-id={entry.id}>
                <EntryIcon class="nav-icon" size={18} aria-hidden="true" />
                <span>{entry.title}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</BaseLayout>
