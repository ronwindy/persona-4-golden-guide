---
import BaseLayout from '../layouts/BaseLayout.astro';
import project from '../../project.config.json';
import { getToc } from '../lib/guideData';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = getToc();
---

<BaseLayout>
  <h1>{project.game} Guide</h1>
  {categories.length === 0 && <p>No sections yet.</p>}
  {categories.map((cat) => (
    <section>
      <h2>{cat.category}</h2>
      <ul class="section-index">
        {cat.entries.map((entry) => (
          <li>
            {entry.has_structured ? <a href={`${baseUrl}/guide/${entry.id}`}>{entry.title}</a> : <span>{entry.title}</span>}
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
