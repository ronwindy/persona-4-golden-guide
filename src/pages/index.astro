---
import Layout from '../layouts/Layout.astro';
import SidebarToC from '../components/SidebarToC.astro';
---

<Layout>
      <SidebarToC />

      <!-- Left Column: Walkthrough Content -->
      <div class="content-column">
        <section>
          <div class="month-header font-pop">
            <h2>APRIL</h2>
            <span>THE BEGINNING</span>
          </div>

          <!-- Daily Entry: 4/11 -->
          <article class="daily-entry cutout-box p4g-shadow">
            <div class="entry-date-badge font-pop">4/11 (MONDAY)</div>

            <div class="entry-content font-read">
              <p>
                Welcome to Inaba. Today is mostly composed of cutscenes and
                introductions. Sit back and enjoy the ride.
              </p>
              <ul>
                <li>Arrive at Yasoinaba Station.</li>
                <li>Meet Dojima and Nanako.</li>
                <li>
                  Stop by the Moelle gas station. (This interaction is very
                  important for the true ending!).
                </li>
                <li>Have dinner at the Dojima Residence.</li>
              </ul>
            </div>

            <!-- Velvet Blue Callout -->
            <div class="callout-blue p4g-shadow-sm">
              <div class="icon" style="color: var(--primary); padding-top: 4px">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="28"
                  height="28"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </div>
              <div>
                <h4 class="font-pop">NIGHTTIME EVENT</h4>
                <p class="font-read">
                  When watching TV in your room, you will experience the
                  Midnight Channel for the first time. There are no crucial
                  dialogue choices here, but it triggers the start of the main
                  plot.
                </p>
              </div>
            </div>
          </article>
        </section>

        <section>
          <!-- Daily Entry: 4/12 -->
          <article class="daily-entry cutout-box p4g-shadow">
            <div class="entry-date-badge font-pop">4/12 (TUESDAY)</div>

            <div class="entry-content font-read">
              <p>
                Your first day at Yasogami High School. You'll meet Yosuke
                Hanamura and Chie Satonaka. Pay attention during class.
              </p>

              <!-- Junes Orange Callout Box -->
              <div class="callout-orange p4g-shadow-sm">
                <div
                  class="flex items-center gap-2"
                  style="margin-bottom: 0.5rem"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="var(--secondary)"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path
                      d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"
                    />
                    <path d="M12 9v4" />
                    <path d="M12 17h.01" />
                  </svg>
                  <h3 class="font-pop">POP QUIZ!</h3>
                </div>
                <p
                  class="font-read"
                  style="font-weight: bold; margin-bottom: 0.5rem"
                >
                  Teacher: "What is the year before 1 AD called?"
                </p>
                <div class="answer-box font-pop">ANSWER: 1 BC</div>
                <p
                  class="font-read"
                  style="
                    font-size: 0.875rem;
                    font-weight: bold;
                    margin-top: 0.5rem;
                  "
                >
                  + Knowledge Up
                </p>
              </div>

              <p>
                After school, follow the story beats into town. You will unlock
                the town map. Head back to the Dojima residence when finished.
              </p>
            </div>
          </article>
        </section>
      </div>

      <!-- Right Column: Sidebar -->
      <aside class="sidebar">
        <!-- Quick Jump Box -->
        <div class="widget widget-yellow p4g-shadow">
          <h3 class="widget-title font-pop" style="color: var(--secondary)">
            QUICK JUMP
          </h3>
          <nav class="font-pop">
            <a href="#" class="jump-btn active p4g-shadow-sm hover-invert"
              >APRIL WALKTHROUGH</a
            >
            <a href="#" class="jump-btn p4g-shadow-sm hover-invert"
              >MAY WALKTHROUGH</a
            >
            <a href="#" class="jump-btn p4g-shadow-sm hover-invert"
              >JUNE WALKTHROUGH</a
            >
            <a href="#" class="jump-btn p4g-shadow-sm hover-invert"
              >JULY WALKTHROUGH</a
            >
            <a href="#" class="jump-btn p4g-shadow-sm hover-invert"
              >AUGUST WALKTHROUGH</a
            >
          </nav>
        </div>

        <!-- Current Objective Teaser -->
        <div class="widget widget-black p4g-shadow">
          <div class="corner-stripes bg-stripes"></div>
          <div style="position: relative; z-index: 10">
            <h3
              class="font-pop"
              style="
                color: var(--primary);
                font-size: 1.5rem;
                margin-bottom: 0.75rem;
              "
            >
              CURRENT OBJECTIVE
            </h3>
            <p
              class="font-read"
              style="font-size: 0.875rem; margin-bottom: 1rem"
            >
              Progress through the opening prologue. Save your game at the
              calendar in your room.
            </p>
            <button
              class="font-pop p4g-shadow-sm hover-invert"
              style="
                width: 100%;
                background: var(--accent-orange);
                color: var(--secondary);
                border: 2px solid var(--secondary);
                padding: 0.5rem;
                font-size: 1.25rem;
                cursor: pointer;
              "
            >
              VIEW FULL DETAILS
            </button>
          </div>
        </div>
      </aside>
    </Layout>
