      "type": "list",
      "ordered": false,
      "items": [
        {
          "text": "Items/Equip/Yen can't be brought into the dungeon. Any Items/Equip found in the dungeon can only be used here"
        },
        {
          "text": "SP is halved after every battle"
        },
        {
          "text": "Accessories heal SP every turn"
        },
        {
          "text": "Gold Shadows can only be found in rare chests"
        },
        {
          "text": "Can't use Traesto"
        }
      ]
