  "chapters": [
    {
      "id": "100-guide",
      "title": "100% Guide",
      "intro_blocks": [
        {
          "type": "h4",
          "text": "Persona 4 Golden 100% Guide",
          "md": "**Persona 4 Golden 100% Guide**"
        },
        {
          "type": "h4",
          "text": "Version 1.00",
          "md": "**Version 1.00**"
        },
        {
          "type": "h4",
          "text": "Created by Hurricanehaon",
          "md": "**Created by Hurricanehaon**"
        },
        {
          "type": "h4",
          "text": "Warning!!!",
          "md": "**Warning!!!**"
        },
        {
          "type": "h4",
          "text": "This guide will include gameplay and minor story spoilers.",
          "md": "**This guide will include gameplay and minor story spoilers.**"
        },
        {
          "type": "quote",
          "blocks": [
            {
              "type": "p",
              "text": "Guide Format Changes",
              "md": "**Guide Format Changes**"
            },
            {
              "type": "p",
              "text": "Version 0.76 features a significant change to the format of this guide. This is due primarily to space limitations within GameFAQ's Editor. Although the format has changed, the content within this guide is still largely the same. Some portions of this guide have been edited for ease of usability/understanding. If any major changes are made, they will be listed here."
            },
            {
              "type": "p",
              "text": "Version 0.76",
              "md": "**Version 0.76**"
            },
            {
              "type": "p",
              "text": "Major overhaul of guide format, Boss List removed and boss info has moved to Dungeons"
            },
            {
              "type": "p",
              "text": "Version 1.00",
              "md": "**Version 1.00**"
            },
            {
              "type": "p",
              "text": "Walkthrough has been retested, some parts of the walkthrough have been added or rewritten for clarity"
            }
          ]
        }
      ]
    },
    {
      "id": "introduction",
      "title": "Introduction"
    },
    {
      "id": "about-persona-4-golden",
      "title": "About Persona 4 Golden"
    },
