{
  "game": "Persona 4 Golden",
  "slug": "persona-4-golden-guide",
  "site": "https://ronwindy.github.io",
  "base": "/persona-4-golden-guide",
  "pageTitleSuffix": "Persona 4 Golden Guide",
  "pageDescriptionPrefix": "Persona 4 Golden Guide",
  "defaultTitle": "Persona 4 Golden Guide",
  "defaultDescription": "A readable copy of the GameFAQs Persona 4 Golden 100% guide.",
  "extract": {
    "sourceDir": "raw-sources",
    "bodyId": "faqwrap",
    "dropClasses": ["ftoc"],
    "chapterTag": "h2",
    "sectionTag": "h3",
    "overviewLabel": "Overview",
    "transforms": {
      "callouts": [
        { "class": "callout callout-high", "startsWith": ["HIGHLY IMPORTANT"] },
        { "class": "callout callout-alert", "startsWith": ["IMPORTANT", "WARNING"] },
        { "class": "callout callout-spoiler", "includes": ["SPOILERS"] }
      ],
      "dateMarker": { "tag": "h4", "class": "date-marker" },
      "labelMarker": { "tag": "h5", "class": "label-marker", "maxLength": 60 },
      "faq": { "prefix": "^(?:FAQ|WAQ)X?\\d+:" },
      "numberedLines": true,
      "splitParagraphs": { "minWords": 80, "targetWords": 40, "maxWords": 60, "minTail": 15 }
    }
  }
}
