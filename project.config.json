{
  "game": "Persona 4 Golden",
  "slug": "persona-4-golden-guide",
  "site": "https://ronwindy.github.io",
  "base": "/persona-4-golden-guide",
  "pageTitleSuffix": "Persona 4 Golden Guide",
  "pageDescriptionPrefix": "Persona 4 Golden Guide",
  "defaultTitle": "Persona 4 Golden Guide",
  "defaultDescription": "A readable copy of the GameFAQs Persona 4 Golden 100% guide.",
  "extract": {
    "sourceDir": "raw-sources",
    "bodyId": "faqwrap",
    "dropClasses": [
      "ftoc"
    ],
    "chapterTag": "h2",
    "sectionTag": "h3",
    "overviewLabel": "Overview",
    "transforms": {
      "callouts": [
        {
          "class": "callout callout-high",
          "startsWith": [
            "HIGHLY IMPORTANT"
          ]
        },
        {
          "class": "callout callout-alert",
          "startsWith": [
            "IMPORTANT",
            "WARNING"
          ]
        },
        {
          "class": "callout callout-spoiler",
          "includes": [
            "SPOILERS"
          ]
        }
      ],
      "dateMarker": {
        "tag": "h4",
        "class": "date-marker"
      },
      "labelMarker": {
        "tag": "h5",
        "class": "label-marker",
        "maxLength": 60
      },
      "faq": {
        "prefix": "^(?:FAQ|WAQ)X?\\d+:"
      },
      "numberedLines": true,
      "toc": {
        "tag": "h4",
        "minEntries": 6
      },
      "emphasis": {
        "quotes": true,
        "skipCategories": [
          "Item List",
          "Persona Compendium",
          "Skill List"
        ],
        "sources": [
          {
            "type": "item",
            "category": "Item List",
            "headers": [
              "Weapon",
              "Armor",
              "Accessory",
              "Costume",
              "Item",
              "Material",
              "Book",
              "Fish",
              "Seed",
              "Bug",
              "Gem"
            ]
          },
          {
            "type": "persona",
            "category": "Persona Compendium",
            "headers": [
              "Persona"
            ]
          },
          {
            "type": "skill",
            "category": "Skill List",
            "headers": [
              "Skill"
            ]
          },
          {
            "type": "shadow",
            "category": "Dungeons",
            "headers": [
              "Enemy",
              "Boss"
            ]
          },
          {
            "type": "arcana",
            "category": "Persona Compendium",
            "exclude": [
              "Overview",
              "Formula",
              "Fusion Forecast",
              "Special Fusions"
            ]
          },
          {
            "type": "place",
            "category": "Dungeons",
            "exclude": [
              "Overview",
              "Extra Bosses"
            ]
          },
          {
            "type": "place",
            "category": "Activities",
            "titles": [
              "Chagall Cafe",
              "Okina Movie Theater",
              "Shiroku Pub",
              "Shiroku Store"
            ]
          },
          {
            "type": "character",
            "category": "Social Links",
            "names": true,
            "exclude": [
              "Overview",
              "Investigation Team/Fool",
              "Fellow Athletes/Strength",
              "Old Lady/Death",
              "Young Mother/Temperance",
              "Nurse/Devil",
              "Tutored Student/Tower",
              "Seekers of Truth/Judgement"
            ],
            "noSplit": [
              "Saki's Brother"
            ]
          }
        ],
        "extra": {
          "Junes": "place",
          "Inaba": "place",
          "Okina City": "place",
          "Okina Station": "place",
          "Samegawa Flood Plain": "place",
          "Samegawa Riverbank": "place",
          "Daidara Metalworks": "place",
          "Marukyu Tofu": "place",
          "Aiya": "place",
          "Yasogami High School": "place",
          "Yasogami High": "place",
          "Shopping District": "place",
          "Velvet Room": "place",
          "Yu Narukami": "character",
          "Souji Seta": "character"
        }
      },
      "splitParagraphs": {
        "minWords": 80,
        "targetWords": 40,
        "maxWords": 60,
        "minTail": 15
      }
    }
  }
}
